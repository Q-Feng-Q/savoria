# 复制到服务器上的安全目录，例如 /opt/family-kitchen/family-kitchen.env。
# 该文件由 docker --env-file 显式读取，不是 Spring Boot 的 .env 文件。

MYSQL_DATABASE=family_kitchen
MYSQL_APP_USERNAME=family_kitchen
MYSQL_APP_PASSWORD=ReplaceWithDatabasePassword2026

FAMILY_KITCHEN_JWT_SECRET=ReplaceWithAtLeast32RandomCharacters2026
FAMILY_KITCHEN_JWT_EXPIRES_IN_SECONDS=7200

FAMILY_KITCHEN_AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
FAMILY_KITCHEN_AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
FAMILY_KITCHEN_AUTH_BOOTSTRAP_ADMIN_PASSWORD=ReplaceWithAdminPassword

FAMILY_KITCHEN_WECHAT_APP_ID=ReplaceWithMiniProgramAppId
FAMILY_KITCHEN_WECHAT_APP_SECRET=ReplaceWithMiniProgramAppSecret

# 可按服务器内存调整。2 GB 服务器建议保留默认值。
JAVA_OPTS=-Xms128m -Xmx512m -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai
# MYSQLD_OPTS=--innodb-buffer-pool-size=256M --max-connections=50
