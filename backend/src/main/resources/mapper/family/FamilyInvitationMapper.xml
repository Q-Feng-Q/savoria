<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.familykitchen.family.mapper.FamilyInvitationMapper">

  <resultMap id="FamilyInvitationDOMap" type="com.familykitchen.family.model.entity.FamilyInvitationDO">
    <id property="id" column="id"/>
    <result property="familyId" column="family_id"/>
    <result property="inviterMemberId" column="inviter_user_id"/>
    <result property="code" column="code"/>
    <result property="status" column="status"/>
    <result property="expireAt" column="expire_at"/>
    <result property="usedByMemberId" column="used_by_user_id"/>
    <result property="usedAt" column="used_at"/>
    <result property="createdAt" column="created_at"/>
  </resultMap>

  <select id="findByCode" resultMap="FamilyInvitationDOMap">
    SELECT * FROM family_invitations WHERE code = #{code} LIMIT 1
  </select>

  <insert id="insert" parameterType="com.familykitchen.family.model.entity.FamilyInvitationDO" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO family_invitations (family_id, inviter_user_id, code, status, expire_at)
    VALUES (#{familyId}, #{inviterMemberId}, #{code}, #{status}, #{expireAt})
  </insert>

  <update id="updateStatus">
    UPDATE family_invitations
    SET status = #{status}, used_by_user_id = #{usedByMemberId}, used_at = #{usedAt}
    WHERE id = #{id}
  </update>
</mapper>
