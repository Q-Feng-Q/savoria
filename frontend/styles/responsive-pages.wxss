/* Shared page composition for the warm animal kitchen. */
.entry-page,.register-page,.family-start-page,.family-manage-page,.accounts-page,.security-page,.account-form-page,.profile-page,.home-page,.menu-page,.cart-page,.orders-page{width:100%;min-height:100vh;padding-left:var(--sk-space-page);padding-right:var(--sk-space-page);padding-bottom:calc(72rpx + var(--sk-safe-bottom));overflow-x:hidden;background:transparent}
.entry-form,.register-form,.security-group,.manage-section,.path-section,.account-item,.checkout-section,.selected-section,.detail-section{border-color:var(--sk-line-soft);background:rgba(255,253,247,.94);box-shadow:var(--sk-shadow-soft)}
.entry-form,.register-form,.security-group,.manage-section,.path-section{border-radius:30rpx 12rpx 30rpx 12rpx}
.entry-field input,.register-field input,.start-field input,.manage-input,.security-group input,.account-field input,.account-field textarea{width:100%;min-width:0;min-height:var(--sk-tap-min);border:2rpx solid var(--sk-line);border-radius:20rpx 8rpx 20rpx 8rpx;background:#fffaf0}
.entry-field input:focus,.register-field input:focus,.start-field input:focus,.manage-input:focus,.security-group input:focus,.account-field input:focus,.account-field textarea:focus{border-color:var(--sk-sage);background:var(--sk-paper)}
.entry-actions,.identity-actions,.mode-switch,.code-line{grid-template-columns:repeat(2,minmax(0,1fr))}
.profile-name,.profile-account,.account-name,.account-meta,.account-role,.manage-title,.path-section__title,.detail-head__title{overflow-wrap:anywhere}
.merchant-page,.purchase-page,.family-menu-page,.wallet-page,.wallet-ledger-page,.notifications-page,.addresses-page,.address-edit-page,.detail-page,.dish-page{overflow-x:hidden;background:transparent}
.merchant-command,.manage-hero,.detail-head,.cart-head,.accounts-head{position:relative;overflow:hidden;border-color:rgba(138,91,67,.24);background:linear-gradient(145deg,var(--sk-wheat),#f8e8c9);box-shadow:var(--sk-shadow-soft)}
.merchant-command::after,.manage-hero::after,.cart-head::after,.accounts-head::before{content:'';position:absolute;right:-48rpx;bottom:-62rpx;width:190rpx;height:190rpx;border:22rpx solid rgba(119,151,125,.13);border-radius:50%;pointer-events:none}
@media (max-width:360px){.entry-page,.register-page,.family-start-page,.family-manage-page,.accounts-page,.security-page,.account-form-page,.profile-page,.home-page,.menu-page,.cart-page,.orders-page{padding-left:var(--sk-space-page-compact);padding-right:var(--sk-space-page-compact)}.entry-form,.register-form,.security-group,.manage-section,.path-section,.account-item,.checkout-section,.selected-section,.detail-section{padding:22rpx}.entry-actions,.identity-actions{gap:8rpx}.entry-actions action-button,.identity-actions .ui-button{min-width:0}.mode-switch,.code-line{grid-template-columns:minmax(0,1fr)}.account-summary{grid-template-columns:66rpx minmax(0,1fr) auto;gap:10rpx}.account-avatar{width:64rpx;height:64rpx}.security-row{align-items:flex-start;gap:12rpx}.merchant-summary,.merchant-actions{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (min-width:480px){.entry-page,.register-page,.family-start-page,.accounts-page,.security-page,.account-form-page{max-width:var(--sk-content-max);margin:0 auto}}

