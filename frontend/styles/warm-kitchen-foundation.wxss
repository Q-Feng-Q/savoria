page {
  min-height: 100%;
  overflow-x: hidden;
  background: var(--warm-bg);
  color: var(--warm-ink);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  -webkit-text-size-adjust: 100%;
}

view, text, image, input, textarea, picker, scroll-view {
  min-width: 0;
  box-sizing: border-box;
}

image { vertical-align: middle; }
.ui-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  min-width: 0;
  min-height: 88rpx !important;
  box-sizing: border-box;
  text-align: center;
  user-select: none;
}
.ui-button--pressed { transform: translateY(2rpx) scale(.985); opacity: .92; }
.ui-button.is-disabled,
.ui-button.is-loading { opacity: .46; pointer-events: none; transform: none; }

.warm-page,
.page {
  width: 100%;
  min-height: 100vh;
  padding: 28rpx var(--warm-page-gap) calc(64rpx + var(--warm-safe-bottom));
  overflow-x: hidden;
  background: transparent;
}

.warm-page__content {
  width: 100%;
  max-width: var(--warm-content-max);
  margin: 0 auto;
}

.warm-kicker,
.eyebrow,
.sk-page-kicker {
  display: block;
  color: #8a5b43;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.warm-title,
.title,
.sk-page-title {
  display: block;
  margin-top: 12rpx;
  color: var(--warm-cocoa);
  font-family: "STKaiti", "KaiTi", "Songti SC", serif;
  font-size: 48rpx;
  line-height: 1.12;
  font-weight: 900;
}

.warm-subtitle,
.subtitle,
.sk-page-note {
  display: block;
  margin-top: 10rpx;
  color: var(--warm-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.warm-section-head,
.sk-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: var(--warm-section-gap) 0 18rpx;
}

.warm-section-title,
.section-title,
.sk-section-title {
  color: var(--warm-ink);
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 900;
}

.warm-section-note,
.sk-section-note {
  color: var(--warm-muted);
  font-size: 21rpx;
  text-align: right;
}

.warm-list,
.list { display: flex; flex-direction: column; }

.warm-list-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 20rpx 4rpx;
  border-bottom: 2rpx solid var(--warm-line);
}

.warm-list-row__copy { min-width: 0; flex: 1; }
.warm-list-row__title { display: block; color: var(--warm-ink); font-weight: 900; }
.warm-list-row__meta { display: block; margin-top: 6rpx; color: var(--warm-muted); font-size: 22rpx; line-height: 1.45; overflow-wrap: anywhere; }

.warm-paper,
.panel {
  padding: 28rpx;
  border: 2rpx solid var(--warm-line);
  border-radius: var(--warm-radius-md);
  background: var(--warm-paper);
}

.warm-management-hero {
  position: relative;
  min-height: 220rpx;
  padding-right: 190rpx;
  overflow: hidden;
}

.warm-management-art {
  position: absolute;
  right: 18rpx;
  bottom: 12rpx;
  width: 160rpx;
  height: 160rpx;
  border: 4rpx solid rgba(255, 249, 238, .9);
  border-radius: 30rpx;
  box-shadow: 0 12rpx 28rpx rgba(67, 44, 30, .12);
  transform: rotate(3deg);
}

.warm-form-field,
.field { margin-bottom: 24rpx; }
.warm-form-field__label,
.label { display: block; margin-bottom: 10rpx; color: var(--warm-cocoa); font-size: 23rpx; font-weight: 900; }

input, textarea, picker, .picker-text {
  width: 100%;
  min-height: 84rpx;
  padding: 0 22rpx;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  background: var(--warm-paper);
  color: var(--warm-ink);
  font-size: 27rpx;
}

textarea { min-height: 150rpx; padding-top: 20rpx; line-height: 1.5; }

.warm-primary-action,
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  /* WeChat and touch accessibility floor: 44 CSS px / 88 rpx. */
  min-height: 88rpx;
  padding: 0 30rpx;
  border: 0;
  border-radius: 24rpx;
  background: var(--warm-peach);
  color: #fff;
  font-size: 27rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 24rpx rgba(233, 130, 98, .2);
}

.warm-secondary-action,
.button.secondary { border: 2rpx solid var(--warm-line-strong); background: var(--warm-paper); color: var(--warm-cocoa); box-shadow: none; }
.button.danger { background: #fff0ea; color: var(--warm-danger); box-shadow: none; }
.warm-primary-action.ui-button--pressed, .warm-secondary-action.ui-button--pressed, .button.ui-button--pressed { transform: translateY(2rpx) scale(.985); opacity: .92; }

.warm-pill,
.pill { display: inline-flex; align-items: center; min-height: 52rpx; padding: 0 18rpx; border-radius: 999rpx; background: var(--warm-paper); color: var(--warm-muted); font-size: 22rpx; font-weight: 800; }
.warm-pill--active, .pill.active { background: var(--warm-sage-soft); color: var(--warm-cocoa); }

.warm-empty,
.empty { padding: 72rpx 24rpx; color: var(--warm-muted); text-align: center; font-size: 25rpx; }

.warm-fixed-action-space { height: calc(136rpx + var(--warm-safe-bottom)); }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.muted { color: var(--warm-muted); }
