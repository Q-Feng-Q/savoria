/* Merchant-only surfaces. Family screens and API behavior are unaffected. */
.merchant-story { --sk-bg:#fff3d7; --sk-paper:#fff3dc; --sk-text:#51331f; --sk-ink:#647b3e; --sk-muted:#886b49; --sk-line:#dfc89c; --sk-line-soft:#ebd9b5; --sk-accent:#df7739; --sk-sprout:#dce4bb; --sk-wheat:#f2deb0; min-height:100vh; padding:24rpx 24rpx calc(44rpx + env(safe-area-inset-bottom)); background:#fff3d7; color:#51331f; box-sizing:border-box; }
.merchant-story .page-head,.merchant-story .orders-header,.merchant-story .families-header,.merchant-story .menu-header,.merchant-story .detail-header,.merchant-story .editor-head,.merchant-story .purchase-heading,.merchant-story .merchant-profile-heading { margin:0 0 22rpx; padding:18rpx 0 24rpx; border-bottom:2rpx solid #e4cfaa; background:transparent; border-radius:0; }
.merchant-story .page-title,.merchant-story .orders-title,.merchant-story .families-title,.merchant-story .menu-title,.merchant-story .detail-title,.merchant-story .editor-title,.merchant-story .purchase-title,.merchant-story .merchant-profile-title { color:#51331f; font-family:"STKaiti","KaiTi",serif; font-size:38rpx; line-height:1.35; }
.merchant-story .eyebrow,.merchant-story .orders-eyebrow,.merchant-story .families-eyebrow,.merchant-story .menu-eyebrow,.merchant-story .detail-eyebrow { color:#7d8a52; letter-spacing:1rpx; }
.merchant-story .page-copy,.merchant-story .menu-description,.merchant-story .detail-copy,.merchant-story .merchant-profile-note { color:#886b49; font-size:23rpx; line-height:1.65; }
.merchant-story .form-section,.merchant-story .detail-section,.merchant-story .selector-section,.merchant-story .temp-section,.merchant-story .family-row,.merchant-story .order-row,.merchant-story .template-card,.merchant-story .review-card,.merchant-story .change-card { margin:0 0 22rpx; padding:24rpx; border:2rpx solid #ead6af; border-radius:24rpx; background:linear-gradient(110deg,#fff6e2,#fff0d1); box-shadow:0 7rpx 18rpx rgba(151,108,41,.06); }
.merchant-story .section-title,.merchant-story .section-heading,.merchant-story .family-name,.merchant-story .dish-name,.merchant-story .menu-name { color:#51331f; font-weight:800; }
.merchant-story .field,.merchant-story .merchant-profile-field { margin-bottom:24rpx; }
.merchant-story .label,.merchant-story .selector-label { color:#755335; font-size:24rpx; margin-bottom:12rpx; }
.merchant-story input,.merchant-story textarea,.merchant-story .picker-control,.merchant-story .selector-control,.merchant-story .filter-picker,.merchant-story .control-value { min-width:0; border:2rpx solid #e0c89e; border-radius:18rpx; background:#fff7e4; color:#51331f; font-size:25rpx; box-sizing:border-box; }
.merchant-story input { min-height:82rpx; padding:16rpx 20rpx; }
.merchant-story textarea { width:100%; padding:20rpx; line-height:1.7; }
.merchant-story .search-input { border-radius:999rpx; background:#fff6e2; }
.merchant-story .primary-action,.merchant-story .save-action,.merchant-story .bulk-enable,.merchant-story .merchant-profile-save,.merchant-story .order-row__action { border:2rpx solid #d7753a; border-radius:18rpx; background:#df7739; color:#fff7e4; }
.merchant-story .secondary-action,.merchant-story .detail-action,.merchant-story .toggle-action,.merchant-story .copy-action,.merchant-story .enable-all,.merchant-story .merchant-profile-cancel { border:2rpx solid #a4b47b; border-radius:18rpx; background:#e1e6c4; color:#4f6533; }
.merchant-story .filter--active { color:#be602f; border-color:#df7739; }
.merchant-story .scope-row,.merchant-story .status-filters { background:#f3e4c4; border-radius:20rpx; }
.merchant-story .scope-tab--active,.merchant-story .status-filter--active { background:#dce4bb; color:#4e6534; border-radius:16rpx; }
.merchant-story .batch-toolbar,.merchant-story .bulk-toolbar { padding:16rpx 0; background:#fff3d7; border-color:#e6d2ad; }
.merchant-story .check-box { background:#fff3dc; border-color:#b1ad83; }
.merchant-story .check-box--checked,.merchant-story .is-checked .checkbox-mark { background:#647b3e; border-color:#647b3e; color:#fff6df; }
.merchant-story .batch-action--danger { border:2rpx solid #c47958; background:#f6dfc6; color:#a0462c; }
.merchant-story .batch-action--restore { background:#647b3e; color:#fff6df; }
.merchant-story .dish-list,.merchant-story .family-list,.merchant-story .menu-list { border:0; }
.merchant-story.dishes-page .dish-row { margin:0 0 18rpx; padding:20rpx 16rpx; border:2rpx solid #ead6af; border-radius:24rpx; background:linear-gradient(110deg,#fff6e2,#fff0d1); }
.merchant-story .dish-image,.merchant-story .dish-thumb { border-radius:18rpx; border:2rpx solid #ebd7b0; }
.merchant-story .dish-price { color:#d06a31; }
.merchant-story .dish-heading { display:block; }
.merchant-story .dish-price { margin-top:8rpx; font-size:30rpx; }
.merchant-story .dish-description { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }
.merchant-story .row-actions { gap:10rpx; }
@media(max-width:360px) { .merchant-story.dishes-page .dish-row { grid-template-columns:40rpx 108rpx minmax(0,1fr); gap:12rpx; } .merchant-story .row-actions { grid-column:2 / 4; flex-direction:column; width:100%; } .merchant-story .row-action { flex:1; width:auto; min-width:90rpx; padding:8rpx; font-size:22rpx; } }
.merchant-story .row-action { border-radius:14rpx; }
.merchant-story .row-action--featured { border:2rpx solid #db8652; background:#fce4bd; color:#ab5228; }
.merchant-story .row-action--status { border:2rpx solid #a1b174; background:#e2e7c6; color:#4f6533; }
.merchant-story .row-action--disabled,.merchant-story .control--disabled { opacity:.45; }
.merchant-story .purchase-entry { border:2rpx solid #c5cea0; border-radius:24rpx; background:#e1e6c4; }
.merchant-story .purchase-entry__art { width:82rpx; height:82rpx; border-radius:18rpx; }
.merchant-story .purchase-art { width:96rpx; height:96rpx; border-radius:20rpx; }
.merchant-story .menu-row { padding:24rpx 0; border-color:#e4cfaa; }
.merchant-story .menu-status { background:#e5e8ca; color:#5b713d; }
.merchant-story .order-row__status { color:#a85a2e; }
.merchant-story .merchant-identity { align-items:center; border-color:#e4cfaa; }
.merchant-story .merchant-identity__name { color:#51331f; font-family:"KaiTi",serif; font-size:42rpx; }
.merchant-story .merchant-identity__edit,.merchant-story .merchant-identity__switch { border:2rpx solid #acb880; border-radius:18rpx; background:#e4e8cb; color:#526936; }
.merchant-story .merchant-focus { position:relative; overflow:hidden; padding:28rpx; border:2rpx solid #c3cd9b; border-radius:26rpx; background:#dce4bb; }
.merchant-story .merchant-focus__label,.merchant-story .merchant-focus__value { color:#42552d; }
.merchant-story .merchant-focus__note,.merchant-story .merchant-focus__unit { color:#657447; }
.merchant-story .merchant-focus__art { position:absolute; right:22rpx; bottom:22rpx; width:132rpx; height:132rpx; border-radius:24rpx; opacity:.94; pointer-events:none; }
.merchant-story .merchant-focus__metric,.merchant-story .merchant-focus__note { position:relative; max-width:70%; }
.merchant-story .merchant-helper-stats { margin:18rpx 0; gap:18rpx; }
.merchant-story .merchant-helper-stat { padding:24rpx; border:2rpx solid #ead6af; border-radius:22rpx; background:#fff0d1; }
.merchant-story .merchant-helper-stat__value { color:#a85a2e; }
.merchant-story .merchant-vignette-strip { justify-content:flex-end; gap:16rpx; margin-top:28rpx; }
.merchant-story .merchant-vignette { width:104rpx; height:104rpx; border-radius:20rpx; box-shadow:none; }
.merchant-story-bar { background:#fff0d1; border-top:2rpx solid #e4cfaa; }
.merchant-story-bar .save-action { background:#df7739; color:#fff6df; border-radius:20rpx; }
@media(max-width:360px) { .merchant-story { padding-left:18rpx; padding-right:18rpx; } .merchant-story .page-head { align-items:flex-start; flex-direction:column; } .merchant-story .page-actions { width:100%; justify-content:flex-start; } .merchant-story .page-actions > view { flex:1; min-width:0; } .merchant-story .batch-toolbar { flex-wrap:wrap; gap:10rpx; } .merchant-story .merchant-identity { flex-wrap:wrap; } .merchant-story .merchant-identity__actions { width:100%; } .merchant-story .merchant-focus__art { width:100rpx; height:100rpx; } }

.warm-page.merchant-story { background:#fff3d7; }
.merchant-story .merchant-profile-sheet,.merchant-story .review-row,.merchant-story .request-row { background:#fff0d1; border:2rpx solid #ead6af; border-radius:24rpx; }
.merchant-story .merchant-profile-field input { background:#fff7e4; border-color:#e0c89e; color:#51331f; }
.merchant-story .template-list,.merchant-story .ingredient-list { background:transparent; border:0; }
.merchant-story .template-row { padding:22rpx 16rpx; margin-bottom:16rpx; border:2rpx solid #ead6af; border-radius:22rpx; background:#fff0d1; }
.merchant-story .template-title,.merchant-story .changes-title,.merchant-story .detail-name { color:#51331f; font-family:"KaiTi",serif; }
.merchant-story .category-item { background:#f1e2c2; color:#806746; }
.merchant-story .category-item--active,.merchant-story .search-action { background:#647b3e; color:#fff6df; }
.merchant-story .import-all-action,.merchant-story .change-entry,.merchant-story .detail-change { background:#e2e7c6; border-color:#a4b47b; color:#526936; border-radius:18rpx; }
.merchant-story .detail-import { background:#df7739; color:#fff6df; }
.merchant-story .detail-actions,.merchant-story .selection-bar { background:#fff0d1; border-color:#e4cfaa; }

/* Long comparisons and secondary workflows remain readable on narrow phones. */
.merchant-story .compare-head,.merchant-story .compare-row { grid-template-columns:108rpx minmax(0,1fr) minmax(0,1fr); font-size:24rpx; line-height:1.65; }
.merchant-story .compare-head { background:#efdfbd; color:#715236; }
.merchant-story .compare-row { background:#fff4d9; color:#795e40; }
.merchant-story .compare-row--changed { background:#e8ebcd; }
.merchant-story .note-block { background:#e2e7c6; color:#526936; border-radius:20rpx; }
.merchant-story .ingredient-columns > view { border-radius:20rpx; background:#fff0d1; }
.merchant-story .summary { border-radius:24rpx; background:#fff0d1; }
.merchant-story .import-action,.merchant-story .temp-form__add { background:#df7739; color:#fff6df; border-radius:18rpx; }
.merchant-story .check-control--active { background:#647b3e; border-color:#647b3e; }
.merchant-story .purchase-list .ingredient-row { margin-bottom:18rpx; padding:24rpx; border:2rpx solid #ead6af; border-radius:22rpx; background:#fff0d1; }
.merchant-story .temp-input { background:#fff7e4; }
