<view class="warm-component warm-quantity-stepper quantity-stepper"><view class="ui-button quantity-stepper__button {{disabled || value <= min ? 'is-disabled' : ''}}" aria-role="button" aria-label="减少数量" aria-disabled="{{disabled || value <= min}}" hover-class="ui-button--pressed" hover-stay-time="80" data-delta="-1" bindtap="change">−</view><text class="quantity-stepper__value">{{value}}</text><view class="ui-button quantity-stepper__button quantity-stepper__button--add {{disabled || value >= max ? 'is-disabled' : ''}}" aria-role="button" aria-label="增加数量" aria-disabled="{{disabled || value >= max}}" hover-class="ui-button--pressed" hover-stay-time="80" data-delta="1" bindtap="change">＋</view></view>
