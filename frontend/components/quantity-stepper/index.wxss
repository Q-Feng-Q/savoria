.quantity-stepper {
  display: flex;
  align-items: center;
  gap: 8rpx
}

.quantity-stepper__button {
  display: grid;
  place-items: center;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #51372d;
  font-size: 30rpx;
  line-height: 1
}

.quantity-stepper__glyph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #f1d39c;
  line-height: 38rpx;
}

.quantity-stepper__button--add {
  color: #fff
}

.quantity-stepper__button--add .quantity-stepper__glyph {
  background: #ed7657;
}

.quantity-stepper__value {
  min-width: 34rpx;
  color: #402d25;
  text-align: center;
  font-size: 24rpx;
  font-weight: 900
}
