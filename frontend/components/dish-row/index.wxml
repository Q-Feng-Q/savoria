<view class="warm-component warm-dish-row dish-row" bindtap="open"><image class="dish-row__image" src="{{dish.displayImageUrl || dish.imageUrl || '/assets/brand/dish-placeholder.png'}}" mode="aspectFill"/><view class="dish-row__body"><text class="dish-row__name">{{dish.name}}</text><view class="dish-row__tags"><text wx:for="{{dish.displayTags || dish.tasteTags}}" wx:key="*this" class="dish-row__tag">{{item}}</text></view><text class="dish-row__note">{{dish.description || dish.soldText}}</text><text class="dish-row__price">{{dish.priceText || ('¥' + dish.price)}}</text></view><view class="dish-row__action" catchtap="noop"><quantity-stepper value="{{quantity}}" bind:change="quantityChange"/></view></view>
