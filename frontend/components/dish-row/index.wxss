.dish-row{display:grid;grid-template-columns:128rpx minmax(0,1fr);column-gap:18rpx;row-gap:8rpx;width:100%;min-height:216rpx;margin:0;padding:20rpx 0;border:0;border-bottom:2rpx solid #eadbc8;border-radius:0;background:transparent;box-shadow:none;box-sizing:border-box}.dish-row:active{background:rgba(241,211,156,.12)}.dish-row__image{grid-row:1 / span 2;width:128rpx;height:128rpx;border-radius:26rpx;background:var(--sk-paper)}.dish-row__body{grid-column:2;min-width:0}.dish-row__name,.dish-row__note,.dish-row__price{display:block}.dish-row__name{overflow:hidden;color:#402d25;font-size:27rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap}.dish-row__tags{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:7rpx;overflow:hidden}.dish-row__tag{color:#8d725f;font-size:17rpx;white-space:nowrap}.dish-row__tag+.dish-row__tag::before{content:'·';margin-right:8rpx;color:#ed7657}.dish-row__note{margin-top:8rpx;overflow:hidden;color:#9a7e6d;font-size:18rpx;line-height:1.45;white-space:normal}.dish-row__price{margin-top:10rpx;color:#ed7657;font-size:28rpx;font-weight:900}.dish-row__action-row{grid-column:2;display:flex;flex-wrap:wrap;justify-content:flex-end;min-width:0;margin-top:4rpx}
@media(max-width:360px){.dish-row{grid-template-columns:104rpx minmax(0,1fr);column-gap:12rpx;min-height:204rpx}.dish-row__image{width:104rpx;height:110rpx}.dish-row__body{grid-column:2;min-width:0}.dish-row__name{font-size:24rpx}.dish-row__action-row{grid-column:2;width:100%;justify-content:flex-end}}
