<view class="merchant-workbench-nav">
  <view class="merchant-workbench-nav__spacer"></view>
  <view class="merchant-workbench-nav__bar">
    <view class="merchant-workbench-nav__inner">
      <view class="merchant-workbench-nav__item {{active === 'overview' ? 'merchant-workbench-nav__item--active' : ''}}" aria-role="button" aria-label="商家概览" hover-class="merchant-workbench-nav__item--pressed" data-key="overview" bindtap="handleNavigate"><image class="merchant-workbench-nav__icon" src="/assets/ui/story/store-{{active === 'overview' ? 'orange' : 'ink'}}.png" /><text>概览</text></view>
      <view class="merchant-workbench-nav__item {{active === 'orders' ? 'merchant-workbench-nav__item--active' : ''}}" aria-role="button" aria-label="商家订单" hover-class="merchant-workbench-nav__item--pressed" data-key="orders" bindtap="handleNavigate"><image class="merchant-workbench-nav__icon" src="/assets/ui/story/orders-{{active === 'orders' ? 'orange' : 'ink'}}.png" /><text>订单</text></view>
      <view class="merchant-workbench-nav__item {{active === 'dishes' ? 'merchant-workbench-nav__item--active' : ''}}" aria-role="button" aria-label="商家菜品" hover-class="merchant-workbench-nav__item--pressed" data-key="dishes" bindtap="handleNavigate"><image class="merchant-workbench-nav__icon" src="/assets/ui/story/menu-{{active === 'dishes' ? 'orange' : 'ink'}}.png" /><text>菜品</text></view>
      <view class="merchant-workbench-nav__item {{active === 'families' ? 'merchant-workbench-nav__item--active' : ''}}" aria-role="button" aria-label="商家家庭" hover-class="merchant-workbench-nav__item--pressed" data-key="families" bindtap="handleNavigate"><image class="merchant-workbench-nav__icon" src="/assets/ui/story/home-{{active === 'families' ? 'orange' : 'ink'}}.png" /><text>家庭</text></view>
    </view>
  </view>
</view>
