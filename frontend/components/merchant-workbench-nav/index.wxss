.merchant-workbench-nav__spacer {
  min-height: calc(88rpx + env(safe-area-inset-bottom));
}

.merchant-workbench-nav__bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 2rpx solid #eadbc7;
  background: #fffdf7;
}

.merchant-workbench-nav__inner {
  display: flex;
  align-items: stretch;
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
}

.merchant-workbench-nav__item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  color: #8b7969;
  font-size: 26rpx;
}

.merchant-workbench-nav__item--active {
  color: #5d7d64;
  font-weight: 600;
}

.merchant-workbench-nav__item--pressed {
  background: #f4eadc;
}

.merchant-workbench-nav__bar { background:#fff0d1; border-top-color:#e4cfaa; }
.merchant-workbench-nav__item { flex-direction:column; gap:6rpx; min-height:106rpx; padding:12rpx 0; color:#806746; font-size:22rpx; }
.merchant-workbench-nav__icon { width:40rpx; height:40rpx; }
.merchant-workbench-nav__item--active { color:#c56c35; font-weight:800; }
.merchant-workbench-nav__item--pressed { background:#f4e3be; }
.merchant-workbench-nav__spacer { min-height:calc(106rpx + env(safe-area-inset-bottom)); }
