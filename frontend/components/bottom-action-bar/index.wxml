<view class="warm-component warm-bottom-action bottom-action-bar"><view class="bottom-action-bar__summary">{{summary}}<slot name="summary"></slot></view><view class="bottom-action-bar__secondary"><slot name="secondary"></slot></view><view class="ui-button bottom-action-bar__primary {{disabled || loading ? 'is-disabled' : ''}}" aria-role="button" aria-label="{{loading ? '处理中…' : primaryText}}" aria-disabled="{{disabled || loading}}" aria-busy="{{loading}}" hover-class="ui-button--pressed" hover-stay-time="80" bindtap="primary">{{loading ? '处理中…' : primaryText}}</view></view>
