.bottom-action-bar{position:fixed;z-index:40;left:22rpx;right:22rpx;bottom:calc(16rpx + env(safe-area-inset-bottom));display:grid;grid-template-columns:minmax(0,1fr) auto auto;align-items:center;gap:12rpx;min-height:112rpx;padding:12rpx 14rpx 12rpx 24rpx;border:0;border-radius:34rpx;background:#51372d;box-shadow:0 16rpx 34rpx rgba(60,37,28,.22);box-sizing:border-box}.bottom-action-bar__summary{min-width:0;overflow:hidden;color:#fff8ed;font-size:22rpx;font-weight:900;text-overflow:ellipsis;white-space:nowrap}.bottom-action-bar__secondary{min-width:0}.bottom-action-bar__primary{display:flex;align-items:center;justify-content:center;min-width:150rpx;min-height:88rpx;margin:0;padding:0 24rpx;border:0;border-radius:26rpx;background:#ed7657;color:#fff;font-size:25rpx;font-weight:900}@media(max-width:360px){.bottom-action-bar{left:14rpx;right:14rpx;gap:6rpx;padding-left:16rpx}.bottom-action-bar__primary{min-width:120rpx;padding:0 14rpx;font-size:22rpx}}
