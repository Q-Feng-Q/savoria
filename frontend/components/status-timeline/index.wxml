<view class="warm-component warm-status-timeline status-timeline"><view wx:for="{{items}}" wx:key="label" class="status-timeline__item {{index <= activeIndex ? 'status-timeline__item--active' : ''}}"><view class="status-timeline__rail"><view class="status-timeline__dot"></view><view wx:if="{{index < items.length - 1}}" class="status-timeline__line"></view></view><view class="status-timeline__body"><text class="status-timeline__label">{{item.label}}</text><text wx:if="{{item.description || item.note}}" class="status-timeline__description">{{item.description || item.note}}</text><text wx:if="{{item.time}}" class="status-timeline__time">{{item.time}}</text></view></view></view>
