.status-timeline__item{display:grid;grid-template-columns:42rpx minmax(0,1fr);gap:14rpx;min-height:112rpx}.status-timeline__rail{position:relative}.status-timeline__dot{position:relative;z-index:2;width:20rpx;height:20rpx;margin:8rpx auto 0;border:4rpx solid #b8b0a6;border-radius:50%;background:var(--sk-paper)}.status-timeline__line{position:absolute;left:50%;top:28rpx;bottom:-8rpx;width:3rpx;background:#ddd2c4;transform:translateX(-50%)}.status-timeline__item--active .status-timeline__dot{border-color:var(--sk-ink);background:var(--sk-accent)}.status-timeline__item--active .status-timeline__line{background:var(--sk-ink)}.status-timeline__label,.status-timeline__description,.status-timeline__time{display:block}.status-timeline__label{color:var(--sk-text);font-size:27rpx;font-weight:900}.status-timeline__description{margin-top:6rpx;color:var(--sk-muted);font-size:22rpx}.status-timeline__time{margin-top:7rpx;color:#a08f80;font-size:20rpx}
