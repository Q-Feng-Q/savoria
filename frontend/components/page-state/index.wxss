.page-state{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:320rpx;padding:44rpx 28rpx;box-sizing:border-box;text-align:center}.page-state__art{position:relative;width:280rpx;height:190rpx;overflow:hidden}.page-state__animal{width:100%;height:100%}.page-state__title,.page-state__description{display:block}.page-state__title{margin-top:16rpx;color:var(--sk-ink-deep);font-size:31rpx;line-height:1.25;font-weight:900}.page-state__description{max-width:520rpx;margin-top:10rpx;color:var(--sk-muted);font-size:24rpx;line-height:1.55}.page-state__retry{min-width:200rpx;min-height:88rpx;margin-top:26rpx;padding:0 28rpx;border:0;border-radius:24rpx;background:var(--sk-accent);color:#fff;font-size:27rpx;font-weight:900}.page-state__retry::after{border:0}.page-state--loading{align-items:stretch}.skeleton{height:112rpx;margin-top:20rpx;border-radius:24rpx;background:linear-gradient(90deg,var(--sk-paper-soft) 25%,var(--sk-bg) 45%,var(--sk-paper-soft) 65%);background-size:240% 100%;animation:page-state-shimmer 1.15s ease-in-out infinite}.skeleton--title{width:46%;height:42rpx;margin-top:0}.skeleton--short{width:72%}@keyframes page-state-shimmer{from{background-position:100% 0}to{background-position:-100% 0}}

@media(max-width:360px){.page-state{min-height:280rpx;padding:32rpx 18rpx}.page-state__art{width:230rpx;height:160rpx}.page-state__title{font-size:28rpx}.page-state__description{font-size:21rpx}}
