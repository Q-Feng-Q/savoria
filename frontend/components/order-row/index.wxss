:host { display:block; }
.order-row { margin:0 0 20rpx; }
.order-row__clock-icon { width:28rpx; height:28rpx; flex-shrink:0; }
.order-row.ui-button { display:block; }
.order-row { width:100%; padding:20rpx 22rpx 22rpx; border:1rpx solid #efdfbd; border-radius:28rpx; background:linear-gradient(115deg,#fff7e5,#fff0d4); box-shadow:0 9rpx 22rpx rgba(160,114,42,.1); box-sizing:border-box; text-align:left; color:#50321e; }
.order-row--pressed { opacity:.82; }.order-row__head { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin-bottom:16rpx; }.order-row__number { font-size:24rpx; }.order-row__badge { padding:7rpx 19rpx; border-radius:40rpx; background:#ec923d; color:#fff8e6; font-size:21rpx; }.order-row__badge--done { background:#89a060; }.order-row__badge--muted { background:#b2a58d; }.order-row__badge--ready { background:#ad874e; }
.order-row__main { display:flex; align-items:center; gap:20rpx; }.order-row__date { width:170rpx; flex-shrink:0; align-self:stretch; display:flex; flex-direction:column; justify-content:center; padding:15rpx 12rpx; border:1rpx solid #eddbb6; border-radius:17rpx; background:#fcf0d6; box-sizing:border-box; }.order-row__day { font-size:20rpx; color:#997954; }.order-row__clock { display:flex; align-items:center; gap:7rpx; margin-top:9rpx; font-size:33rpx; font-weight:800; }.order-row__clock-icon { color:#ed8737; font-size:28rpx; }.order-row__body { flex:1; min-width:0; }.order-row__pictures { display:flex; gap:7rpx; }.order-row__picture { width:76rpx; height:64rpx; border:2rpx solid #ecd1a5; border-radius:13rpx; background:#f3dfb6; }.order-row__note { display:block; margin-top:9rpx; color:#66452b; font-size:20rpx; line-height:1.5; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.order-row__bottom { display:flex; align-items:flex-end; justify-content:space-between; flex-wrap:wrap; gap:8rpx; margin-top:6rpx; }.order-row__quantity { color:#9a805e; font-size:18rpx; }.order-row__amount { margin-left:auto; font-size:29rpx; font-weight:800; color:#55331c; }.order-row__arrow { color:#a1815a; font-size:34rpx; }
@media(max-width:360px) { .order-row { padding:18rpx; }.order-row__main { gap:12rpx; }.order-row__date { width:154rpx; }.order-row__picture { width:68rpx; height:60rpx; }.order-row__amount { font-size:27rpx; }.order-row__arrow { display:none; } }
