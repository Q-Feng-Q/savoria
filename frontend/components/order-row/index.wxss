.order-row{display:grid;grid-template-columns:110rpx minmax(0,1fr) auto;align-items:center;gap:16rpx;width:100%;min-height:128rpx;margin:0;padding:20rpx 4rpx;border:0;border-bottom:2rpx solid #eadbc8;border-radius:0;background:var(--sk-paper);box-shadow:none;text-align:left}.order-row::after{border:0}.order-row:active{background:#fff9ed}.order-row__date-line,.order-row__title,.order-row__note,.order-row__status-text{display:block}.order-row__date{color:#765642;font-size:19rpx;font-weight:900}.order-row__date-line--secondary{margin-top:5rpx;color:#9a7e6d}.order-row__title{color:#402d25;font-size:26rpx;font-weight:900}.order-row__note{margin-top:7rpx;color:#987c6a;font-size:19rpx}.order-row__status{display:flex;align-items:center;gap:7rpx;color:#ed7657;font-size:20rpx;font-weight:900}.order-row__arrow{font-size:30rpx}@media(max-width:360px){.order-row{grid-template-columns:86rpx minmax(0,1fr);gap:10rpx}.order-row__status{grid-column:2}.order-row__title{font-size:24rpx}}
