<view class="ui-button warm-component warm-order-row order-row" bindtap="open" aria-role="button" aria-label="{{'查看订单：' + (order.familyName || order.title || order.orderNo || '家庭订单')}}" hover-class="ui-button--pressed" hover-stay-time="80"><view class="order-row__date"><text class="order-row__date-line">{{order.serviceDate || order.mealDate}}</text><text class="order-row__date-line order-row__date-line--secondary">{{order.mealTypeText || order.mealSlotText || order.mealLabel}}</text></view><view class="order-row__body"><text class="order-row__title">{{order.familyName || order.title || order.orderNo || '家庭订单'}}</text><text class="order-row__note">{{order.summary || order.description || order.dishSummaryText}}</text></view><view class="order-row__status"><text class="order-row__status-text">{{order.statusText || order.statusLabel || order.status}}</text><text class="order-row__arrow">›</text></view></view>


