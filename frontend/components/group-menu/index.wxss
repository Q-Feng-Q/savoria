.group-menu__group{margin:0}.group-menu__title{display:block;padding:22rpx 24rpx 10rpx;color:#80604d;font-size:18rpx;font-weight:900;letter-spacing:2rpx}.group-menu__item{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;width:100%;min-height:96rpx;margin:0;padding:15rpx 24rpx;border:0;border-bottom:2rpx solid #ecdfcf;border-radius:0;background:transparent;box-sizing:border-box;text-align:left}.group-menu__item:last-child{border-bottom:0}.group-menu__item--pressed{background:#fff4df;opacity:.82}.group-menu__item.is-disabled{opacity:.46}.group-menu__label,.group-menu__note{display:block}.group-menu__label{color:#402e26;font-size:24rpx;font-weight:900}.group-menu__note{margin-top:5rpx;color:#9a806f;font-size:18rpx}.group-menu__arrow{color:#8a6b59;font-size:34rpx}
@media(max-width:360px){.group-menu__item{padding-right:18rpx;padding-left:18rpx}.group-menu__title{padding-left:18rpx}}
