<view class="warm-component warm-group-menu group-menu"><view wx:for="{{groups}}" wx:key="title" class="group-menu__group"><text wx:if="{{item.title}}" class="group-menu__title">{{item.title}}</text><view wx:for="{{item.items}}" wx:for-item="entry" wx:key="key" class="group-menu__item {{entry.disabled ? 'is-disabled' : ''}}" data-item="{{entry}}" aria-role="button" aria-label="{{entry.label}}，{{entry.note}}" aria-disabled="{{entry.disabled}}" hover-class="group-menu__item--pressed" hover-stay-time="80" bindtap="select"><view><text class="group-menu__label">{{entry.label}}</text><text wx:if="{{entry.note}}" class="group-menu__note">{{entry.note}}</text></view><text class="group-menu__arrow">›</text></view></view></view>
