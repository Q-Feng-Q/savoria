.action-button{display:flex;align-items:center;justify-content:center;width:auto;max-width:100%;min-height:88rpx;margin:0;padding:0 28rpx;border:0;border-radius:26rpx;background:var(--sk-accent);color:#fff;font-size:26rpx;font-weight:900;box-shadow:none;transition:transform .16s ease,opacity .16s ease}.action-button--block{width:100%}.action-button--primary{background:#ed7657;color:#fff}.action-button--secondary{border:2rpx solid #dfcbb3;background:var(--sk-paper);color:#51372d}.action-button--danger{border:2rpx solid rgba(189,79,67,.24);background:#fff0ea;color:#b64e43}.action-button.is-disabled{opacity:.46}
