.purchase-row{display:grid;grid-template-columns:52rpx minmax(0,1fr) auto;align-items:center;gap:14rpx;width:100%;min-height:98rpx;margin:0;padding:14rpx 2rpx;border:0;border-bottom:2rpx solid #eadbc8;border-radius:0;background:transparent;text-align:left}.purchase-row::after{border:0}.purchase-row__check{display:grid;place-items:center;width:46rpx;height:46rpx;border:2rpx solid #75947b;border-radius:15rpx;color:#fff}.purchase-row--checked .purchase-row__check{background:#75947b}.purchase-row__name,.purchase-row__note{display:block}.purchase-row__name{color:#402d25;font-size:25rpx;font-weight:900}.purchase-row__note{margin-top:5rpx;color:#957968;font-size:19rpx}.purchase-row__quantity{color:#ed7657;font-size:24rpx;font-weight:900}.purchase-row--checked{opacity:.55}
