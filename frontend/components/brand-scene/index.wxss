.brand-scene{position:relative;display:flex;min-height:276rpx;padding:38rpx 34rpx;overflow:hidden;border:2rpx solid rgba(138,91,67,.22);border-radius:42rpx;background:linear-gradient(145deg,#f8e3bd,#f3d2a0);box-shadow:var(--sk-shadow-soft);box-sizing:border-box}.brand-scene__image,.brand-scene__scrim{position:absolute;inset:0;width:100%;height:100%}.brand-scene__scrim{background:linear-gradient(90deg,rgba(255,244,228,.99) 0,rgba(255,244,228,.9) 44%,rgba(255,244,228,.04) 76%)}.brand-scene__copy{position:relative;z-index:2;width:61%}.brand-scene__eyebrow,.brand-scene__title,.brand-scene__subtitle{display:block}.brand-scene__eyebrow{color:var(--sk-chestnut);font-size:18rpx;letter-spacing:3rpx;font-weight:900}.brand-scene__title{margin-top:14rpx;color:var(--sk-ink-deep);font-family:"STKaiti","KaiTi","Songti SC",serif;font-size:53rpx;line-height:1.05;font-weight:900}.brand-scene__subtitle{margin-top:14rpx;color:#705542;font-size:23rpx;line-height:1.5}.brand-scene__character{position:absolute;right:-24rpx;bottom:-8rpx;width:310rpx;height:244rpx;overflow:hidden;filter:drop-shadow(0 10rpx 12rpx rgba(52,45,34,.12));animation:animal-breathe 3.8s ease-in-out infinite}.brand-scene__mascots{width:100%;height:100%}.brand-scene__character--error{filter:saturate(.72) drop-shadow(0 10rpx 12rpx rgba(52,45,34,.1))}.brand-scene--compact{min-height:194rpx}.brand-scene--compact .brand-scene__character{right:-12rpx;width:220rpx;height:174rpx}@keyframes animal-breathe{0%,100%{transform:translateY(0) rotate(-.4deg)}50%{transform:translateY(-7rpx) rotate(.4deg)}}@media(prefers-reduced-motion:reduce){.brand-scene__character{animation:none}}

@media(max-width:360px){.brand-scene{min-height:250rpx;padding:30rpx 24rpx;border-radius:34rpx}.brand-scene__copy{width:68%}.brand-scene__title{font-size:45rpx}.brand-scene__subtitle{font-size:21rpx}.brand-scene__character{right:-42rpx;width:260rpx;height:210rpx}.brand-scene--compact{min-height:188rpx}.brand-scene--compact .brand-scene__copy{width:64%}.brand-scene--compact .brand-scene__character{width:190rpx;height:154rpx}}
