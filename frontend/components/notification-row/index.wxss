.notification-row{display:grid;grid-template-columns:16rpx minmax(0,1fr);gap:14rpx;width:100%;min-height:118rpx;margin:0;padding:20rpx 4rpx;border:0;border-bottom:2rpx solid #eadbc8;border-radius:0;background:transparent;text-align:left}.notification-row::after{border:0}.notification-row__dot{width:12rpx;height:12rpx;margin-top:12rpx;border-radius:50%;background:transparent}.notification-row--unread .notification-row__dot{background:#ed7657}.notification-row__title,.notification-row__content,.notification-row__time{display:block}.notification-row__title{color:#402d25;font-size:26rpx;font-weight:900}.notification-row__content{margin-top:7rpx;color:#8f7362;font-size:20rpx;line-height:1.45}.notification-row__time{margin-top:8rpx;color:#aa9282;font-size:17rpx}
