<view class="warm-page warm-state-host family-manage-page">
  <view class="manage-hero"><text class="manage-kicker">FAMILY TABLE</text><text class="manage-title">一家人的餐桌</text><text class="manage-note">{{isOwner ? '你是家庭负责人，可以邀请成员、移交负责人或解散家庭。' : (isAdmin ? '你是家庭管理员，可以邀请成员并处理加入申请。' : '你是家庭成员，可以管理自己的家庭关系。')}}</text></view>
  <page-state wx:if="{{loading}}" phase="loading" title="正在整理家庭信息" description="请稍候" />
  <block wx:else>
    <view wx:if="{{invitations.length}}" class="manage-section"><text class="manage-section__title">待处理邀请</text><view wx:for="{{invitations}}" wx:key="id" class="application-row"><view><text class="row-title">家庭邀请</text><text class="row-note">来自家庭 #{{item.familyId}}</text></view><view class="row-actions"><view data-id="{{item.id}}" bindtap="acceptInvitation" class="ui-button mini-action mini-action--primary" aria-role="button" aria-label="接受家庭邀请" hover-class="ui-button--pressed">接受</view><view data-id="{{item.id}}" bindtap="rejectInvitation" class="ui-button mini-action" aria-role="button" aria-label="拒绝家庭邀请" hover-class="ui-button--pressed">拒绝</view></view></view></view>
    <block wx:if="{{isAdmin}}">
      <view class="manage-section"><text class="manage-section__title">家庭邀请码</text><view wx:if="{{invitationCode}}" class="invitation-code" bindtap="copyCode"><text>{{invitationCode}}</text><text>点击复制</text></view><action-button label="{{busy ? '处理中…' : '生成新邀请码'}}" disabled="{{busy}}" tone="secondary" block bind:action="generateCode" /></view>
      <view class="manage-section"><text class="manage-section__title">定向邀请</text><input class="manage-input" value="{{userIdentifier}}" data-field="userIdentifier" bindinput="input" placeholder="输入账号、手机号或邮箱" /><action-button label="发送家庭邀请" disabled="{{busy}}" tone="secondary" block bind:action="directInvite" /></view>
      <view class="manage-section"><text class="manage-section__title">待处理申请</text><page-state wx:if="{{!applications.length}}" phase="empty" title="暂无加入申请" description="新申请会显示在这里" illustration="orders" /><view wx:for="{{applications}}" wx:key="id" class="application-row"><view><text class="row-title">用户 #{{item.applicantUserId}}</text><text class="row-note">申请加入家庭</text></view><view class="row-actions"><view data-id="{{item.id}}" bindtap="approve" class="ui-button mini-action mini-action--primary" aria-role="button" aria-label="通过加入申请" hover-class="ui-button--pressed">通过</view><view data-id="{{item.id}}" bindtap="reject" class="ui-button mini-action" aria-role="button" aria-label="拒绝加入申请" hover-class="ui-button--pressed">拒绝</view></view></view></view>
    </block>
    <view wx:if="{{isOwner}}" class="manage-section"><text class="manage-section__title">负责人设置</text><text class="manage-section__note">移交后你将成为普通成员。</text><input class="manage-input" type="number" value="{{targetUserId}}" data-field="targetUserId" bindinput="input" placeholder="新负责人用户 ID" /><action-button label="移交负责人" disabled="{{busy}}" tone="secondary" block bind:action="transferOwner" /></view>
    <view class="manage-section manage-section--danger"><text class="manage-section__title">家庭关系</text><text class="manage-section__note">{{isOwner ? '负责人如不再维护家庭，可以先移交负责人；确认不再使用时也可解散家庭。' : '退出后，你的个人账号仍可正常登录，也可以加入其他家庭。'}}</text><action-button wx:if="{{isOwner}}" label="解散家庭" disabled="{{busy}}" tone="danger" block bind:action="dissolveFamily" /><action-button wx:else label="退出当前家庭" disabled="{{busy}}" tone="danger" block bind:action="exitFamily" /></view>
  </block>
</view>
