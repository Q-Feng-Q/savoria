.family-manage-page{--fm-primary:#9f4f3d;--fm-ink:#4f392f;--fm-positive:#55705c;--fm-danger:#a63f35;--fm-secondary-border:#9b765f;min-height:100vh;padding:28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));background:var(--sk-bg);color:var(--sk-text);box-sizing:border-box;overflow-x:hidden}.manage-shell{width:100%;max-width:920rpx;margin:0 auto;box-sizing:border-box}.manage-hero{position:relative;padding:38rpx 34rpx;border:2rpx solid var(--fm-ink);border-radius:32rpx 12rpx 32rpx 12rpx;background:linear-gradient(135deg,var(--sk-sprout),#f8e3b8);box-shadow:var(--sk-shadow-soft);overflow:hidden}.manage-hero:after{content:"";position:absolute;right:-36rpx;bottom:-48rpx;width:180rpx;height:180rpx;border:24rpx solid rgba(255,255,255,.28);border-radius:50%}.manage-kicker,.manage-title,.manage-note,.manage-section__eyebrow,.manage-section__title,.manage-section__note,.field-label,.info-label,.info-value,.address-contact,.address-detail,.row-title,.row-note{display:block}.manage-kicker,.manage-section__eyebrow{color:var(--sk-sage);font-size:18rpx;font-weight:900;letter-spacing:4rpx}.manage-title{position:relative;z-index:1;margin-top:12rpx;font-family:"STSong","Songti SC",serif;font-size:44rpx;font-weight:900}.manage-note{position:relative;z-index:1;max-width:600rpx;margin-top:12rpx;color:var(--sk-muted);font-size:23rpx;line-height:1.65}.manage-section{margin-top:24rpx;padding:30rpx;border:2rpx solid var(--sk-line-soft);border-radius:30rpx 12rpx 30rpx 12rpx;background:var(--sk-paper);box-shadow:var(--sk-shadow-soft);box-sizing:border-box}.profile-section{background:linear-gradient(160deg,#fffaf0 0%,#fff7e7 100%)}.address-section{background:var(--sk-sprout)}.delivery-section{background:var(--sk-wheat)}.owner-section{border-color:var(--fm-ink);background:#fffaf0}.manage-section--danger{border-color:#e6b9ae;background:#fff8f4}.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.manage-section__title{margin-top:8rpx;font-family:"STSong","Songti SC",serif;font-size:32rpx;font-weight:900}.manage-section__note{margin-top:10rpx;color:var(--sk-muted);font-size:22rpx;line-height:1.6}.section-quiet-action{flex:none;min-height:72rpx;padding:0 24rpx;border:2rpx solid var(--sk-line);border-radius:18rpx 8rpx 18rpx 8rpx;background:rgba(255,255,255,.72);font-size:22rpx}.field-label{margin:24rpx 0 10rpx;color:var(--sk-muted);font-size:22rpx;font-weight:800}.manage-input,.manage-textarea{width:100%;border:2rpx solid var(--sk-line);border-radius:20rpx 9rpx 20rpx 9rpx;background:#fffdf7;box-sizing:border-box;color:var(--sk-text);font-size:25rpx}.manage-input{height:88rpx;padding:0 22rpx}.manage-textarea{min-height:180rpx;padding:22rpx;line-height:1.6}.profile-actions{display:flex;gap:16rpx;margin-top:22rpx}.profile-action{flex:1;min-height:88rpx;border:2rpx solid var(--fm-secondary-border);border-radius:22rpx 9rpx 22rpx 9rpx;background:#fffdf7;color:var(--fm-ink)}.profile-action--primary,.block-action,.transfer-action{border-color:var(--fm-primary);background:var(--fm-primary);color:#fff}.info-row{display:flex;align-items:flex-start;justify-content:space-between;gap:28rpx;padding:22rpx 0;border-bottom:2rpx solid var(--sk-line-soft)}.info-row:last-child{border-bottom:0}.info-label{flex:none;color:var(--sk-muted);font-size:22rpx}.info-value{text-align:right;font-size:24rpx;font-weight:800;line-height:1.55}.address-summary{margin-top:20rpx;padding:24rpx;border-radius:22rpx 9rpx 22rpx 9rpx;background:rgba(255,255,255,.66)}.address-summary--empty{color:var(--sk-muted);font-size:23rpx}.address-contact{font-size:25rpx;font-weight:900}.address-detail{margin-top:8rpx;color:var(--sk-muted);font-size:22rpx;line-height:1.55}.inline-warning{margin-top:18rpx;padding:18rpx;border-radius:16rpx;background:#fff2de;color:#9a5b3c;font-size:21rpx;line-height:1.5}.section-link{min-height:88rpx;margin-top:18rpx;border:2rpx solid var(--fm-secondary-border);border-radius:22rpx 9rpx 22rpx 9rpx;background:#fffdf7;color:var(--fm-ink)}.owner-picker{display:flex;align-items:center;justify-content:space-between;min-height:88rpx;margin-top:22rpx;padding:0 24rpx;border:2rpx solid var(--sk-line);border-radius:22rpx 9rpx 22rpx 9rpx;background:#fff;font-size:25rpx;font-weight:800;box-sizing:border-box}.owner-picker__arrow{color:var(--sk-muted);font-size:30rpx}.transfer-action,.block-action,.danger-action{width:100%;min-height:88rpx;margin-top:18rpx;border-radius:22rpx 9rpx 22rpx 9rpx;box-sizing:border-box}.owner-empty{margin-top:20rpx;padding:24rpx;border-radius:20rpx;background:var(--sk-sprout);color:var(--sk-muted);font-size:22rpx;line-height:1.6}.invitation-code{display:flex;min-height:88rpx;align-items:center;justify-content:space-between;margin:16rpx 0 18rpx;padding:24rpx;border:2rpx dashed var(--fm-ink);border-radius:18rpx 8rpx 18rpx 8rpx;background:var(--sk-wheat);font-weight:900}.application-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:20rpx 0;border-bottom:2rpx solid var(--sk-line-soft)}.application-row:last-child{border-bottom:0}.row-title{font-size:25rpx;font-weight:900}.row-note{margin-top:6rpx;color:var(--sk-muted);font-size:20rpx}.row-actions{display:flex;gap:10rpx;flex:none}.mini-action{min-height:64rpx;padding:0 18rpx;border:2rpx solid var(--fm-secondary-border);border-radius:15rpx 6rpx 15rpx 6rpx;background:#fffdf7;color:var(--fm-ink);font-size:21rpx}.mini-action--primary{border-color:var(--fm-positive);background:var(--fm-positive);color:#fff}.danger-action{border:2rpx solid var(--fm-danger);background:#fff1ed;color:var(--fm-danger)}.ui-button{display:flex;align-items:center;justify-content:center;font-weight:900;text-align:center;transition:opacity .15s ease,transform .15s ease}.ui-button--pressed{transform:scale(.985);box-shadow:inset 0 0 0 999rpx rgba(58,42,36,.1)}.is-disabled{opacity:.58}

@media (max-width:360px){.family-manage-page{--fm-primary:#9f4f3d;--fm-ink:#4f392f;--fm-positive:#55705c;--fm-danger:#a63f35;--fm-secondary-border:#9b765f;padding-left:18rpx;padding-right:18rpx}.manage-hero,.manage-section{padding:24rpx}.section-head,.profile-actions,.application-row{flex-direction:column;align-items:stretch}.section-quiet-action{width:100%;min-height:88rpx}.info-row{display:block}.info-value{margin-top:8rpx;text-align:left}.row-actions{width:100%}.mini-action{flex:1;min-height:88rpx}}

@media (min-width:700px){.family-manage-page{--fm-primary:#9f4f3d;--fm-ink:#4f392f;--fm-positive:#55705c;--fm-danger:#a63f35;--fm-secondary-border:#9b765f;padding-left:48rpx;padding-right:48rpx}.manage-section{padding:36rpx}.manage-title{font-size:48rpx}}
.section-quiet-action,.mini-action{min-height:88rpx}
