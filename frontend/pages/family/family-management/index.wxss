.family-manage-page{min-height:100vh;padding:28rpx;background:var(--sk-bg);color:var(--sk-text);box-sizing:border-box}.manage-hero{padding:34rpx;border:2rpx solid var(--sk-ink);border-radius:30rpx 12rpx 30rpx 12rpx;background:var(--sk-sprout);box-shadow:var(--sk-shadow-soft)}.manage-kicker,.manage-title,.manage-note,.manage-section__note,.row-title,.row-note{display:block}.manage-kicker{color:var(--sk-sage);font-size:18rpx;font-weight:900;letter-spacing:4rpx}.manage-title{margin-top:12rpx;font-family:"STSong","Songti SC",serif;font-size:42rpx;font-weight:900}.manage-note{margin-top:12rpx;color:var(--sk-muted);font-size:23rpx;line-height:1.6}.manage-section{margin-top:24rpx;padding:28rpx;border:2rpx solid var(--sk-line-soft);border-radius:28rpx 11rpx 28rpx 11rpx;background:var(--sk-paper);box-shadow:var(--sk-shadow-soft)}.manage-section--danger{border-color:#e6b9ae;background:#fff8f4}.manage-section__title{display:block;margin-bottom:12rpx;font-size:30rpx;font-weight:900}.manage-section__note{margin-bottom:18rpx;color:var(--sk-muted);font-size:22rpx;line-height:1.55}.invitation-code{display:flex;align-items:center;justify-content:space-between;margin:12rpx 0 18rpx;padding:24rpx;border:2rpx dashed var(--sk-ink);border-radius:18rpx 8rpx 18rpx 8rpx;background:var(--sk-wheat);font-weight:900}.manage-input{width:100%;height:86rpx;margin:10rpx 0 18rpx;padding:0 22rpx;border:2rpx solid var(--sk-line);border-radius:18rpx 8rpx 18rpx 8rpx;background:#fffaf0;box-sizing:border-box}.application-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:20rpx 0;border-bottom:2rpx solid var(--sk-line-soft)}.application-row:last-child{border-bottom:0}.row-title{font-size:25rpx;font-weight:900}.row-note{margin-top:6rpx;color:var(--sk-muted);font-size:20rpx}.row-actions{display:flex;gap:10rpx;flex:none}.mini-action{padding:13rpx 17rpx;border:2rpx solid var(--sk-line);border-radius:15rpx 6rpx 15rpx 6rpx;color:var(--sk-muted);font-size:21rpx;font-weight:900}.mini-action--primary{border-color:var(--sk-sage);background:var(--sk-sprout);color:var(--sk-ink)}
