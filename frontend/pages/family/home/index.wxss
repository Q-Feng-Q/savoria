@import "../../../styles/approved-storybook.wxss";
.home-metric-icon { padding:7rpx; }
.home-page .home-family-name,.home-page .home-dish-name { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:1; overflow:hidden; }
.home-crew-line { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.home-page { min-height:100vh; width:100%; max-width:720px; margin:0 auto; padding:0 24rpx 12rpx; box-sizing:border-box; overflow-x:hidden; background:#fff3d7; }
.home-family-overview { margin-top:-8rpx; }
.home-family-banner { position:relative; height:248rpx; border-radius:26rpx 26rpx 0 0; overflow:hidden; background:#a3b87b; }
.home-family-copy { position:relative; width:58%; padding:26rpx 22rpx; }
.home-family-name { display:block; color:#fff9e6; font-size:50rpx; font-weight:900; line-height:1.3; text-shadow:0 2rpx 3rpx #7c955b; }
.home-family-chevron { margin-left:16rpx; font-weight:400; }
.home-family-motto { display:block; margin-top:9rpx; font-size:22rpx; letter-spacing:2rpx; color:#fff8db; }
.home-crew-line { display:block; margin-top:10rpx; font-size:18rpx; color:#f9f1cc; }
.home-family-sheet { position:relative; margin-top:-63rpx; padding:20rpx 22rpx; border-radius:28rpx; background:linear-gradient(120deg,#fff6df,#fff1d0); }
.home-time-row { display:flex; align-items:center; justify-content:space-between; gap:22rpx; }
.home-time-caption { display:block; font-size:20rpx; }
.home-time-value { display:flex; align-items:center; gap:12rpx; font-size:42rpx; font-weight:900; line-height:1.3; }
.home-clock { font-size:38rpx; color:#ed8738; font-weight:400; }
.home-time-arrow { font-size:28rpx; color:#9c7b4e; }
.home-time-note { display:block; margin-top:3rpx; color:#9b805d; font-size:16rpx; }
.home-time-quote { padding:0 20rpx 0 24rpx; border-left:2rpx solid #e9d6ae; color:#936d43; font-family:"STKaiti","KaiTi",serif; font-size:22rpx; line-height:1.6; transform:rotate(-6deg); white-space:pre-line; }
.home-order-heading { display:flex; align-items:center; justify-content:space-between; margin:20rpx 0 12rpx; font-size:22rpx; font-weight:700; }
.home-all-orders { font-size:18rpx; color:#947b57; padding:8rpx 0 8rpx 16rpx; }
.home-order-metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12rpx; }
.home-metric { display:flex; align-items:center; justify-content:center; gap:12rpx; padding:14rpx 8rpx; border-radius:18rpx; background:#fbe9c8; }
.home-metric--making { background:#ecebc9; }.home-metric--done { background:#e5e9c7; }
.home-metric-icon { display:flex; align-items:center; justify-content:center; width:42rpx; height:42rpx; border-radius:50%; background:#eb8a3c; color:#fff5dd; font-size:30rpx; }
.home-metric--making .home-metric-icon { background:#db8040; }.home-metric--done .home-metric-icon { background:#87a260; }
.home-metric-value { display:block; font-size:34rpx; font-weight:800; line-height:1; }.home-metric-label { display:block; margin-top:6rpx; font-size:19rpx; }
.home-recommend-head { display:flex; align-items:center; gap:12rpx; margin:24rpx 0 10rpx; }
.home-recommend-by { flex:1; color:#9c805b; font-size:17rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.home-more { color:#96754f; font-size:20rpx; padding:10rpx 0 10rpx 8rpx; }
.home-featured-swiper { width:100%; height:302rpx; overflow:visible; }
.home-featured-slide { box-sizing:border-box; padding:0 6rpx 30rpx 0; }
.home-recommendation { height:100%; display:flex; gap:18rpx; padding:12rpx; overflow:hidden; }
.home-recommendation--pressed { opacity:.82; }
.home-dish-photo { position:relative; width:51%; flex-shrink:0; height:100%; border-radius:20rpx; overflow:hidden; background:#e8c68e; }
.home-dish-image { width:100%; height:100%; }.home-dish-ribbon { position:absolute; left:0; top:0; padding:6rpx 16rpx; border-radius:0 0 12rpx 0; background:#dca35e; color:#fff5df; font-size:18rpx; }
.home-dish-copy { min-width:0; display:flex; flex-direction:column; justify-content:center; padding:8rpx 0; }
.home-dish-name { display:block; font-size:30rpx; line-height:1.3; font-weight:800; }.home-dish-note { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; margin-top:6rpx; font-size:19rpx; line-height:1.5; color:#987753; }
.home-dish-price { display:block; margin-top:7rpx; color:#df7338; font-size:30rpx; font-weight:800; }
.home-dish-action { align-self:flex-start; margin-top:8rpx; padding:8rpx 14rpx; border-radius:12rpx; background:#f5d3a6; color:#a25d32; font-size:21rpx; font-weight:700; }
.home-taster-note { margin-top:8rpx; color:#a0815b; font-size:16rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.home-services { padding:18rpx 18rpx 16rpx; margin-top:8rpx; }.home-service-heading { display:flex; align-items:center; justify-content:space-between; gap:10rpx; }.home-service-motto { color:#a0815b; font-size:17rpx; }
.home-service-list { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8rpx; margin-top:16rpx; }.home-service-row { display:flex; flex-direction:column; align-items:center; padding:13rpx 4rpx; border-radius:14rpx; background:#f9e8c6; min-width:0; }.home-service-row:nth-child(3) { background:#e9eccd; }.home-service-row:nth-child(4) { background:#f8e3c4; }
.home-service-icon { width:44rpx; height:44rpx; }.home-service-label { margin-top:8rpx; font-size:21rpx; font-weight:700; }.home-service-note { margin-top:4rpx; color:#9c805b; font-size:15rpx; text-align:center; }
.home-empty-recommend { padding:32rpx 20rpx; font-size:23rpx; color:#96754f; }
@media(max-width:360px) { .home-page { padding-left:18rpx; padding-right:18rpx; }.home-dish-name { font-size:28rpx; }.home-service-motto { font-size:15rpx; } }
@media(max-width:320px) { .home-featured-swiper { height:320rpx; }.home-recommend-by { font-size:16rpx; }.home-dish-note { font-size:18rpx; } }
@media(orientation:landscape) { .home-page { max-width:600px; } }
