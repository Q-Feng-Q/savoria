<view class="warm-page warm-state-host home-page concept-page">
  <page-state wx:if="{{phase !== 'ready'}}" phase="{{phase}}" title="首页暂时没准备好" description="{{errorMessage || '厨房正在准备今天的家庭餐桌'}}" illustration="orders" bind:retry="load" />
  <block wx:else>
    <view class="design-home-hero home-story warm-home-poster">
      <image class="home-hero__scene home-story__scene warm-home-poster__scene" src="/assets/brand/animal-kitchen-hero.webp" mode="aspectFill" />
      <view class="home-hero__veil home-story__veil warm-home-poster__veil"></view>
      <view class="home-hero__copy home-story__copy warm-home-poster__copy">
        <text class="home-hero__eyebrow home-story__brand">食光知味 · 暖暖动物私厨</text>
        <text class="home-hero__title home-story__title">一家人的\n今日餐桌</text>
        <text class="home-hero__note home-story__note">{{context.family.name}} · 小厨房，大满足</text>
        <view class="ui-button home-hero__action home-story__action" bindtap="openMenu" aria-role="button" aria-label="去看看今天吃什么 →" hover-class="ui-button--pressed" hover-stay-time="80">去看看今天吃什么 <text>→</text></view>
      </view>
      <view class="home-story__mascot warm-home-poster__status"><text>{{currentMemberName}}</text><text>正在开饭</text></view>
    </view>

    <view class="home-role-strip animal-crew sk-stagger-in">
      <view class="home-role"><view class="home-role__badge home-role__badge--bear">熊</view><view><text>{{crew.chefLabel}}</text><text>商户负责人</text></view></view>
      <view class="home-role"><view class="home-role__badge home-role__badge--rabbit">兔</view><view><text>{{crew.helperLabel}}</text><text>家庭管理员</text></view></view>
      <view class="home-role"><view class="home-role__badge home-role__badge--cat">猫</view><view><text>{{crew.tasterLabel}}</text><text>家庭成员</text></view></view>
    </view>

    <view class="home-table-summary today-board sk-stagger-in">
      <view class="home-summary__item today-board__item"><text>当前餐次</text><text>{{mealSummary.label}}</text><text>{{mealSummary.time}}</text></view>
      <view class="home-summary__item today-board__item"><text>家庭餐篮</text><text>{{cartSummary.value}}</text><text>继续加菜</text></view>
      <view class="home-summary__item today-board__item today-board__item--accent"><text>订单状态</text><text>{{orderSummary.statusLabel}}</text><text>及时提醒</text></view>
    </view>

    <swiper wx:if="{{featuredDishes.length}}" class="home-featured-swiper sk-stagger-in" autoplay="{{featuredAutoplay}}" circular="{{featuredCircular}}" indicator-dots="{{featuredIndicatorDots}}" interval="{{featuredInterval}}" next-margin="{{featuredNextMargin}}" indicator-color="rgba(90, 58, 46, .24)" indicator-active-color="#ed7657">
      <swiper-item wx:for="{{featuredDishes}}" wx:key="id" class="home-featured-slide">
        <view class="home-recommendation featured-story" data-id="{{item.id}}" bindtap="openDishDetail" aria-role="button" aria-label="查看{{item.name}}详情" hover-class="home-recommendation--pressed" hover-stay-time="80">
          <view class="home-recommendation__copy featured-story__copy">
            <text class="home-recommendation__eyebrow section-kicker">{{crew.chefRecommendationLabel}}</text>
            <text class="home-recommendation__title featured-story__title">{{item.name}}</text>
            <text class="home-recommendation__note featured-story__note">{{item.description}}</text>
            <text class="home-recommendation__price featured-story__price">{{item.priceText}}</text>
          </view>
          <view class="home-recommendation__plate featured-story__plate"><image class="home-recommendation__image featured-story__image" src="{{item.imageUrl || '/assets/brand/dish-placeholder.png'}}" mode="aspectFill" /></view>
        </view>
      </swiper-item>
    </swiper>

    <view class="home-service-section service-section sk-stagger-in">
      <view class="home-section-head section-heading"><view><text>家里常用</text><text>把今天的餐桌安排明白</text></view><text>{{dailyQuote}}</text></view>
      <view class="home-service-list service-dock">
        <view wx:for="{{quickEntries}}" wx:key="key" class="home-service-row service-link" data-key="{{item.key}}" aria-role="button" aria-label="{{item.label}}，{{item.note}}" hover-class="home-service-row--pressed" hover-stay-time="80" bindtap="openQuickEntry">
          <view class="home-service-row__number service-link__mark">{{index + 1}}</view>
          <view class="home-service-row__copy service-link__copy"><text class="home-service-row__label service-link__label">{{item.label}}</text><text class="home-service-row__note service-link__note">{{item.note}}</text></view>
          <text class="home-service-row__arrow service-link__arrow">›</text>
        </view>
      </view>
    </view>
  </block>
</view>
