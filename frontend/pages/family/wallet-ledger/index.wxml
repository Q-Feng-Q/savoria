<view class="story-page story-subpage warm-page warm-state-host page wallet-ledger-page">
  <page-state wx:if="{{phase !== 'ready'}}" phase="{{phase}}" title="家庭钱包流水" description="{{errorMessage || '正在读取余额变动记录'}}" illustration="wallet" bind:retry="retryLoad" />
  <view wx:if="{{phase === 'ready'}}">
  <view class="hero"><view class="story-subhead-art"><image class="story-art__atlas story-art__atlas--family" src="/assets/brand/approved-story-atlas.jpg" mode="scaleToFill" /></view>
    <text class="eyebrow">家庭钱包</text>
    <text class="title">家庭钱包流水</text>
    <text class="subtitle">商户调整、订单冻结、释放和正式扣减都会留在这里。</text>
  </view>

  <view wx:if="{{!transactions.length}}" class="empty">还没有可查看的流水记录。</view>
  <view wx:else class="list ledger-list">
    <block wx:for="{{transactions}}" wx:key="id">
      <view class="panel ledger-card">
        <view class="row between">
          <view>
            <text class="ledger-title">{{item.title}}</text>
            <text class="ledger-note">{{item.note}}</text>
          </view>
          <view class="ledger-side">
            <text class="ledger-amount {{item.amountClass}}">{{item.amountText}}</text>
            <text class="ledger-tag">{{item.statusText}}</text>
          </view>
        </view>
        <text class="ledger-time">{{item.createdAt}}</text>
      </view>
    </block>
  </view>
  </view>
</view>
