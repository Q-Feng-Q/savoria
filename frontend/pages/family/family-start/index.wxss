.family-start-page{min-height:100vh;padding:24rpx 24rpx 70rpx;background:var(--sk-bg);box-sizing:border-box}.path-section{position:relative;margin-top:24rpx;padding:30rpx;border:2rpx solid var(--sk-ink);border-radius:32rpx 13rpx 32rpx 13rpx;background:var(--sk-paper);box-shadow:var(--sk-shadow-soft)}.path-section--create{background:var(--sk-sprout)}.path-section--join{background:var(--sk-blush)}.path-section__icon{position:absolute;right:24rpx;top:20rpx;font-size:58rpx}.path-section__title,.path-section__note{display:block;padding-right:78rpx}.path-section__title{color:var(--sk-text);font-family:"STSong","Songti SC",serif;font-size:33rpx;font-weight:900}.path-section__note{margin-top:9rpx;color:var(--sk-muted);font-size:21rpx;line-height:1.5}.path-divider{display:flex;align-items:center;justify-content:center;height:64rpx;color:var(--sk-muted);font-size:19rpx}.path-divider::before,.path-divider::after{content:'';width:96rpx;height:2rpx;margin:0 14rpx;background:var(--sk-line)}.mode-switch{display:grid;grid-template-columns:1fr 1fr;gap:10rpx;margin:22rpx 0}.mode-switch .ui-button{min-height:72rpx;margin:0;padding:0 10rpx;border:2rpx solid var(--sk-line);border-radius:18rpx 7rpx 18rpx 7rpx;background:var(--sk-paper);color:var(--sk-muted);font-size:21rpx;font-weight:900}.mode-switch .ui-button::after{border:0}.mode-switch .ui-button.is-active{border-color:var(--sk-ink);background:var(--sk-wheat);color:var(--sk-ink)}.start-field{display:block;margin:20rpx 0}.start-field text{display:block;margin-bottom:8rpx;color:var(--sk-ink);font-size:21rpx;font-weight:900}.start-field input{width:100%;min-height:82rpx;border:2rpx solid var(--sk-line);background:var(--sk-paper);box-sizing:border-box}.status-note{margin-top:20rpx;padding:17rpx;border-radius:19rpx 8rpx 19rpx 8rpx;background:var(--sk-wheat);color:var(--sk-ink);font-size:22rpx;font-weight:900}.status-note--warm{background:var(--sk-paper)}


