<view class="warm-page warm-page--form warm-state-host warm-submit-state family-start-page"><brand-scene title="一起开张吧" subtitle="私密连接你的私厨与家庭" character="welcome" compact /><page-state wx:if="{{loading}}" state="loading" title="正在准备家庭起点" /><block wx:else><view class="path-section path-section--create"><view class="path-section__icon">🏡</view><text class="path-section__title">申请创建家庭</text><text class="path-section__note">已有私厨请填写商户邀请码；也可同时创建服务多个家庭的新私厨。</text><view wx:if="{{familyApplication && familyApplication.status === 'pending'}}" class="status-note">联合申请审核中 · {{familyApplication.familyName}}</view><block wx:else><view class="mode-switch"><view class="ui-button {{merchantMode === 'INVITATION' ? 'is-active' : ''}}" data-mode="INVITATION" bindtap="selectMerchantMode" aria-role="button" aria-label="商户邀请码" hover-class="ui-button--pressed" hover-stay-time="80">商户邀请码</view><view class="ui-button {{merchantMode === 'JOINT_CREATE' ? 'is-active' : ''}}" data-mode="JOINT_CREATE" bindtap="selectMerchantMode" aria-role="button" aria-label="创建新私厨" hover-class="ui-button--pressed" hover-stay-time="80">创建新私厨</view></view><label class="start-field"><text>家庭名称</text><input value="{{familyName}}" data-field="familyName" bindinput="input" /></label><label wx:if="{{merchantMode === 'INVITATION'}}" class="start-field"><text>商户邀请码</text><input value="{{merchantInvitationCode}}" data-field="merchantInvitationCode" bindinput="input" placeholder="输入私厨提供的邀请码" /></label><block wx:else><label class="start-field"><text>新私厨名称</text><input value="{{newMerchantName}}" data-field="newMerchantName" bindinput="input" /></label><label class="start-field"><text>负责人</text><input value="{{contactName}}" data-field="contactName" bindinput="input" /></label><label class="start-field"><text>联系手机</text><input value="{{contactPhone}}" data-field="contactPhone" bindinput="input" /></label></block><action-button label="提交联合申请" loading="{{submitting}}" disabled="{{submitting}}" block bind:action="applyFamily" /></block></view><view class="path-divider"><text>或者</text></view><view class="path-section path-section--join"><view class="path-section__icon">💌</view><text class="path-section__title">加入已有家庭</text><text class="path-section__note">输入家人分享的家庭邀请码。</text><view wx:if="{{joinApplication && joinApplication.status === 'PENDING'}}" class="status-note status-note--warm">加入申请已发送</view><block wx:else><label class="start-field"><text>家庭邀请码</text><input value="{{invitationCode}}" data-field="invitationCode" bindinput="input" /></label><action-button label="申请加入家庭" tone="secondary" block bind:action="joinFamily" /></block></view></block></view>
