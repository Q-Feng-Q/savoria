<view class="warm-page detail-page">
  <page-state wx:if="{{phase !== 'ready'}}" phase="{{phase}}" title="模板菜品详情" description="{{errorMessage || '正在读取模板'}}" bind:retry="retryLoad" />
  <block wx:if="{{phase === 'ready'}}">
    <image class="detail-image" src="{{detail.imageUrl}}" mode="aspectFill" />
    <view class="detail-head">
      <text class="detail-category">{{detail.categoryName}}</text>
      <text class="detail-name">{{detail.name}}</text>
      <text class="detail-description">{{detail.description}}</text>
      <view class="detail-meta"><text>参考价 ¥{{detail.referencePrice}}</text><text>{{detail.tasteText}}</text><text>{{detail.mealText}}</text></view>
    </view>
    <text class="section-title">默认食材</text>
    <view class="ingredient-list">
      <view wx:for="{{detail.ingredients}}" wx:key="id" class="ingredient-row"><text>{{item.ingredientName}}</text><text>{{item.quantity}} {{item.unit}}</text></view>
    </view>
    <view class="source-note">图片：{{detail.imageAuthor}} · {{detail.imageLicense}}</view>
    <view class="detail-actions">
      <view class="detail-change" bindtap="requestChange" aria-role="button" aria-label="申请修改模板" hover-class="ui-button--pressed">申请修改模板</view>
      <view class="detail-import {{detail.imported || importing ? 'detail-import--disabled' : ''}}" bindtap="importTemplate" aria-role="button" aria-label="{{detail.imported ? '菜品已导入' : '导入这道菜'}}" aria-disabled="{{detail.imported || importing}}" aria-busy="{{importing}}" hover-class="ui-button--pressed">{{detail.imported ? '已导入' : (importing ? '导入中…' : '导入这道菜')}}</view>
    </view>
  </block>
</view>
