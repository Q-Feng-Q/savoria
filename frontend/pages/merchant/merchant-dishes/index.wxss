.dishes-page { padding-bottom: 48rpx; background: #fffaf4; }
.page-head { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; padding: 28rpx 0 22rpx; border-bottom: 2rpx solid #eadfd3; }
.eyebrow, .page-title, .page-copy, .dish-name, .dish-meta, .dish-description, .dish-price { display: block; }
.eyebrow { color: #a56f5e; font-size: 22rpx; font-weight: 800; }
.page-title { margin-top: 6rpx; color: #2f2822; font-size: 40rpx; font-weight: 900; }
.page-copy { margin-top: 6rpx; color: #7d7065; font-size: 24rpx; }
.page-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 12rpx; flex: none; }
.primary-action, .secondary-action, .filter, .ingredient-entry, .row-action { display: flex; align-items: center; justify-content: center; min-height: 88rpx; box-sizing: border-box; }
.primary-action { flex: none; padding: 0 28rpx; border-radius: 18rpx; background: #e87561; color: #fff; font-weight: 850; }
.secondary-action { min-height: 88rpx; flex: none; padding: 0 24rpx; border: 2rpx solid #b9cdbd; border-radius: 18rpx; background: #edf5ed; color: #55765c; font-weight: 850; }
.tools { padding: 22rpx 0; border-bottom: 2rpx solid #eadfd3; }
.search-input { min-height: 88rpx; padding: 0 24rpx; border: 2rpx solid #ded3c8; border-radius: 16rpx; background: #fff; box-sizing: border-box; }
.filter-row { display: flex; gap: 12rpx; margin-top: 14rpx; }
.filter { flex: 1; min-width: 0; border-bottom: 4rpx solid transparent; color: #756b62; }
.filter--active { color: #d76552; border-color: #e87561; font-weight: 850; }
.ingredient-entry { margin-top: 10rpx; justify-content: flex-start; color: #677d68; font-weight: 800; }
.dish-list { border-top: 2rpx solid #eadfd3; }
.dish-row { display: grid; grid-template-columns: 108rpx minmax(0, 1fr) 116rpx; gap: 18rpx; align-items: center; padding: 22rpx 0; border-bottom: 2rpx solid #eadfd3; }
.dish-thumb { width: 108rpx; height: 108rpx; border-radius: 14rpx; background: #f1e6d9; }
.dish-main { min-width: 0; }
.dish-heading { display: flex; justify-content: space-between; gap: 12rpx; }
.dish-name { color: #2f2822; font-size: 30rpx; font-weight: 900; overflow-wrap: anywhere; }
.dish-price { flex: none; color: #d76552; font-size: 26rpx; font-weight: 900; }
.dish-meta { margin-top: 7rpx; color: #668269; font-size: 22rpx; }
.dish-description { margin-top: 6rpx; color: #7d7065; font-size: 22rpx; line-height: 1.45; overflow-wrap: anywhere; }
.row-actions { display: flex; flex-direction: column; }
.row-action { color: #655a51; font-size: 24rpx; border-bottom: 2rpx solid #eadfd3; }
.row-action:last-child { border-bottom: 0; }
.row-action--status { color: #668269; }
.row-action--busy { opacity: .5; }
.local-empty { padding: 56rpx 0; color: #84786e; text-align: center; }
.dish-tool-links{display:flex;gap:12rpx;align-items:center}.dish-tool-links .ingredient-entry{flex:1;min-width:0}
@media (orientation: landscape) { .page-actions { flex-wrap: nowrap; max-width: 420rpx; } }
@media (max-width: 320px) { .page-head { align-items: flex-start; flex-direction: column; } .page-actions { width: 100%; flex-direction: column; align-items: stretch; } .primary-action, .secondary-action { width: 100%; } .dish-row { grid-template-columns: 100rpx minmax(0, 1fr); } .dish-thumb { width: 100rpx; height: 100rpx; } .row-actions { grid-column: 2; flex-direction: row; } .row-action { flex: 1; border-bottom: 0; } }
