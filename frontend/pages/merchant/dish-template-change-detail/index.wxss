@import "../../../styles/storybook-merchant.wxss";

.change-detail{padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}.summary{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;padding:28rpx;border:2rpx solid var(--sk-line-soft);border-radius:28rpx 11rpx 28rpx 11rpx;background:var(--sk-paper);box-shadow:var(--sk-shadow-soft)}.summary-kicker,.summary-title,.summary-meta,.block-title,.stale-warning text,.column-title,.ingredient-row text{display:block}.summary-kicker{color:#4d9565;font-size:19rpx;font-weight:900}.summary-title{margin-top:7rpx;font-size:34rpx;font-weight:900}.summary-meta{margin-top:8rpx;color:var(--sk-muted);font-size:20rpx}.status{flex:none;padding:10rpx 15rpx;border-radius:15rpx 6rpx 15rpx 6rpx;font-size:20rpx;font-weight:900}.status--pending{background:#fff1c9;color:#956916}.status--approved{background:#e4f4e6;color:#378354}.status--rejected{background:#fee8df;color:#a34d3b}.status--withdrawn{background:#eeeae3;color:#786f64}.stale-warning,.note-block,.review-block{margin-top:18rpx;padding:20rpx;border-radius:20rpx 8rpx 20rpx 8rpx;font-size:22rpx;line-height:1.55}.stale-warning{border:2rpx solid #efbd77;background:#fff1d9;color:#85561c}.stale-warning text:first-child{font-weight:900}.note-block{background:#f2f8ef;color:#46664e}.review-block{background:#fff6e8;color:#795f4b}.block-title{margin-bottom:7rpx;font-weight:900}.section-title{display:block;margin:28rpx 0 14rpx;font-size:28rpx;font-weight:900}.compare-table{overflow:hidden;border:2rpx solid var(--sk-line-soft);border-radius:22rpx 8rpx 22rpx 8rpx;background:var(--sk-paper)}.compare-head,.compare-row{display:grid;grid-template-columns:132rpx 1fr 1fr}.compare-head{background:#f4ecdf;font-size:20rpx;font-weight:900}.compare-head text,.compare-row text{padding:16rpx 13rpx;border-right:2rpx solid var(--sk-line-soft);word-break:break-all}.compare-row{border-top:2rpx solid var(--sk-line-soft);color:var(--sk-muted);font-size:19rpx}.compare-row--changed{background:#fff7df;color:var(--sk-ink)}.compare-row--changed text:last-child{color:#3c8757;font-weight:900}.ingredient-columns{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.ingredient-columns>view{padding:18rpx;border:2rpx solid var(--sk-line-soft);border-radius:22rpx 8rpx 22rpx 8rpx;background:var(--sk-paper)}.column-title{padding-bottom:12rpx;border-bottom:2rpx solid var(--sk-line-soft);font-size:21rpx;font-weight:900}.ingredient-row{padding:13rpx 0;border-bottom:2rpx dashed var(--sk-line-soft)}.ingredient-row text:first-child{font-size:22rpx;font-weight:900}.ingredient-row text:last-child{margin-top:4rpx;color:var(--sk-muted);font-size:18rpx}.ingredient-row--target text:first-child{color:#3d8758}.withdraw-action{display:flex;align-items:center;justify-content:center;min-height:84rpx;margin-top:28rpx;border:2rpx solid #b85b49;border-radius:22rpx 9rpx 22rpx 9rpx;color:#aa4e3c;font-size:25rpx;font-weight:900}.is-disabled{opacity:.5}@media(max-width:320px){.ingredient-columns{grid-template-columns:1fr}.compare-head,.compare-row{grid-template-columns:110rpx 1fr 1fr}}
