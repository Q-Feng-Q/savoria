.changes-page{min-height:100vh}.changes-head{padding:28rpx 4rpx 24rpx}.eyebrow,.changes-title,.changes-copy,.request-name,.request-id,.request-note{display:block}.eyebrow{color:#4b9563;font-size:18rpx;font-weight:900;letter-spacing:3rpx}.changes-title{margin-top:8rpx;font-family:"STSong","Songti SC",serif;font-size:44rpx;font-weight:900}.changes-copy{margin-top:10rpx;color:var(--sk-muted);font-size:22rpx}.search-row{display:flex;gap:12rpx}.search-row input{flex:1;height:78rpx;padding:0 22rpx;border:2rpx solid var(--sk-line-soft);border-radius:20rpx 8rpx 20rpx 8rpx;background:var(--sk-paper);box-sizing:border-box}.search-action{display:flex;align-items:center;justify-content:center;width:108rpx;border-radius:20rpx 8rpx 20rpx 8rpx;background:#58ab74;color:#fff;font-size:23rpx;font-weight:900}.status-strip{width:auto;margin:20rpx -28rpx}.status-inner{display:flex;gap:12rpx;width:max-content;padding:0 28rpx}.status-filter{padding:14rpx 22rpx;border-radius:17rpx 7rpx 17rpx 7rpx;background:#f3eadc;color:var(--sk-muted);font-size:22rpx}.status-filter--active{background:#5cac77;color:#fff;font-weight:900}.request-row{margin-bottom:16rpx;padding:24rpx;border:2rpx solid var(--sk-line-soft);border-radius:25rpx 10rpx 25rpx 10rpx;background:var(--sk-paper);box-shadow:var(--sk-shadow-soft)}.request-top,.request-foot{display:flex;align-items:flex-start;justify-content:space-between;gap:14rpx}.request-name{font-size:28rpx;font-weight:900}.request-id{margin-top:5rpx;color:var(--sk-muted);font-size:19rpx}.request-status{flex:none;padding:9rpx 14rpx;border-radius:14rpx 6rpx 14rpx 6rpx;font-size:20rpx;font-weight:900}.request-status--pending{background:#fff1c9;color:#956916}.request-status--approved{background:#e4f4e6;color:#378354}.request-status--rejected{background:#fee8df;color:#a34d3b}.request-status--withdrawn{background:#eeeae3;color:#786f64}.request-note{margin-top:16rpx;color:#685747;font-size:22rpx;line-height:1.5}.request-foot{margin-top:17rpx;padding-top:15rpx;border-top:2rpx solid var(--sk-line-soft);color:var(--sk-muted);font-size:20rpx}.list-tip{padding:24rpx;text-align:center;color:var(--sk-muted);font-size:21rpx}
