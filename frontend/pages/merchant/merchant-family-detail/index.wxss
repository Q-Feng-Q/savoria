.family-detail-page { padding-bottom: calc(44rpx + env(safe-area-inset-bottom)); }
.detail-header { padding: 10rpx 0 28rpx; border-bottom: 2rpx solid #eadfce; }
.detail-eyebrow, .detail-title, .detail-copy, .section-heading, .strong, .low-balance, .empty-line { display: block; }
.detail-eyebrow { color: #218d68; font-size: 22rpx; font-weight: 900; }
.detail-title { margin-top: 8rpx; color: #2b2119; font-size: 42rpx; font-weight: 950; }
.detail-copy { margin-top: 8rpx; color: #806854; font-size: 24rpx; line-height: 1.5; }
.detail-section { padding: 30rpx 0; border-bottom: 2rpx solid #eadfce; }
.section-heading { color: #2b2119; font-size: 29rpx; font-weight: 950; }
.detail-line, .detail-actions, .fee-line, .member-actions, .section-top, .preview-row, .local-state { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.detail-line, .fee-line, .member-actions { margin-top: 18rpx; }
.detail-actions { margin-top: 20rpx; }
.detail-action, .compact-action, .section-link, .local-retry { min-height: 88rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 20rpx; font-size: 24rpx; font-weight: 900; }
.detail-action { flex: 1; padding: 0 20rpx; background: #218d68; color: #fff; }
.detail-action--quiet, .compact-action--quiet { background: #fffaf3; color: #3f735f; border: 2rpx solid #cfe2d8; }
.fee-input, .amount-input { min-height: 88rpx; padding: 0 18rpx; box-sizing: border-box; border: 2rpx solid #decfbd; border-radius: 20rpx; background: #fffdf9; }
.fee-input { width: 210rpx; }
.member-row, .address-row, .preview-row { padding: 22rpx 0; border-bottom: 2rpx solid #f0e7da; }
.strong { color: #2b2119; font-weight: 900; }
.low-balance { margin-top: 8rpx; color: #b36320; font-size: 23rpx; font-weight: 850; }
.amount-input { width: 126rpx; }
.compact-action { min-width: 104rpx; padding: 0 14rpx; background: #e8f7f0; color: #276f55; }
.empty-line { margin-top: 18rpx; color: #8f7865; font-size: 24rpx; line-height: 1.5; }
.section-link, .local-retry { min-width: 132rpx; padding: 0 18rpx; color: #218d68; }
.preview-row { color: #574537; font-size: 24rpx; }
.local-state { margin-top: 18rpx; padding: 14rpx 0 14rpx 16rpx; border-left: 6rpx solid #d98532; color: #985c28; font-size: 23rpx; }
