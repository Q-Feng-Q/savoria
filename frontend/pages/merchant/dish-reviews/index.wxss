.review-page{min-height:100vh;padding:28rpx;background:var(--sk-bg);box-sizing:border-box}.review-head{padding:34rpx;border:2rpx solid var(--sk-ink);border-radius:30rpx 12rpx 30rpx 12rpx;background:var(--sk-blush);box-shadow:var(--sk-shadow-soft)}.review-kicker,.review-title,.review-copy,.review-type,.review-target,.review-time,.review-reason{display:block}.review-kicker{color:#b35f47;font-size:18rpx;font-weight:900;letter-spacing:4rpx}.review-title{margin-top:10rpx;font-family:"STSong","Songti SC",serif;font-size:42rpx;font-weight:900}.review-copy{margin-top:10rpx;color:var(--sk-muted);font-size:22rpx;line-height:1.55}.review-list{margin-top:22rpx}.review-row{margin-bottom:18rpx;padding:26rpx;border:2rpx solid var(--sk-line-soft);border-radius:26rpx 10rpx 26rpx 10rpx;background:var(--sk-paper);box-shadow:var(--sk-shadow-soft)}.review-row__top{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.review-type{font-size:29rpx;font-weight:900}.review-target,.review-time{margin-top:7rpx;color:var(--sk-muted);font-size:21rpx}.review-status{flex:none;padding:9rpx 14rpx;border-radius:14rpx 6rpx 14rpx 6rpx;background:var(--sk-wheat);font-size:20rpx;font-weight:900}.review-reason{margin-top:16rpx;padding:15rpx;background:#fff6e8;color:#795f4b;font-size:22rpx;line-height:1.5}.review-action{display:flex;align-items:center;justify-content:center;min-height:68rpx;margin-top:18rpx;border:2rpx solid var(--sk-ink);border-radius:17rpx 7rpx 17rpx 7rpx;background:var(--sk-sprout);color:var(--sk-ink);font-size:21rpx;font-weight:900}.review-action.is-disabled{opacity:.5}
