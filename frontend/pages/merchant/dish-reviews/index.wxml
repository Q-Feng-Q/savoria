<view class="warm-page review-page">
  <view class="review-head"><text class="review-kicker">DISH REVIEW</text><text class="review-title">菜品审核记录</text><text class="review-copy">查看新增与修改菜品的审核进度，待审核记录可以主动撤回。</text></view>
  <page-state wx:if="{{phase !== 'ready'}}" phase="{{phase}}" title="{{phase === 'empty' ? '暂无审核记录' : '审核记录加载中'}}" description="{{phase === 'empty' ? '开启菜品审核后，提交记录会出现在这里。' : errorMessage}}" bind:retry="retryLoad" />
  <view wx:else class="review-list"><view wx:for="{{rows}}" wx:key="id" class="review-row"><view class="review-row__top"><view><text class="review-type">{{item.typeLabel}}</text><text class="review-target">菜品 #{{item.targetDishId || '新建'}}</text></view><text class="review-status review-status--{{item.status}}">{{item.statusLabel}}</text></view><text class="review-time">提交于 {{item.submittedText || '时间未知'}}</text><text wx:if="{{item.reviewReason}}" class="review-reason">审核说明：{{item.reviewReason}}</text><view wx:if="{{item.canWithdraw}}" class="ui-button review-action {{busyReviewMap[item.id] ? 'is-disabled' : ''}}" data-id="{{item.id}}" bindtap="withdrawDishReview" aria-role="button" aria-label="撤回本次审核" aria-disabled="{{busyReviewMap[item.id]}}" hover-class="ui-button--pressed">{{busyReviewMap[item.id] ? '撤回中…' : '撤回本次审核'}}</view></view></view>
</view>
