@import "../../../styles/storybook-merchant.wxss";

.change-editor { padding-bottom:calc(180rpx + env(safe-area-inset-bottom)); background:var(--sk-bg); }
.editor-heading { padding:30rpx 4rpx 24rpx; }
.eyebrow,.editor-title,.editor-copy,.section-title,.field>text,.switch-title,.switch-copy { display:block; }
.eyebrow { color:#4b9563; font-size:18rpx; font-weight:900; letter-spacing:3rpx; }
.editor-title { margin-top:8rpx; color:var(--sk-ink); font-family:"STSong","Songti SC",serif; font-size:44rpx; font-weight:900; }
.editor-copy { margin-top:10rpx; color:var(--sk-muted); font-size:22rpx; line-height:1.6; }
.form-section { margin-bottom:20rpx; padding:26rpx; border:2rpx solid var(--sk-line-soft); border-radius:26rpx 10rpx 26rpx 10rpx; background:var(--sk-paper); box-shadow:var(--sk-shadow-soft); }
.section-head { display:flex; align-items:center; justify-content:space-between; }
.section-title { margin-bottom:20rpx; font-size:28rpx; font-weight:900; }
.field { margin-top:18rpx; }
.field>text { margin-bottom:8rpx; color:var(--sk-muted); font-size:21rpx; font-weight:800; }
.field input,.field textarea,.picker-control { width:100%; min-height:78rpx; padding:18rpx 20rpx; border:2rpx solid var(--sk-line-soft); border-radius:17rpx 7rpx 17rpx 7rpx; background:#fffdf8; box-sizing:border-box; font-size:24rpx; }
.field textarea { min-height:142rpx; }
.field-grid { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; }
.choice-row { display:flex; gap:12rpx; }
.choice { flex:1; padding:17rpx 8rpx; border:2rpx solid var(--sk-line-soft); border-radius:17rpx 7rpx 17rpx 7rpx; text-align:center; color:var(--sk-muted); font-size:22rpx; }
.choice--active { border-color:#56aa73; background:#edf7ef; color:#398455; font-weight:900; }
.switch-row { display:flex; align-items:center; justify-content:space-between; margin-top:24rpx; padding-top:20rpx; border-top:2rpx solid var(--sk-line-soft); }
.switch-title { font-size:24rpx; font-weight:900; }
.switch-copy { margin-top:5rpx; color:var(--sk-muted); font-size:19rpx; }
.text-action,.remove-action { color:#3e8c5c; font-size:22rpx; font-weight:900; }
.remove-action { color:#b15847; }
.template-image-editor { display:flex; align-items:center; gap:20rpx; }
.template-image-editor image,.template-image-empty { width:210rpx; height:158rpx; flex:none; border-radius:20rpx 8rpx 20rpx 8rpx; background:#f4efe7; }
.template-image-empty { display:flex; align-items:center; justify-content:center; color:var(--sk-muted); font-size:21rpx; }
.template-image-actions { display:grid; gap:22rpx; }
.image-rights { display:flex; align-items:flex-start; gap:14rpx; margin-top:20rpx; padding:18rpx; border:2rpx solid var(--sk-line-soft); border-radius:16rpx 7rpx 16rpx 7rpx; color:var(--sk-muted); font-size:21rpx; line-height:1.5; }
.image-rights--checked { border-color:#56aa73; background:#edf7ef; color:#357d50; }
.rights-check { display:flex; align-items:center; justify-content:center; width:30rpx; height:30rpx; flex:none; border:2rpx solid #56aa73; border-radius:7rpx; color:#fff; background:#56aa73; }
.ingredient-editor,.step-editor { margin-top:18rpx; padding:18rpx; border:2rpx dashed #dbcdbd; border-radius:20rpx 8rpx 20rpx 8rpx; background:#fffcf5; }
.step-editor { border-style:solid; background:#fffdf8; }
.ingredient-head { display:flex; align-items:center; justify-content:space-between; font-size:23rpx; font-weight:900; }
.empty-copy { padding:20rpx 0; color:var(--sk-muted); font-size:22rpx; }
.safe-action-bar { position:fixed; z-index:30; left:0; right:0; bottom:0; padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); background:rgba(255,250,244,.96); box-shadow:0 -12rpx 36rpx rgba(97,72,43,.12); }
.submit-action { display:flex; align-items:center; justify-content:center; min-height:88rpx; border-radius:23rpx 10rpx 23rpx 10rpx; background:#55ad74; color:#fff; font-size:28rpx; font-weight:900; }
.is-disabled { opacity:.5; }
@media(max-width:320px) { .field-grid{grid-template-columns:1fr}.choice-row{flex-wrap:wrap}.choice{min-width:28%} }
