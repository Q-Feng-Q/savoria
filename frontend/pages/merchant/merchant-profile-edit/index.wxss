@import "../../../styles/storybook-merchant.wxss";

.merchant-profile-page{min-height:100vh;padding:34rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:var(--sk-bg);overflow-x:hidden}.merchant-profile-sheet{width:100%;max-width:760rpx;margin:0 auto;padding:30rpx;border:2rpx solid #e5cdb2;border-radius:28rpx;background:#fffaf1;box-sizing:border-box;box-shadow:0 14rpx 38rpx rgba(91,58,39,.08)}.merchant-profile-heading{margin-bottom:30rpx;padding-bottom:26rpx;border-bottom:2rpx solid #ead8c4}.merchant-profile-eyebrow,.merchant-profile-title,.merchant-profile-note{display:block;overflow-wrap:anywhere}.merchant-profile-eyebrow{color:#8a6c57;font-size:21rpx;font-weight:850}.merchant-profile-title{margin-top:8rpx;color:#4f392f;font-size:38rpx;font-weight:950}.merchant-profile-note{margin-top:12rpx;color:#826b5c;font-size:22rpx;line-height:1.6}.merchant-profile-field{display:block;margin-top:22rpx}.merchant-profile-field text{display:block;margin-bottom:10rpx;color:#4f392f;font-size:23rpx;font-weight:900}.merchant-profile-field input{width:100%;min-height:88rpx;padding:0 24rpx;border:2rpx solid #d8bda2;border-radius:18rpx;background:#fffdf8;color:#4f392f;box-sizing:border-box;font-size:25rpx}.merchant-profile-actions{display:flex;gap:16rpx;margin-top:34rpx}.merchant-profile-save,.merchant-profile-cancel{display:flex;flex:1;align-items:center;justify-content:center;min-height:88rpx;border-radius:20rpx;font-size:27rpx;box-sizing:border-box}.merchant-profile-save{background:#9f4f3d;color:#fffdf8;font-weight:950}.merchant-profile-cancel{border:2rpx solid #9b765f;background:#fffdf8;color:#4f392f;font-weight:900}.merchant-profile-save.is-disabled,.merchant-profile-cancel.is-disabled{opacity:.58}.ui-button--pressed{transform:scale(.985);box-shadow:inset 0 0 0 999rpx rgba(58,42,36,.1)}@media (max-width:360px){.merchant-profile-page{padding-left:20rpx;padding-right:20rpx}.merchant-profile-sheet{padding:24rpx}.merchant-profile-title{font-size:34rpx}.merchant-profile-actions{flex-direction:column}.merchant-profile-field input,.merchant-profile-save,.merchant-profile-cancel{min-height:88rpx}}
