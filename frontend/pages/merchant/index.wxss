.merchant-page {
  min-height: 100vh;
  box-sizing: border-box;
}

.merchant-overview {
  animation: merchant-enter 220ms ease-out both;
}

.merchant-identity {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0 30rpx;
  border-bottom: 2rpx solid var(--sk-line-soft);
}

.merchant-identity__copy {
  min-width: 0;
}

.merchant-identity__eyebrow,
.merchant-identity__name {
  display: block;
  overflow-wrap: anywhere;
}

.merchant-identity__eyebrow {
  color: #8f7865;
  font-size: 22rpx;
  font-weight: 800;
}

.merchant-identity__name {
  margin-top: 8rpx;
  color: var(--sk-ink);
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.18;
}

.merchant-identity__switch {
  flex: none;
  max-width: 190rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: var(--sk-wheat);
  color: var(--sk-ink);
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.3;
  text-align: center;
  overflow-wrap: anywhere;
}

.merchant-focus {
  margin-top: 28rpx;
  padding: 34rpx;
  border-radius: 28rpx;
  background: #4b2f24;
  color: #fff9ee;
}

.merchant-focus__label,
.merchant-focus__note {
  display: block;
  color: #ead8c6;
  font-size: 23rpx;
}

.merchant-focus__metric {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 12rpx;
}

.merchant-focus__value {
  font-size: 74rpx;
  font-weight: 950;
  line-height: 1;
}

.merchant-focus__unit {
  font-size: 25rpx;
  font-weight: 850;
}

.merchant-focus__note {
  margin-top: 16rpx;
}

.merchant-helper-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 28rpx;
  border-top: 2rpx solid var(--sk-line-soft);
  border-bottom: 2rpx solid var(--sk-line-soft);
}

.merchant-helper-stat {
  min-width: 0;
  padding: 24rpx 20rpx 24rpx 0;
}

.merchant-helper-stat + .merchant-helper-stat {
  padding-left: 24rpx;
  border-left: 2rpx solid var(--sk-line-soft);
}

.merchant-helper-stat__label,
.merchant-helper-stat__value {
  display: block;
}

.merchant-helper-stat__label {
  color: #806854;
  font-size: 22rpx;
  font-weight: 800;
}

.merchant-helper-stat__value {
  margin-top: 8rpx;
  color: var(--sk-ink);
  font-size: 38rpx;
  font-weight: 950;
}

.merchant-actions {
  margin-top: 24rpx;
}

.merchant-quick-action {
  display: block;
  margin-top: 12rpx;
}

.merchant-vignette-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 30rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--sk-line-soft);
}

.merchant-menu-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 16rpx 0;
  border-top: 2rpx solid var(--sk-line-soft);
  color: #9b5746;
  font-size: 21rpx;
}

.merchant-menu-state__retry {
  flex: none;
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: var(--sk-wheat);
  color: var(--sk-ink);
  font-size: 21rpx;
  font-weight: 900;
}

.merchant-vignette {
  display: block;
  width: 100%;
  height: 108rpx;
  border-radius: 18rpx;
}

.merchant-inline-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #f8dfcc;
  font-size: 21rpx;
}

.merchant-inline-state--light {
  display: block;
  color: #9b5746;
  line-height: 1.4;
}

.merchant-inline-state__retry {
  flex: none;
  padding: 10rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(255, 249, 238, 0.15);
  font-size: 21rpx;
  font-weight: 900;
}

.merchant-inline-state--light .merchant-inline-state__retry {
  display: inline-block;
  margin-top: 8rpx;
  background: var(--sk-wheat);
  color: var(--sk-ink);
}

@keyframes merchant-enter {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 360px) {
  .merchant-identity {
    gap: 12rpx;
  }

  .merchant-identity__name {
    font-size: 34rpx;
  }

  .merchant-identity__switch {
    max-width: 156rpx;
    font-size: 19rpx;
  }

  .merchant-focus {
    padding: 28rpx;
  }

  .merchant-vignette {
    height: 92rpx;
  }
}
