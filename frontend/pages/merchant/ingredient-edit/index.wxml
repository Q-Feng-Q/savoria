<view class="merchant-story warm-page ingredient-page">
  <view class="editor-head">
    <text class="eyebrow">原材料管理</text>
    <text class="editor-title">食材库</text>
    <text class="editor-copy">按名称或分类查找，点选食材即可编辑。</text>
  </view>
  <view class="toolbar">
    <input class="search-input" value="{{query}}" bindinput="bindSearch" placeholder="搜索食材名称、分类或单位" aria-label="搜索食材" />
    <view class="ui-button create-action" bindtap="openCreate" aria-role="button" aria-label="新增食材" aria-disabled="{{busyIngredientId}}" hover-class="ui-button--pressed">新增食材</view>
  </view>
  <page-state wx:if="{{phase === 'loading' || phase === 'error'}}" phase="{{phase}}" title="食材库" description="{{errorMessage}}" bind:retry="retryLoad" />
  <view wx:else class="ingredient-workspace">
    <view class="list-heading"><text class="section-title">食材列表</text><text class="list-count">{{visibleIngredients.length}} / {{ingredients.length}} 种</text></view>
    <view wx:if="{{phase === 'empty'}}" class="empty-copy">食材库为空，点“新增食材”开始添加。</view>
    <view wx:elif="{{!visibleIngredients.length}}" class="empty-copy">没有找到匹配的食材，请换个关键词。</view>
    <block wx:else>
      <block wx:for="{{visibleIngredients}}" wx:key="id">
        <view class="ingredient-row">
          <view class="ingredient-main" data-id="{{item.id}}" bindtap="openEdit" aria-role="button" aria-label="编辑{{item.name}}" aria-disabled="{{busyIngredientId}}" hover-class="ingredient-main--pressed">
            <view class="ingredient-title"><text class="strong">{{item.name}}</text><text class="unit">{{item.unit}}</text></view>
            <text class="muted">{{item.category}}</text>
            <text class="reference">{{item.usedByDishCount}} 道菜引用 · {{item.usedByDishText}}</text>
          </view>
          <view class="row-actions"><text class="chevron">›</text><view wx:if="{{item.removable}}" class="text-action" data-id="{{item.id}}" bindtap="removeIngredient" aria-role="button" aria-label="删除{{item.name}}" aria-disabled="{{busyIngredientId}}" hover-class="ui-button--pressed">{{busyIngredientId === item.id ? '处理中' : '删除'}}</view><text wx:else class="delete-disabled">已引用</text></view>
        </view>
      </block>
    </block>
  </view>
</view>
