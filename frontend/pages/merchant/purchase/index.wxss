.purchase-page { min-height: 100vh; box-sizing: border-box; padding-bottom: 64rpx; }
.purchase-heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 10rpx 0 26rpx; border-bottom: 2rpx solid var(--sk-line-soft); }
.purchase-eyebrow, .purchase-title, .ingredient-name, .ingredient-quantity, .source-status, .source-dishes, .breakdown-line { display: block; }
.purchase-eyebrow { color: #8f7865; font-size: 21rpx; font-weight: 850; }
.purchase-title { margin-top: 7rpx; color: var(--sk-ink); font-size: 35rpx; font-weight: 950; }
.purchase-art { flex: none; width: 112rpx; height: 84rpx; border-radius: 16rpx; }
.purchase-controls { display: flex; align-items: center; gap: 10rpx; padding: 20rpx 0; overflow-x: auto; border-bottom: 2rpx solid var(--sk-line-soft); }
.control-value, .copy-action { display: flex; align-items: center; min-height: 88rpx; box-sizing: border-box; white-space: nowrap; padding: 0 15rpx; border-radius: 14rpx; background: var(--sk-wheat); color: var(--sk-ink); font-size: 21rpx; font-weight: 850; }
.copy-action { background: #b65f2e; color: #fffaf1; }
.source-summary { display: flex; justify-content: space-between; gap: 16rpx; padding: 20rpx 0; color: #806854; font-size: 21rpx; font-weight: 850; border-bottom: 2rpx solid var(--sk-line-soft); }
.ingredient-row { padding: 24rpx 0; border-bottom: 2rpx solid var(--sk-line-soft); }
.ingredient-row__top { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.ingredient-name { color: var(--sk-ink); font-size: 27rpx; font-weight: 950; }
.ingredient-quantity { color: #b65f2e; font-size: 24rpx; font-weight: 950; text-align: right; }
.source-status, .source-dishes, .breakdown-line { margin-top: 9rpx; color: #806854; font-size: 21rpx; line-height: 1.45; overflow-wrap: anywhere; }
.source-status { color: #9b5746; font-weight: 850; }
.breakdown-line { padding-left: 14rpx; border-left: 3rpx solid #e7cdb1; }
.temp-section { padding: 24rpx 0; border-bottom: 2rpx solid var(--sk-line-soft); }
.temp-section__title, .temp-row__name, .temp-row__remark, .temp-form__meal { display: block; }
.temp-section__title { color: var(--sk-ink); font-size: 26rpx; font-weight: 950; }
.temp-row { display: flex; align-items: stretch; gap: 10rpx; border-bottom: 2rpx solid rgba(142, 112, 86, .12); }
.temp-row--checked { opacity: .58; }
.temp-row__toggle { display: flex; flex: 1; min-width: 0; min-height: 88rpx; flex-direction: column; justify-content: center; padding: 12rpx 0; }
.temp-row__name { color: var(--sk-ink); font-size: 22rpx; font-weight: 900; }
.temp-row__remark { margin-top: 5rpx; color: #806854; font-size: 20rpx; }
.temp-row__delete { display: flex; align-items: center; min-height: 88rpx; padding: 0 14rpx; color: #9b5746; font-size: 20rpx; font-weight: 900; }
.temp-form { display: grid; grid-template-columns: minmax(0, 2fr) minmax(100rpx, 1fr) minmax(100rpx, 1fr); gap: 10rpx; margin-top: 18rpx; }
.temp-input { min-width: 0; min-height: 88rpx; padding: 0 14rpx; border: 2rpx solid var(--sk-line-soft); border-radius: 14rpx; background: #fffdfa; box-sizing: border-box; font-size: 21rpx; }
.temp-input--remark { grid-column: 1 / 3; }
.temp-form__meal { align-self: center; color: #806854; font-size: 20rpx; }
.temp-form__add { display: flex; align-items: center; justify-content: center; min-height: 88rpx; border-radius: 14rpx; background: #b65f2e; color: #fffaf1; font-size: 21rpx; font-weight: 900; }
@media (max-width: 360px) { .purchase-title { font-size: 30rpx; } .purchase-art { width: 92rpx; height: 72rpx; } .source-summary { display: block; } .source-summary text { display: block; margin-top: 5rpx; } }
