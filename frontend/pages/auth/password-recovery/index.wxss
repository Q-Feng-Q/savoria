.recovery-page{min-height:100vh;padding:26rpx;background:var(--sk-bg);box-sizing:border-box}.recovery-form{margin-top:24rpx;padding:30rpx;border:2rpx solid var(--sk-line);border-radius:30rpx 12rpx 30rpx 12rpx;background:var(--sk-paper);box-shadow:var(--sk-shadow-soft)}.recovery-title,.recovery-note,.recovery-field text{display:block}.recovery-title{font-family:"STSong","Songti SC",serif;font-size:38rpx;font-weight:900;color:var(--sk-text)}.recovery-note{margin:10rpx 0 24rpx;color:var(--sk-muted);font-size:22rpx;line-height:1.55}.recovery-field{display:block;margin:20rpx 0}.recovery-field text{margin-bottom:9rpx;color:var(--sk-ink);font-size:22rpx;font-weight:900}.recovery-field input,.code-row input{min-height:84rpx;padding:0 18rpx;border:2rpx solid var(--sk-line);border-radius:19rpx 8rpx 19rpx 8rpx;background:#fffaf0;box-sizing:border-box}.code-row{display:grid;grid-template-columns:minmax(0,1fr) 190rpx;gap:12rpx;align-items:center}.code-action{display:flex;align-items:center;justify-content:center;min-height:84rpx;border:2rpx solid var(--sk-ink);border-radius:19rpx 8rpx 19rpx 8rpx;background:var(--sk-sprout);color:var(--sk-ink);font-size:21rpx;font-weight:900}.code-action.is-disabled{opacity:.55}
