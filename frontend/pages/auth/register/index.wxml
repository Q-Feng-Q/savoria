<view class="warm-page warm-page--form warm-state-host warm-submit-state register-page"><brand-scene title="注册新账户" subtitle="先创建个人账户，家庭与后台权限在注册后申请" character="welcome" compact /><view class="register-form"><label class="register-field"><text>账户名</text><input value="{{form.username}}" placeholder="3-50位字母、数字或下划线" bindinput="onUsernameInput" /></label><label class="register-field"><text>密码</text><input password value="{{form.password}}" placeholder="6-64位密码" bindinput="onPasswordInput" /></label><label class="register-field"><text>姓名</text><input value="{{form.name}}" placeholder="请输入姓名" bindinput="onNameInput" /></label><label class="register-field"><text>手机号（可选）</text><input type="number" value="{{form.mobile}}" placeholder="请输入手机号" bindinput="onMobileInput" /></label><text class="register-note">注册只创建个人账户，不会自动获得商户或平台后台权限。</text><action-button label="{{loading ? '注册中...' : '创建账户'}}" loading="{{loading}}" disabled="{{loading}}" block bind:action="submitRegister" /></view></view>
