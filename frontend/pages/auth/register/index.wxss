.register-page{min-height:100vh;padding:26rpx;background:var(--sk-bg);box-sizing:border-box}.register-form{margin-top:24rpx;padding:30rpx;border:2rpx solid var(--sk-line);border-radius:30rpx 12rpx 30rpx 12rpx;background:var(--sk-paper);box-shadow:var(--sk-shadow-soft)}.register-field{display:block;margin-bottom:22rpx}.register-field text{display:block;margin-bottom:9rpx;color:var(--sk-ink);font-size:22rpx;font-weight:900}.register-field input{width:100%;min-height:84rpx;padding:0 18rpx;border:2rpx solid var(--sk-line);border-radius:19rpx 8rpx 19rpx 8rpx;background:#fffaf0;color:var(--sk-text);font-size:27rpx;box-sizing:border-box}.register-note{display:block;margin:2rpx 0 22rpx;padding:15rpx 17rpx;border-radius:18rpx 8rpx 18rpx 8rpx;background:var(--sk-blush);color:var(--sk-muted);font-size:20rpx;line-height:1.5}

