<view class="warm-page warm-state-host cart-page">
  <page-state wx:if="{{phase !== 'ready'}}" phase="{{phase}}" title="餐篮暂时没准备好" description="{{errorMessage || '正在同步全家的选择'}}" illustration="orders" bind:retry="load" />
  <block wx:else>
    <view class="cart-head">
      <text class="cart-head__kicker">家庭共享餐篮 · 仅限今天</text>
      <text class="cart-head__title">确认今天的菜</text>
      <text class="cart-head__note">{{context.member.name}} · {{context.family.name}} · 家庭钱包统一结算</text>
    </view>

    <view class="checkout-section time-section">
      <view class="section-line"><text>预计用餐时间</text><text>{{serviceDate}}</text></view>
      <view wx:if="{{bookingEnded}}" class="booking-ended">今天已停止预约，请明天再来</view>
      <picker wx:else mode="selector" range="{{expectedMealTimeOptions}}" range-key="label" value="{{expectedMealTimeIndex}}" bindchange="bindExpectedMealTime">
        <view class="picker-text expected-time-picker">{{expectedMealTimeText}}<text>修改</text></view>
      </picker>
    </view>

    <view class="checkout-section">
      <view class="section-line"><text>交付方式</text><text>提交前可随时修改</text></view>
      <view class="delivery-row"><view wx:for="{{deliveryOptions}}" wx:key="key" class="ui-button delivery-option {{item.activeClass}} {{item.disabled ? 'is-disabled' : ''}}" data-mode="{{item.key}}" data-disabled="{{item.disabled}}" aria-disabled="{{item.disabled}}" bindtap="selectDelivery" aria-role="button" aria-label="{{item.label}}" hover-class="ui-button--pressed" hover-stay-time="80">{{item.label}}</view></view>
      <label wx:if="{{context.family.addresses.length}}" class="cart-field"><text>地址簿</text><picker range="{{addressOptions}}" range-key="label" value="{{addressIndex}}" bindchange="bindAddress"><view class="picker-text">{{addressOptions[addressIndex] ? addressOptions[addressIndex].label : '请选择地址'}}</view></picker></label>
      <view wx:if="{{currentAddress}}" class="address-line"><text>{{currentAddress.contactName}} · {{currentAddress.phone}}</text><text>{{currentAddress.address}}</text></view>
      <label class="cart-field"><text>整单备注</text><textarea value="{{cart.note}}" placeholder="不要香菜、孩子也吃……" bindblur="bindNote" /></label>
    </view>

    <view class="selected-section">
      <view class="section-line"><text>全家已选</text><text>{{totals.totalAmount ? '合计 ¥' + totals.totalAmount : ''}}</text></view>
      <page-state wx:if="{{!groupedItems.length}}" phase="empty" title="餐篮还是空的" description="先去点几道家人爱吃的菜吧" illustration="orders" />
      <block wx:for="{{groupedItems}}" wx:for-item="group" wx:key="memberId">
        <view wx:for="{{group.rows}}" wx:for-item="row" wx:key="id" class="cart-row-wrap">
          <view class="cart-row">
            <view class="cart-row__copy">
              <view class="cart-row__title"><text class="cart-row__name">{{row.dishName}}</text><text class="cart-total-badge">共 × {{row.totalQuantity}}</text></view>
              <text class="cart-row__meta">¥{{row.price}} / 份 · 小计 ¥{{row.amount}}</text>
              <textarea data-id="{{row.id}}" value="{{row.note}}" placeholder="我选的这道菜备注" bindblur="bindItemNote" />
            </view>
            <view class="cart-stepper">
              <view data-id="{{row.id}}" data-delta="-1" bindtap="changeCount" class="ui-button" aria-role="button" aria-label="减少我的数量" hover-class="ui-button--pressed" hover-stay-time="80">−</view>
              <view class="my-count"><text>我选</text><text>{{row.myQuantity}}</text></view>
              <view data-id="{{row.id}}" data-delta="1" bindtap="changeCount" class="ui-button" aria-role="button" aria-label="增加我的数量" hover-class="ui-button--pressed" hover-stay-time="80">＋</view>
            </view>
          </view>
          <view wx:if="{{row.hasSelectionDetails}}" class="ui-button selection-toggle" data-id="{{row.id}}" bindtap="toggleSelectionDetails" aria-role="button" aria-label="查看选择明细" hover-class="ui-button--pressed" hover-stay-time="80">{{expandedDishIds[row.id] ? '收起选择明细' : '查看谁选了这道菜'}}</view>
          <view wx:if="{{expandedDishIds[row.id]}}" class="selection-details">
            <view wx:for="{{row.selections}}" wx:key="memberId" class="selection-detail-row"><text>{{item.memberName}} × {{item.quantity}}</text><text>{{item.itemRemark || '无备注'}}</text></view>
          </view>
        </view>
      </block>
    </view>
    <view wx:if="{{warningText}}" class="cart-warning">{{warningText}}</view>
    <bottom-action-bar summary="{{'合计 ¥' + totals.totalAmount}}" primaryText="提交订单" disabled="{{!canSubmit || mutationBusy}}" bind:primary="submitOrder"><text slot="summary" class="bottom-note">订单将从家庭钱包统一冻结并扣款</text></bottom-action-bar>
  </block>
</view>
