<view class="warm-page warm-state-host cart-page" wx:if="{{context}}">
  <view class="cart-head"><text class="cart-head__kicker">家庭共享餐篮</text><text class="cart-head__title">确认今天的菜</text><text class="cart-head__note">{{context.member.name}} · {{context.family.name}} · 谁点谁扣</text></view>
  <view class="cart-meals"><view wx:for="{{mealOptions}}" wx:key="key" class="ui-button cart-meal {{item.activeClass}}" data-meal="{{item.key}}" bindtap="selectMeal" aria-role="button" aria-label="{{item.label}}{{item.time}}" hover-class="ui-button--pressed" hover-stay-time="80"><text>{{item.label}}</text><text>{{item.time}}</text></view></view>
  <view class="checkout-section"><view class="section-line"><text>交付方式</text><text>下单前最后确认</text></view><view class="delivery-row"><view wx:for="{{deliveryOptions}}" wx:key="key" class="ui-button delivery-option {{item.activeClass}} {{item.disabled ? 'is-disabled' : ''}}" data-mode="{{item.key}}" data-disabled="{{item.disabled}}" aria-disabled="{{item.disabled}}" bindtap="selectDelivery" aria-role="button" aria-label="{{item.label}}" hover-class="ui-button--pressed" hover-stay-time="80">{{item.label}}</view></view><label wx:if="{{context.family.addresses.length}}" class="cart-field"><text>地址簿</text><picker range="{{addressOptions}}" range-key="label" value="{{addressIndex}}" bindchange="bindAddress"><view class="picker-text">{{addressOptions[addressIndex] ? addressOptions[addressIndex].label : '请选择地址'}}</view></picker></label><view wx:if="{{currentAddress}}" class="address-line"><text>{{currentAddress.contactName}} · {{currentAddress.phone}}</text><text>{{currentAddress.address}}</text></view><label class="cart-field"><text>整单备注</text><textarea value="{{cart.note}}" placeholder="不要香菜、孩子也吃……" bindblur="bindNote" /></label></view>
  <view class="selected-section"><view class="section-line"><text>今天已选</text><text>{{groupedItems.length}} 位家人</text></view><page-state wx:if="{{!groupedItems.length}}" phase="empty" title="餐篮还是空的" description="先去点几道家人爱吃的菜吧" illustration="orders" /><view wx:for="{{groupedItems}}" wx:for-item="group" wx:key="memberId" class="owner-group"><view class="owner-group__head"><text>{{group.ownerName}}</text><text>{{group.totalAmountText}}</text></view><view wx:for="{{group.rows}}" wx:for-item="row" wx:key="id" class="cart-row"><view class="cart-row__copy"><text class="cart-row__name">{{row.dishName}}</text><text class="cart-row__meta">¥{{row.price}} / 份</text><textarea wx:if="{{row.canEdit}}" data-id="{{row.id}}" value="{{row.note}}" placeholder="这道菜的备注" bindblur="bindItemNote" /><text wx:elif="{{row.note}}" class="cart-row__meta">备注：{{row.note}}</text></view><view wx:if="{{row.canEdit}}" class="cart-stepper"><view data-id="{{row.id}}" data-delta="-1" bindtap="changeCount" class="ui-button" aria-role="button" aria-label="−" hover-class="ui-button--pressed" hover-stay-time="80">−</view><text>{{row.quantity}}</text><view data-id="{{row.id}}" data-delta="1" bindtap="changeCount" class="ui-button" aria-role="button" aria-label="＋" hover-class="ui-button--pressed" hover-stay-time="80">＋</view></view><text wx:else class="locked-count">x{{row.quantity}}</text></view></view></view>
  <view wx:if="{{warningText}}" class="cart-warning">{{warningText}}</view>
  <bottom-action-bar summary="{{'合计 ¥' + totals.totalAmount}}" primaryText="提交订单" disabled="{{!canSubmit}}" bind:primary="submitOrder"><text slot="summary" class="bottom-note">菜品 ¥{{totals.dishTotal}} · 配送 ¥{{totals.deliveryFee}}</text></bottom-action-bar>
</view>


