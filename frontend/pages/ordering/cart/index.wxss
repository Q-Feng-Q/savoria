@import "../../../styles/approved-storybook.wxss";
.delivery-option__icon { width:40rpx; height:40rpx; flex-shrink:0; }
.cart-item-warning { color:var(--sk-danger); }
.cart-page { min-height:100vh; width:100%; max-width:720px; margin:0 auto; padding:0 24rpx 148rpx; background:#fff3d7; box-sizing:border-box; }
.checkout-section,.selected-section { margin-top:22rpx; padding:26rpx; border:2rpx solid #efddb7; border-radius:28rpx; background:linear-gradient(110deg,#fff6e0,#fff0d2); box-shadow:0 10rpx 24rpx rgba(151,108,41,.09); }
.time-section { margin-top:0; }.time-content { display:flex; align-items:center; gap:22rpx; margin-top:18rpx; }.time-picker { flex:1; width:62%; min-height:0; padding:0; border:0; background:transparent; }.expected-time-picker { display:flex; align-items:center; gap:14rpx; min-height:116rpx; padding:14rpx 18rpx; border:2rpx solid #efddb7; border-radius:20rpx; background:linear-gradient(110deg,#fff7e7,#fbecc9); box-shadow:inset 0 2rpx 9rpx rgba(157,111,40,.07); }.time-clock { color:#ec862e; font-size:40rpx; }.time-date { display:block; font-size:22rpx; color:#654529; }.time-value { display:block; margin-top:4rpx; font-size:48rpx; font-weight:900; line-height:1.1; color:#50311b; }.time-chevron { margin-left:auto; color:#9c7b4e; font-size:36rpx; }.time-quote { width:30%; padding-left:18rpx; border-left:2rpx solid #e9d6ae; color:#916e45; font-family:"STKaiti","KaiTi",serif; font-size:22rpx; line-height:1.7; white-space:pre-line; transform:rotate(-5deg); }
.delivery-row { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); margin-top:22rpx; border:2rpx solid #e2d4b7; border-radius:20rpx; overflow:hidden; }.delivery-option { display:flex; align-items:center; justify-content:center; gap:12rpx; min-height:88rpx; padding:12rpx 10rpx; border:2rpx solid transparent; border-radius:18rpx; background:#fcf2dc; color:#785431; font-size:29rpx; font-weight:800; box-sizing:border-box; }.delivery-option.active { border-color:#77934c; background:#dce4bb; color:#38582b; }.delivery-option.is-disabled { color:#b0a892; background:#f6eedb; }.delivery-option__icon { font-size:38rpx; line-height:1; }
.cart-field { display:block; margin-top:22rpx; }.cart-field>text { display:block; font-size:26rpx; font-weight:700; margin-bottom:12rpx; color:#654627; }.address-picker { width:100%; padding:0; border:0; background:transparent; min-height:0; }.address-line { display:flex; align-items:center; gap:14rpx; padding:18rpx 14rpx; border:2rpx solid #e5d5b6; border-radius:20rpx; background:#fcf2db; }.address-copy { flex:1; min-width:0; }.address-main { display:block; font-size:24rpx; line-height:1.5; color:#4f3d25; font-weight:800; }.address-contact { display:block; margin-top:4rpx; font-size:20rpx; color:#907c60; }.address-pin { font-size:38rpx; color:#6b8043; }.address-chevron { font-size:32rpx; color:#9c7c4e; }.address-book { padding:10rpx 0 10rpx 10rpx; border-left:2rpx solid #e5d5b6; color:#758348; font-size:19rpx; white-space:nowrap; }
.delivery-warm-note,.delivery-disabled-note { display:flex; align-items:center; gap:16rpx; margin-top:20rpx; padding:22rpx 18rpx; border-radius:22rpx; background:#f8e5bf; color:#7e5732; font-family:"STKaiti","KaiTi",serif; font-size:25rpx; line-height:1.55; }.delivery-note-leaf { color:#849957; font-size:48rpx; }.delivery-notice-icon { display:flex; align-items:center; justify-content:center; width:48rpx; height:48rpx; flex-shrink:0; border-radius:50%; color:#fff5df; background:#e78242; font-size:38rpx; }.delivery-notice-title { display:block; font-family:"PingFang SC","Microsoft YaHei",sans-serif; font-weight:800; font-size:24rpx; }.delivery-notice-copy { display:block; margin-top:6rpx; color:#a28157; font-size:21rpx; }
.section-line { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }.section-line text:first-child { font-size:30rpx; font-weight:800; }.section-line text:last-child { color:#a27c4e; font-size:20rpx; }
.cart-row-wrap { margin-top:16rpx; padding:18rpx; border-radius:20rpx; background:#faebcb; }.cart-row { display:flex; align-items:center; gap:16rpx; }.cart-row__copy { flex:1; min-width:0; }.cart-row__title { display:flex; flex-wrap:wrap; align-items:center; gap:8rpx; }.cart-row__name { font-size:27rpx; font-weight:800; }.cart-total-badge { color:#a56a35; font-size:20rpx; }.cart-row__meta { display:block; margin-top:8rpx; color:#98744b; font-size:20rpx; }
.cart-row textarea { width:100%; height:64rpx; min-height:64rpx; margin-top:12rpx; padding:10rpx 12rpx; background:#fff2d8; border:1rpx solid #e7cfa6; border-radius:12rpx; font-size:21rpx; line-height:1.5; box-sizing:border-box; }.cart-stepper { display:flex; align-items:center; gap:10rpx; }.cart-stepper .ui-button { width:52rpx; min-height:52rpx !important; height:52rpx; border-radius:50%; background:#e9904b; color:#fff6df; padding:0; font-size:29rpx; }.cart-stepper .ui-button:first-child { color:#a36734; background:#f8ddb5; }.my-count { text-align:center; }.my-count text { display:block; font-size:25rpx; font-weight:800; }.my-count text:first-child { font-size:17rpx; color:#9b7f54; }.cart-stepper .is-disabled { opacity:.4; }
.selection-toggle { display:block; min-height:60rpx !important; padding:16rpx 0 0; color:#816c40; text-align:left; font-size:20rpx; }.selection-details { padding:12rpx; background:#e9ebcb; border-radius:12rpx; }.selection-detail-row { display:flex; justify-content:space-between; gap:12rpx; margin:8rpx 0; font-size:21rpx; overflow-wrap:anywhere; }.cart-order-remark { width:100%; height:118rpx; min-height:118rpx; padding:16rpx; box-sizing:border-box; border:2rpx solid #e7d4af; border-radius:16rpx; background:#fff3d9; font-size:23rpx; }.remark-section .cart-field { margin-top:0; }.booking-ended,.cart-warning,.cart-item-warning { display:block; padding-top:12rpx; font-size:22rpx; color:#bb623d; line-height:1.5; }.bottom-note { font-size:18rpx; color:#f4dfbb; }
@media (max-width: 340px) { .cart-page { padding-left:18rpx; padding-right:18rpx; }.checkout-section,.selected-section { padding:20rpx; }.time-content { gap:12rpx; }.time-value { font-size:42rpx; }.time-quote { font-size:20rpx; padding-left:12rpx; }.address-book { display:none; }.cart-row { align-items:flex-start; flex-direction:column; }.cart-stepper { align-self:flex-end; } }
@media (orientation: landscape) { .cart-page { max-width:600px; } }
