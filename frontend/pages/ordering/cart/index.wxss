.cart-page{min-height:100vh;padding:28rpx 24rpx 180rpx;background:var(--sk-bg);box-sizing:border-box}.cart-head{padding:28rpx;border:2rpx solid var(--sk-ink);border-radius:32rpx 13rpx 32rpx 13rpx;background:var(--sk-wheat)}.cart-head__kicker,.cart-head__title,.cart-head__note{display:block}.cart-head__kicker{color:var(--sk-ink);font-size:20rpx;font-weight:900;letter-spacing:2rpx}.cart-head__title{margin-top:9rpx;color:var(--sk-text);font-family:"STSong","Songti SC",serif;font-size:45rpx;font-weight:900}.cart-head__note{margin-top:9rpx;color:var(--sk-muted);font-size:22rpx}.cart-meals{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:20rpx}.cart-meal{min-height:80rpx;margin:0;padding:11rpx 8rpx;border:2rpx solid var(--sk-line);border-radius:18rpx 7rpx 18rpx 7rpx;background:var(--sk-paper)}.cart-meal::after,.delivery-option::after,.cart-stepper .ui-button::after{border:0}.cart-meal text{display:block;color:var(--sk-muted);font-size:19rpx}.cart-meal text:first-child{color:var(--sk-text);font-size:25rpx;font-weight:900}.cart-meal.active{border-color:var(--sk-ink);background:var(--sk-sprout)}.checkout-section,.selected-section{margin-top:34rpx;padding:26rpx;border:2rpx solid var(--sk-line-soft);border-radius:28rpx 11rpx 28rpx 11rpx;background:var(--sk-paper);box-shadow:var(--sk-shadow-soft)}.section-line,.owner-group__head{display:flex;align-items:center;justify-content:space-between}.section-line text:first-child{color:var(--sk-text);font-size:30rpx;font-weight:900}.section-line text:last-child{color:var(--sk-muted);font-size:20rpx}.delivery-row{display:flex;gap:11rpx;margin-top:18rpx}.delivery-option{min-width:144rpx;min-height:72rpx;margin:0;padding:0 20rpx;border:2rpx solid var(--sk-line);border-radius:18rpx 7rpx 18rpx 7rpx;background:var(--sk-paper);color:var(--sk-ink)}.delivery-option.active{background:var(--sk-ink);color:#fff}.cart-field{display:block;margin-top:22rpx}.cart-field>text{display:block;margin-bottom:8rpx;color:var(--sk-ink);font-size:21rpx;font-weight:900}.picker-text,.cart-field textarea{width:100%;min-height:80rpx;padding:17rpx 19rpx;border:2rpx solid var(--sk-line);border-radius:18rpx 7rpx 18rpx 7rpx;background:#fffaf0;color:var(--sk-text);font-size:24rpx;box-sizing:border-box}.cart-field textarea{min-height:116rpx}.address-line{margin-top:13rpx;padding:17rpx;border-radius:18rpx 7rpx 18rpx 7rpx;background:var(--sk-sprout)}.address-line text{display:block;color:var(--sk-text);font-size:22rpx}.address-line text+text{margin-top:6rpx;color:var(--sk-muted)}.owner-group{margin-top:22rpx}.owner-group__head{padding-bottom:9rpx;color:var(--sk-ink);font-size:23rpx;font-weight:900}.cart-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:17rpx;padding:20rpx 0;border-bottom:2rpx solid var(--sk-line-soft)}.cart-row__name,.cart-row__meta{display:block}.cart-row__name{color:var(--sk-text);font-size:27rpx;font-weight:900}.cart-row__meta{margin-top:6rpx;color:var(--sk-muted);font-size:20rpx}.cart-row textarea{width:100%;min-height:70rpx;margin-top:9rpx;padding:11rpx;border:2rpx solid var(--sk-line);border-radius:14rpx;background:#fffaf0;box-sizing:border-box}.cart-stepper{display:flex;align-items:center;gap:9rpx}.cart-stepper .ui-button{width:62rpx;height:62rpx;margin:0;padding:0;border:2rpx solid var(--sk-line);border-radius:18rpx 7rpx 18rpx 7rpx;background:var(--sk-paper);color:var(--sk-ink);font-size:27rpx;line-height:62rpx}.cart-stepper text,.locked-count{color:var(--sk-text);font-size:25rpx;font-weight:900}.cart-warning{margin-top:18rpx;color:var(--sk-danger);font-size:22rpx}.bottom-note{display:block;margin-top:5rpx;color:var(--sk-muted);font-size:18rpx}


