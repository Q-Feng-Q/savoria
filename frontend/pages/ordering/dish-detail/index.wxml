<view class="warm-page warm-state-host page dish-page" wx:if="{{scene}}">
  <view class="detail-hero">
    <view class="detail-plate">
      <image class="detail-dish-image" src="{{scene.dish.imageUrl}}" mode="aspectFill" />
    </view>
    <view class="detail-copy">
      <text class="eyebrow">{{scene.dish.category}}</text>
      <text class="detail-title">{{scene.dish.name}}</text>
      <text class="detail-subtitle">{{scene.dish.description}}</text>
      <view class="tag-row">
        <block wx:for="{{scene.dish.tasteTags}}" wx:key="*this">
          <text class="tag">{{item}}</text>
        </block>
      </view>
    </view>
  </view>

  <view class="detail-meta">
    <view>
      <text class="meta-label">当前家庭价</text>
      <text class="meta-value">¥{{scene.dish.finalPrice}}</text>
    </view>
    <view>
      <text class="meta-label">商户基础价</text>
      <text class="meta-value">¥{{scene.dish.basePrice}}</text>
    </view>
  </view>

  <view class="panel explain-panel">
    <view class="detail-fact"><text class="detail-fact__label">当前家庭</text><text class="detail-fact__value">{{scene.dish.familyName}}</text></view>
    <view class="detail-fact"><text class="detail-fact__label">预计用餐</text><text class="detail-fact__value">{{scene.dish.mealLabel}}</text></view>
    <view class="detail-fact"><text class="detail-fact__label">餐篮数量</text><text class="detail-fact__value">全家共选 {{scene.dish.selectedCount}} 份 · 我选 {{scene.dish.myQuantity}} 份</text></view>
    <view class="detail-fact detail-fact--note"><text class="detail-fact__label">点菜说明</text><text class="detail-fact__value">菜品资料由商户维护，家庭成员的选择会合并到共享餐篮。</text></view>
  </view>

  <text class="section-title">主要食材</text>
  <view class="list">
    <block wx:for="{{scene.dish.ingredients}}" wx:key="id">
      <view class="panel ingredient-line">
        <text class="strong">{{item.name}}</text>
        <text class="quantity">{{item.quantity}}{{item.unit}}</text>
      </view>
    </block>
  </view>

  <block wx:if="{{false}}">
    <text class="section-title">商户制作流程</text>
    <view class="list">
      <block wx:for="{{scene.dish.cookingSteps}}" wx:key="title">
        <view class="panel step-line">
          <text class="step-index">{{index + 1}}</text>
          <view>
            <text class="strong">{{item.title}}</text>
            <text class="step-content">{{item.content}}</text>
          </view>
        </view>
      </block>
    </view>
  </block>

  <view class="detail-action-bar">
    <view>
      <text class="action-label">加入共享餐篮</text>
      <text class="action-sub">保留成员选择明细，提交后由家庭钱包统一冻结并扣款。</text>
    </view>
    <view class="ui-button button detail-submit {{mutationBusy ? 'is-disabled' : ''}}" bindtap="addDish" aria-role="button" aria-disabled="{{mutationBusy}}" aria-label="加入" hover-class="ui-button--pressed" hover-stay-time="80">{{mutationBusy ? '处理中' : '加入'}}</view>
  </view>
</view>

