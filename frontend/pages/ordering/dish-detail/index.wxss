.dish-page {
  padding-top: 0;
  padding-bottom: calc(174rpx + env(safe-area-inset-bottom));
}

.detail-hero {
  position: relative;
  overflow: hidden;
  min-height: 430rpx;
  margin: 0 -26rpx;
  padding: 0 30rpx 42rpx;
  display: flex;
  align-items: flex-end;
  border-radius: 0 0 42rpx 42rpx;
  background:
    linear-gradient(135deg, #ffe1ad 0%, #fff1d4 52%, #bfe7c8 100%);
}

.detail-hero::before {
  content: '';
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 0;
  height: 118rpx;
  border-radius: 34rpx 34rpx 0 0;
  background: rgba(255, 255, 250, 0.66);
}

.detail-plate {
  position: absolute;
  right: 42rpx;
  top: 150rpx;
  overflow: hidden;
  width: 180rpx;
  height: 180rpx;
  border-radius: 46rpx;
  background: #fffdf9;
  box-shadow: 0 22rpx 42rpx rgba(132, 95, 52, 0.16);
}

.detail-dish-image {
  display: block;
  width: 100%;
  height: 100%;
}

.detail-copy {
  position: relative;
  z-index: 1;
  width: 500rpx;
}

.detail-title {
  display: block;
  margin-top: 16rpx;
  color: #261c14;
  font-size: 60rpx;
  line-height: 1.02;
  font-weight: 950;
}

.detail-subtitle {
  display: block;
  margin-top: 18rpx;
  color: #806854;
  font-size: 26rpx;
  line-height: 1.45;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #218d68;
  font-size: 22rpx;
  font-weight: 850;
}

.detail-meta {
  display: block;
  margin: -34rpx 0 6rpx;
  position: relative;
  z-index: 2;
}

.detail-meta > view {
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fffdf9;
  border: 2rpx solid rgba(241, 223, 200, 0.72);
  box-shadow: 0 18rpx 38rpx rgba(132, 95, 52, 0.12);
}

.detail-price-card {
  width: 100%;
  box-sizing: border-box;
}

.meta-label,
.meta-value,
.detail-line {
  display: block;
}

.meta-label {
  color: #8f7865;
  font-size: 23rpx;
}

.meta-value {
  margin-top: 8rpx;
  color: #c97824;
  font-size: 34rpx;
  font-weight: 950;
}

.detail-section {
  margin-top: 38rpx;
}

.detail-section__head {
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--sk-line-soft);
}

.detail-section__heading,
.detail-section__intro {
  display: block;
}

.detail-section__heading {
  color: var(--sk-text);
  font-family: "STKaiti", "KaiTi", "Songti SC", serif;
  font-size: 34rpx;
  font-weight: 950;
}

.detail-section__intro {
  margin-top: 8rpx;
  color: var(--sk-muted);
  font-size: 21rpx;
  line-height: 1.55;
}

.detail-section__body {
  margin-top: 18rpx;
}

.explain-panel {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.detail-note {
  padding: 24rpx;
  color: var(--sk-muted);
  font-size: 24rpx;
  line-height: 1.8;
}

.detail-fact {
  display: grid;
  grid-template-columns: 128rpx minmax(0, 1fr);
  gap: 22rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--sk-line-soft);
}

.detail-fact:last-child {
  border-bottom: 0;
}

.detail-fact__label,
.detail-fact__value {
  display: block;
}

.detail-fact__label {
  color: var(--sk-ink);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.detail-fact__value {
  color: #806854;
  font-size: 24rpx;
  line-height: 1.72;
}

.detail-fact--note {
  margin-top: 4rpx;
}

.ingredient-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.strong {
  color: #261c14;
  font-size: 30rpx;
  font-weight: 950;
}

.quantity {
  color: #c97824;
  font-size: 28rpx;
  font-weight: 950;
}

.step-line {
  display: grid;
  grid-template-columns: 52rpx 1fr;
  gap: 18rpx;
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eafff5;
  color: #218d68;
  font-size: 24rpx;
  font-weight: 950;
}

.step-content {
  display: block;
  margin-top: 8rpx;
  color: #806854;
  font-size: 24rpx;
  line-height: 1.5;
}

.detail-action-bar {
  position: fixed;
  left: 50%;
  right: auto;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  width: calc(100% - 40rpx);
  max-width: 720px;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 18rpx 18rpx 24rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 252, 0.98);
  color: #261c14;
  box-shadow: 0 24rpx 56rpx rgba(62, 39, 23, 0.16);
  box-sizing: border-box;
  transform: translateX(-50%);
}

.detail-action-copy {
  min-width: 0;
}

.action-label,
.action-sub {
  display: block;
}

.action-label {
  color: #261c14;
  font-size: 28rpx;
  font-weight: 950;
}

.action-sub {
  margin-top: 6rpx;
  color: #8f7865;
  font-size: 22rpx;
}

.detail-submit {
  flex-shrink: 0;
  min-width: 150rpx;
}

/* 暖木绘本主题覆盖 */
.detail-hero{border-radius:0 0 44rpx 18rpx;background:linear-gradient(135deg,var(--sk-wheat) 0%,#fff1d4 52%,var(--sk-sprout) 100%)}
.detail-plate{border:3rpx solid var(--sk-ink);border-radius:44% 56% 45% 55%;background:var(--sk-paper)}
.detail-title,.strong,.action-label{color:var(--sk-text)}
.detail-subtitle,.detail-fact__value,.step-content,.action-sub{color:var(--sk-muted)}
.detail-meta>view{border-color:var(--sk-line-soft);border-radius:26rpx 10rpx 26rpx 10rpx;background:var(--sk-paper)}
.meta-value,.quantity{color:var(--sk-accent)}
.step-index{background:var(--sk-sprout);color:var(--sk-ink)}
.detail-action-bar{border:2rpx solid var(--sk-ink);border-radius:32rpx 13rpx 32rpx 13rpx;background:rgba(255,252,244,.98)}
@media(max-width:340px){.detail-fact{grid-template-columns:1fr;gap:8rpx;padding:18rpx 0}.detail-fact__value{line-height:1.65}.action-sub{max-width:360rpx;line-height:1.45}}

@import "../../../styles/storybook-subpages.wxss";

.story-subpage.dish-page { padding-top:22rpx; padding-bottom:calc(188rpx + env(safe-area-inset-bottom)); }
.dish-page .detail-hero { display:flex; flex-direction:column; align-items:stretch; min-height:0; margin:0; padding:0; border:2rpx solid #ecd4a6; border-radius:28rpx; background:#fff0d1; }
.dish-page .detail-hero::before { display:none; }
.dish-page .detail-plate { position:relative; top:auto; right:auto; width:100%; height:380rpx; border:0; border-radius:0; box-shadow:none; background:#f3dfb9; }
.dish-page .detail-copy { width:auto; padding:28rpx; }
.dish-page .detail-title { margin-top:10rpx; font-family:"KaiTi",serif; font-size:44rpx; line-height:1.35; }
.dish-page .detail-subtitle { font-size:25rpx; line-height:1.75; }
.dish-page .tag { background:#e4e8c8; color:#5d733c; font-size:21rpx; }
.dish-page .detail-meta { margin:18rpx 0 0; }
.dish-page .detail-meta > view { display:flex; justify-content:space-between; align-items:center; border:2rpx solid #ecd4a6; border-radius:22rpx; background:#f9e6bc; }
.dish-page .meta-value { margin:0; color:#c9642e; font-size:40rpx; }
.dish-page .detail-section { margin-top:32rpx; }
.dish-page .detail-section__head { padding:0 6rpx 16rpx; border:0; }
.dish-page .detail-section__heading { color:#526936; font-size:32rpx; }
.dish-page .detail-section__intro { color:#886b49; font-size:22rpx; }
.dish-page .detail-section__body { margin-top:0; }
.dish-page .ingredient-line { margin-bottom:12rpx; }
.dish-page .strong { font-size:26rpx; }
.dish-page .detail-action-bar { border:0; border-radius:26rpx; background:#513b29; }
.dish-page .action-label { color:#fff4d9; }
.dish-page .action-sub { color:#e3ceb0; font-size:20rpx; line-height:1.5; }
.dish-page .detail-submit { min-width:132rpx; background:#e47a3d; color:#fff8e7; }
