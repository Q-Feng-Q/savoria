<view class="warm-page warm-state-host orders-page" wx:if="{{context}}"><view class="orders-head orders-overview"><view><text>订单进度</text><text>{{context.family.name}}</text><text>{{context.member.name}}正在查看早餐、午餐和晚餐进度</text></view><view class="orders-overview__stamp"><text>{{orders.length}}</text><text>全部订单</text></view></view><view class="orders-list"><view class="orders-list__head"><text>最近订单</text><text>状态变化会及时通知</text></view><page-state wx:if="{{!orders.length}}" phase="empty" title="还没有订单" description="点好菜并提交后，进度会显示在这里" illustration="orders" /><order-row wx:for="{{orders}}" wx:key="id" order="{{item}}" bind:open="openOrderRow" /></view></view>
