.orders-page{min-height:100vh;padding:24rpx 24rpx 150rpx;background:var(--sk-bg);box-sizing:border-box}.orders-overview{display:flex;align-items:center;justify-content:space-between;gap:24rpx;padding:30rpx;border:2rpx solid var(--sk-ink);border-radius:34rpx 13rpx 34rpx 13rpx;background:var(--sk-sprout);box-shadow:var(--sk-shadow-soft)}.orders-head text{display:block}.orders-head view>text:first-child{color:var(--sk-ink);font-size:20rpx;font-weight:900;letter-spacing:2rpx}.orders-head view>text:nth-child(2){margin-top:8rpx;color:var(--sk-text);font-family:"STSong","Songti SC",serif;font-size:43rpx;font-weight:900}.orders-head view>text:last-child{margin-top:9rpx;color:var(--sk-muted);font-size:21rpx;line-height:1.45}.orders-overview__stamp{display:grid;place-items:center;flex:0 0 126rpx;width:126rpx;height:126rpx;border:3rpx solid var(--sk-ink);border-radius:48% 52% 45% 55%;background:var(--sk-wheat);transform:rotate(3deg)}.orders-overview__stamp text:first-child{color:var(--sk-accent);font-size:38rpx;font-weight:900}.orders-overview__stamp text:last-child{margin-top:-14rpx;color:var(--sk-ink);font-size:18rpx}.orders-list{margin-top:34rpx}.orders-list__head{display:flex;align-items:end;justify-content:space-between;margin-bottom:16rpx}.orders-list__head text:first-child{color:var(--sk-text);font-size:30rpx;font-weight:900}.orders-list__head text:last-child{color:var(--sk-muted);font-size:20rpx}

/* Responsive warm-animal overrides */
.orders-page{padding-bottom:calc(150rpx + env(safe-area-inset-bottom));background:transparent}
.orders-overview{display:grid;grid-template-columns:minmax(0,1fr) auto}
@media (max-width:360px){.orders-page{padding-left:18rpx;padding-right:18rpx}.orders-overview{gap:12rpx;padding:22rpx}.orders-head view>text:nth-child(2){font-size:36rpx}.orders-overview__stamp{flex-basis:auto;width:102rpx;height:102rpx}.orders-overview__stamp text:first-child{font-size:32rpx}.orders-list__head{align-items:flex-start;flex-direction:column;gap:4rpx}}
