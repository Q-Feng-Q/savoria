@import "../../../styles/approved-storybook.wxss";
.orders-metric-icon { padding:9rpx; }
.orders-page .orders-family { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:1; overflow:hidden; }
.orders-page { min-height:100vh; padding:12rpx 24rpx 12rpx; background:#fff3d7; box-sizing:border-box; }
.orders-shell { width:100%; }.orders-banner { position:relative; height:280rpx; border-radius:30rpx 30rpx 0 0; overflow:hidden; background:#a5b67a; }.orders-banner-copy { position:relative; width:65%; padding:30rpx; }.orders-family { display:block; font-size:56rpx; font-weight:900; color:#fffbe9; line-height:1.3; }.orders-motto { display:block; margin-top:14rpx; color:#fff6dc; font-size:25rpx; font-family:"STKaiti","KaiTi",serif; letter-spacing:3rpx; }
.orders-overview__sheet { position:relative; margin-top:-86rpx; padding:26rpx 22rpx 20rpx; }
.orders-count-row { display:flex; align-items:center; gap:32rpx; padding:0 8rpx 22rpx; }.orders-count-caption { display:block; font-size:22rpx; color:#80623e; }.orders-count-number { font-size:58rpx; line-height:1.25; font-weight:800; }.orders-count-unit { font-size:23rpx; margin-left:12rpx; }.orders-count-quote { border-left:2rpx solid #ead7b0; padding-left:28rpx; font-family:"STKaiti","KaiTi",serif; font-size:24rpx; line-height:1.6; color:#99794e; white-space:pre-line; transform:rotate(-5deg); }
.orders-overview__metrics { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12rpx; }.orders-metric { display:flex; align-items:center; justify-content:center; gap:12rpx; padding:20rpx 8rpx; border-radius:20rpx; background:#fbe9c9; }.orders-metric--making { background:#ecebc9; }.orders-metric--done { background:#e5e9c7; }.orders-metric-icon { display:flex; align-items:center; justify-content:center; width:52rpx; height:52rpx; border-radius:50%; color:#fff7df; background:#ef8c3d; font-size:38rpx; }.orders-metric--making .orders-metric-icon { background:#dc843f; }.orders-metric--done .orders-metric-icon { background:#859f60; }.orders-metric__value { display:block; font-size:38rpx; line-height:1; font-weight:800; }.orders-metric__label { display:block; margin-top:8rpx; font-size:22rpx; }
.orders-filter { display:flex; align-items:center; justify-content:space-between; margin:28rpx 6rpx 20rpx; gap:12rpx; }.orders-filter-picker { width:auto; min-height:0; padding:0; border:0; background:transparent; }.orders-filter-value { border:2rpx solid #e6d1a8; padding:8rpx 20rpx; border-radius:40rpx; background:#fff3d9; color:#8d6941; font-size:22rpx; }
.orders-list-scroll { min-width:0; }.orders-page .story-footer { margin-top:18rpx; }
@media(max-width:360px) { .orders-page { padding-left:18rpx; padding-right:18rpx; }.orders-family { font-size:50rpx; }.orders-metric { gap:8rpx; }.orders-metric__label { font-size:21rpx; } }
@media(max-height:620px) { .orders-banner { height:246rpx; }.orders-overview__sheet { margin-top:-62rpx; } }
@media(orientation:landscape) { .orders-page { max-width:600px; } }
