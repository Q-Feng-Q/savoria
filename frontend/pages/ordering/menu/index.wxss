.menu-page{height:100vh;min-height:0;display:flex;flex-direction:column;padding:42rpx 22rpx calc(28rpx + env(safe-area-inset-bottom));overflow:hidden;background:#fff6e8;box-sizing:border-box}.design-menu-header{display:grid;grid-template-columns:minmax(0,1fr) 210rpx;align-items:center;gap:18rpx}.design-menu-header__eyebrow,.design-menu-header__title,.design-menu-header__context{display:block}.design-menu-header__eyebrow{color:#9b5e43;font-size:19rpx;font-weight:900;letter-spacing:2rpx}.design-menu-header__title{margin-top:10rpx;color:#3f2a21;font-family:"STKaiti","KaiTi","Songti SC",serif;font-size:58rpx;line-height:1.08;font-weight:900}.design-menu-header__context{margin-top:8rpx;color:#8f705f;font-size:21rpx}.design-menu-header__art{position:relative;width:202rpx;height:142rpx;overflow:hidden;border-radius:46% 54% 42% 58%;background:#f4dba9}.design-menu-header__image{width:100%;height:100%}.animal-menu-art__label{position:absolute;right:8rpx;bottom:8rpx;padding:6rpx 10rpx;border-radius:999rpx;background:rgba(255,250,241,.92);color:#714a37;font-size:15rpx;font-weight:900}
.design-menu-search{display:flex;align-items:center;gap:10rpx;min-height:76rpx;margin-top:26rpx;padding:0 18rpx;border:2rpx solid #eadbc8;border-radius:28rpx;background:rgba(255,253,248,.95)}.design-menu-search__icon{color:#9a7d6b;font-size:32rpx}.menu-search{flex:1;min-width:0;height:72rpx;padding:0;border:0;background:transparent;color:#412f27;font-size:23rpx}.clear-search{min-height:62rpx;margin:0;padding:0 12rpx;border:0;background:transparent;color:#ed7657;font-size:20rpx}.clear-search::after{border:0}
.menu-reservation{display:flex;align-items:center;justify-content:space-between;gap:18rpx;min-height:88rpx;margin-top:24rpx;padding:16rpx 20rpx;border:2rpx solid #bed3be;border-radius:24rpx 10rpx 24rpx 10rpx;background:#dce9dc;box-sizing:border-box}.menu-reservation__label,.menu-reservation__value{display:block}.menu-reservation__label{color:#55735b;font-size:19rpx;font-weight:900;letter-spacing:1rpx}.menu-reservation__value{margin-top:5rpx;color:#3f2c24;font-size:25rpx;font-weight:900}.menu-reservation__action{flex-shrink:0;color:#9b5e43;font-size:20rpx;font-weight:800}.menu-reservation--pressed{opacity:.82}
.menu-category-layout{display:grid;grid-template-columns:126rpx minmax(0,1fr);flex:1;min-height:0;gap:22rpx;margin-top:26rpx}.category-rail,.dish-list-scroll{height:100%;min-height:0}.category-rail{border-right:2rpx solid #e2cfb8}.category-item{display:flex;align-items:center;justify-content:flex-start;width:100%;min-height:86rpx;margin:0;padding:0 12rpx;border:0;border-radius:0;background:transparent;color:#8c705e;font-size:22rpx;text-align:left}.category-item::after{border:0}.category-item.active{position:relative;background:#f1d49c;color:#4d3228;font-weight:900}.category-item.active::before{content:'';position:absolute;left:0;top:0;bottom:0;width:5rpx;background:#ed7657}.dish-list{min-width:0}.dish-list__head{display:flex;align-items:flex-end;justify-content:space-between;gap:12rpx;padding:0 0 14rpx}.dish-list__head text:first-child{color:#402d25;font-family:"STKaiti","KaiTi","Songti SC",serif;font-size:34rpx;font-weight:900}.dish-list__head text:last-child{color:#9a7e6d;font-size:18rpx}.menu-dish-entry{min-width:0}.menu-featured-tag{display:inline-flex;margin:4rpx 0 8rpx;padding:6rpx 14rpx;border-radius:999rpx;background:#f3d49d;color:#704633;font-size:18rpx;font-weight:900}
@media(max-width:360px){.menu-page{padding:32rpx 16rpx calc(24rpx + env(safe-area-inset-bottom))}.design-menu-header{grid-template-columns:minmax(0,1fr) 150rpx}.design-menu-header__title{font-size:48rpx}.design-menu-header__art{width:148rpx;height:112rpx}.menu-reservation{padding-left:16rpx;padding-right:16rpx}.menu-reservation__value{font-size:22rpx}.menu-reservation__action{font-size:18rpx}.menu-category-layout{grid-template-columns:100rpx minmax(0,1fr);gap:12rpx}.category-item{padding:0 8rpx;font-size:19rpx}.dish-list__head{align-items:flex-start;flex-direction:column}}




@media(max-height:620px){.menu-page{padding-top:18rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom))}.design-menu-header{grid-template-columns:minmax(0,1fr) 138rpx}.design-menu-header__title{margin-top:4rpx;font-size:42rpx}.design-menu-header__context{margin-top:4rpx}.design-menu-header__art{width:136rpx;height:92rpx}.menu-reservation{min-height:72rpx;margin-top:12rpx;padding-top:10rpx;padding-bottom:10rpx}.design-menu-search{min-height:66rpx;margin-top:12rpx}.menu-search{height:62rpx}.menu-category-layout{margin-top:14rpx}}
@media(orientation:landscape){.menu-page{padding-top:12rpx;padding-bottom:calc(18rpx + env(safe-area-inset-bottom))}.design-menu-header{grid-template-columns:minmax(0,1fr) 120rpx}.design-menu-header__title{margin-top:2rpx;font-size:38rpx}.design-menu-header__art{width:118rpx;height:78rpx}.menu-reservation{min-height:66rpx;margin-top:10rpx}.design-menu-search{min-height:62rpx;margin-top:10rpx}.menu-search{height:58rpx}.menu-category-layout{margin-top:10rpx}}

@import "../../../styles/approved-storybook.wxss";

/* Keep the viewport shell and both independent scrolling regions intact. */
.menu-page.story-page { padding:0 20rpx 16rpx; background:#fff3d7; }
.menu-page .design-menu-header { position:relative; display:block; flex-shrink:0; min-height:190rpx; margin:0 -20rpx; padding:26rpx 24rpx 18rpx; box-sizing:border-box; }
.design-menu-header__copy { position:relative; width:54%; }
.menu-page .design-menu-header__title { margin-top:10rpx; color:#51331f; font-size:48rpx; line-height:1.2; }
.menu-page .design-menu-header__eyebrow { color:#856142; font-size:18rpx; letter-spacing:0; }
.menu-page .design-menu-header__context { color:#806746; font-size:21rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.menu-page .menu-reservation { flex-shrink:0; min-height:74rpx; margin-top:10rpx; padding:12rpx 20rpx; border:2rpx solid #d4ddb0; border-radius:22rpx; background:#e6e9c9; }
.menu-page .menu-reservation__label { color:#647b3e; }
.menu-page .menu-reservation__value { font-size:23rpx; color:#51331f; }
.menu-page .menu-reservation__action { color:#6d7c49; font-size:20rpx; }
.menu-page .design-menu-search { flex-shrink:0; min-height:66rpx; margin-top:14rpx; border-color:#e7cfa3; border-radius:999rpx; background:#fff5df; }
.menu-page .menu-search { height:64rpx; }
.menu-page .menu-category-layout { grid-template-columns:124rpx minmax(0,1fr); gap:14rpx; margin-top:18rpx; }
.menu-page .category-rail { border:0; background:#f5e7c8; border-radius:20rpx; }
.menu-page .category-item { min-height:88rpx; padding:12rpx; color:#806746; font-size:23rpx; line-height:1.5; }
.menu-page .category-item.active { background:#dce4bb; color:#4f6434; border-radius:16rpx; }
.menu-page .category-item.active::before { top:20rpx; bottom:20rpx; border-radius:5rpx; background:#718744; }
.menu-page .dish-list__head { padding:4rpx 2rpx 16rpx; }
.menu-page .dish-list__head text:first-child { color:#51331f; font-size:29rpx; }
.menu-category-section__head { display:flex; justify-content:space-between; gap:12rpx; padding:18rpx 4rpx 12rpx; color:#647b3e; font-size:25rpx; font-weight:800; }
.menu-category-section__head text:last-child { color:#98784c; font-size:20rpx; font-weight:400; }
.menu-type-filter { flex-shrink:0; align-self:flex-start; margin:0 0 12rpx; padding:10rpx 20rpx; border:1rpx solid #dfcca6; border-radius:22rpx; background:#f5e7c8; color:#604829; font-size:24rpx; }
.menu-page .menu-dish-entry { position:relative; margin-bottom:16rpx; padding:10rpx 14rpx; border:2rpx solid #eddbb5; border-radius:22rpx; background:linear-gradient(110deg,#fff6e2,#fff0d2); box-shadow:0 5rpx 14rpx rgba(151,108,41,.06); }
.menu-page .menu-featured-tag { margin:4rpx 0 0; padding:5rpx 12rpx; background:#fbe0b4; color:#9b4d26; font-size:18rpx; }
@media(max-width:360px) { .menu-page.story-page { padding-left:14rpx; padding-right:14rpx; } .menu-page .menu-category-layout { grid-template-columns:104rpx minmax(0,1fr); gap:10rpx; } .menu-page .menu-dish-entry { padding:8rpx 10rpx; } .menu-page .category-item { font-size:21rpx; padding:10rpx; } }
@media(max-height:620px) { .menu-page .design-menu-header { min-height:130rpx; padding-top:12rpx; padding-bottom:10rpx; } .menu-page .design-menu-header__title { font-size:38rpx; margin-top:4rpx; } .menu-page .menu-reservation { min-height:60rpx; padding-top:8rpx; padding-bottom:8rpx; } }
