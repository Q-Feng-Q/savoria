.menu-page{min-height:100vh;padding:42rpx 22rpx calc(180rpx + env(safe-area-inset-bottom));overflow-x:hidden;background:#fff6e8;box-sizing:border-box}.design-menu-header{display:grid;grid-template-columns:minmax(0,1fr) 210rpx;align-items:center;gap:18rpx}.design-menu-header__eyebrow,.design-menu-header__title,.design-menu-header__context{display:block}.design-menu-header__eyebrow{color:#9b5e43;font-size:19rpx;font-weight:900;letter-spacing:2rpx}.design-menu-header__title{margin-top:10rpx;color:#3f2a21;font-family:"STKaiti","KaiTi","Songti SC",serif;font-size:58rpx;line-height:1.08;font-weight:900}.design-menu-header__context{margin-top:8rpx;color:#8f705f;font-size:21rpx}.design-menu-header__art{position:relative;width:202rpx;height:142rpx;overflow:hidden;border-radius:46% 54% 42% 58%;background:#f4dba9}.design-menu-header__image{width:100%;height:100%}.animal-menu-art__label{position:absolute;right:8rpx;bottom:8rpx;padding:6rpx 10rpx;border-radius:999rpx;background:rgba(255,250,241,.92);color:#714a37;font-size:15rpx;font-weight:900}
.design-menu-search{display:flex;align-items:center;gap:10rpx;min-height:76rpx;margin-top:26rpx;padding:0 18rpx;border:2rpx solid #eadbc8;border-radius:28rpx;background:rgba(255,253,248,.95)}.design-menu-search__icon{color:#9a7d6b;font-size:32rpx}.menu-search{flex:1;min-width:0;height:72rpx;padding:0;border:0;background:transparent;color:#412f27;font-size:23rpx}.clear-search{min-height:62rpx;margin:0;padding:0 12rpx;border:0;background:transparent;color:#ed7657;font-size:20rpx}.clear-search::after{border:0}
.meal-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin-top:20rpx}.meal-tab{min-height:94rpx;margin:0;padding:13rpx 8rpx;border:2rpx solid #d8c4ac;border-radius:24rpx;background:#fffdf8;color:#8b6e5c}.meal-tab::after{border:0}.meal-tab text{display:block;font-size:18rpx}.meal-tab text:first-child{color:#3f2c24;font-size:27rpx;font-weight:900}.meal-tab.active{border-color:#719379;background:#dce9dc;color:#55735b}
.menu-category-layout{display:grid;grid-template-columns:126rpx minmax(0,1fr);gap:22rpx;margin-top:26rpx}.category-rail{height:830rpx;border-right:2rpx solid #e2cfb8}.category-item{display:flex;align-items:center;justify-content:flex-start;width:100%;min-height:86rpx;margin:0;padding:0 12rpx;border:0;border-radius:0;background:transparent;color:#8c705e;font-size:22rpx;text-align:left}.category-item::after{border:0}.category-item.active{position:relative;background:#f1d49c;color:#4d3228;font-weight:900}.category-item.active::before{content:'';position:absolute;left:0;top:0;bottom:0;width:5rpx;background:#ed7657}.dish-list{min-width:0}.dish-list__head{display:flex;align-items:flex-end;justify-content:space-between;gap:12rpx;padding:0 0 14rpx}.dish-list__head text:first-child{color:#402d25;font-family:"STKaiti","KaiTi","Songti SC",serif;font-size:34rpx;font-weight:900}.dish-list__head text:last-child{color:#9a7e6d;font-size:18rpx}.orders-link{min-width:88rpx;min-height:70rpx;margin:0;padding:0 12rpx;border:0;background:transparent;color:#fff;font-size:21rpx;font-weight:900}.orders-link::after{border:0}
@media(max-width:360px){.menu-page{padding:32rpx 16rpx calc(176rpx + env(safe-area-inset-bottom))}.design-menu-header{grid-template-columns:minmax(0,1fr) 150rpx}.design-menu-header__title{font-size:48rpx}.design-menu-header__art{width:148rpx;height:112rpx}.menu-category-layout{grid-template-columns:100rpx minmax(0,1fr);gap:12rpx}.category-item{padding:0 8rpx;font-size:19rpx}.meal-tabs{gap:7rpx}.meal-tab{min-height:84rpx}.meal-tab text:first-child{font-size:23rpx}.dish-list__head{align-items:flex-start;flex-direction:column}}
