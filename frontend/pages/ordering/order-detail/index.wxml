<view class="warm-page warm-state-host order-detail" wx:if="{{scene}}">
  <view class="detail-head"><text class="detail-head__status">{{scene.order.statusLabel}}</text><text class="detail-head__title">{{scene.order.familyName}}</text><text class="detail-head__note">预计 {{scene.order.mealLabel}} · {{scene.order.deliveryMode === 'delivery' ? '配送' : '自取'}}</text></view>
  <view class="detail-section"><view class="section-line"><text>当前进度</text><text>{{scene.order.orderNo}}</text></view><status-timeline items="{{scene.timeline}}" activeIndex="{{scene.timeline.length - 1}}" /></view>
  <view class="detail-section"><view class="section-line"><text>菜品汇总</text><text>{{scene.items.length}} 项</text></view>
    <view wx:for="{{scene.items}}" wx:key="id" class="detail-row-wrap">
      <view class="detail-row"><view><text>{{item.dishName}}</text><text>{{item.note || '无单品备注'}}</text></view><text>共 × {{item.quantity}} · ¥{{item.amount}}</text></view>
      <view wx:if="{{item.hasSelectionDetails}}" class="ui-button selection-toggle" data-id="{{item.id}}" bindtap="toggleSelectionDetails" aria-role="button" aria-label="查看点菜成员" hover-class="ui-button--pressed">{{expandedDishIds[item.id] ? '收起选择明细' : '查看谁选了这道菜'}}</view>
      <view wx:if="{{expandedDishIds[item.id]}}" class="selection-box"><view wx:for="{{item.selections}}" wx:key="memberId" class="selection-line"><text>{{item.memberName}} × {{item.quantity}}</text><text>{{item.itemRemark || '无备注'}}</text></view></view>
    </view>
  </view>
  <view class="detail-section"><view class="section-line"><text>订单信息</text><text>{{scene.order.submitterName}}提交</text></view><text class="detail-copy">本单备注：{{scene.order.note || '无'}}</text><text wx:if="{{scene.order.addressSnapshot}}" class="detail-copy">{{scene.order.addressSnapshot.contactName}} · {{scene.order.addressSnapshot.address}}</text></view>
  <bottom-action-bar wx:if="{{scene.canCancel}}" summary="{{scene.order.statusLabel}}" primaryText="取消订单" bind:primary="cancelOrder" />
</view>
