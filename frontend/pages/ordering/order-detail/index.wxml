<view class="warm-page warm-state-host order-detail" wx:if="{{scene}}"><view class="detail-head"><text class="detail-head__status">{{scene.order.statusLabel}}</text><text class="detail-head__title">{{scene.order.familyName}}</text><text class="detail-head__note">{{scene.order.serviceDate}} {{scene.order.mealLabel}} · {{scene.order.deliveryMode === 'delivery' ? '配送' : '自取'}}</text></view><view class="detail-section"><view class="section-line"><text>当前进度</text><text>{{scene.order.orderNo}}</text></view><status-timeline items="{{scene.timeline}}" activeIndex="{{scene.timeline.length - 1}}" /></view><view class="detail-section"><view class="section-line"><text>菜品归属</text><text>{{scene.items.length}} 项</text></view><view wx:for="{{scene.items}}" wx:key="id" class="detail-row"><view><text>{{item.dishName}}</text><text>点菜人：{{item.ownerName}}{{item.note ? ' · ' + item.note : ''}}</text></view><text>x{{item.quantity}} · ¥{{item.amount}}</text></view></view><view class="detail-section"><view class="section-line"><text>订单信息</text><text>{{scene.order.submitterName}}提交</text></view><text class="detail-copy">本单备注：{{scene.order.note || '无'}}</text><text wx:if="{{scene.order.addressSnapshot}}" class="detail-copy">{{scene.order.addressSnapshot.contactName}} · {{scene.order.addressSnapshot.address}}</text><view wx:if="{{scene.canCancel}}" class="order-sync-action" bindtap="updateOrder" aria-role="button" aria-label="按当前餐篮更新订单">按当前餐篮重新计算订单</view></view><bottom-action-bar wx:if="{{scene.canCancel}}" summary="{{scene.order.statusLabel}}" primaryText="取消订单" bind:primary="cancelOrder" /></view>
