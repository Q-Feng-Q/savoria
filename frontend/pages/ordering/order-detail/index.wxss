.order-detail{min-height:100vh;padding:26rpx 24rpx 170rpx;background:var(--sk-bg);box-sizing:border-box}.detail-head{padding:29rpx;border:2rpx solid var(--sk-ink);border-radius:32rpx 13rpx 32rpx 13rpx;background:var(--sk-sprout)}.detail-head__status,.detail-head__title,.detail-head__note,.detail-copy{display:block}.detail-head__status{color:var(--sk-accent);font-size:21rpx;font-weight:900}.detail-head__title{margin-top:9rpx;color:var(--sk-text);font-family:"STSong","Songti SC",serif;font-size:45rpx;font-weight:900}.detail-head__note{margin-top:9rpx;color:var(--sk-muted);font-size:22rpx}.detail-section{margin-top:24rpx;padding:26rpx;border:2rpx solid var(--sk-line-soft);border-radius:27rpx 11rpx 27rpx 11rpx;background:var(--sk-paper)}.section-line{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}.section-line text:first-child{color:var(--sk-text);font-size:29rpx;font-weight:900}.section-line text:last-child{color:var(--sk-muted);font-size:20rpx}.detail-row{display:flex;align-items:center;justify-content:space-between;gap:19rpx;padding:19rpx 0;border-bottom:2rpx solid var(--sk-line-soft)}.detail-row text{display:block;color:var(--sk-text);font-size:23rpx;font-weight:900}.detail-row view text+text{margin-top:6rpx;color:var(--sk-muted);font-size:20rpx;font-weight:400}.detail-copy{margin-top:11rpx;color:var(--sk-muted);font-size:22rpx;line-height:1.5}
.order-sync-action{display:flex;align-items:center;justify-content:center;min-height:72rpx;margin-top:22rpx;border:2rpx solid var(--sk-sage);border-radius:18rpx 7rpx 18rpx 7rpx;background:var(--sk-sprout);color:var(--sk-ink);font-size:22rpx;font-weight:900}
