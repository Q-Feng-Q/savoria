.notebook-contacts{min-height:100vh;padding:32rpx;background:#fff7e9;color:#51331f;box-sizing:border-box}.paper-head{display:flex;flex-direction:column;gap:10rpx;padding:30rpx 8rpx}.paper-kicker{font-size:19rpx;letter-spacing:3rpx;color:#789153}.paper-title{font-size:48rpx;font-family:KaiTi,serif;font-weight:800}.paper-sub,.paper-hint,.paper-muted{font-size:23rpx;color:#927c63}.paper-section{margin:20rpx 0;padding:28rpx;border-radius:22rpx;background:#fffdf7}.paper-label{display:block;font-size:28rpx;font-weight:800;margin-bottom:20rpx}.paper-section input{height:74rpx;padding:0 16rpx;border:2rpx solid #e9d8bb;border-radius:12rpx;margin:14rpx 0}.paper-button{padding:18rpx;background:#dd783d;color:white;border-radius:999rpx;text-align:center;font-weight:800}.paper-hint{display:block;margin-top:16rpx}.paper-token{overflow-wrap:anywhere;margin-top:14rpx;padding:14rpx;background:#e4edcf;border-radius:10rpx;font-size:22rpx}.paper-row{display:flex;flex-direction:column;gap:12rpx;padding:18rpx 0;border-bottom:2rpx solid #efe1c8;font-size:24rpx}.paper-actions{display:flex;gap:30rpx;color:#bd6333}.paper-danger{color:#b44536}.paper-state{padding:80rpx 20rpx;text-align:center}
