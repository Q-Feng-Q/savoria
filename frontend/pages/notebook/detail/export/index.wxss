.export-page{min-height:100vh;padding:32rpx;background:#fff7e9;color:#51331f;box-sizing:border-box}.export-head{display:flex;flex-direction:column;gap:10rpx;padding:30rpx 6rpx}.export-kicker{font-size:19rpx;letter-spacing:3rpx;color:#789153}.export-title{font-size:48rpx;font-family:KaiTi,serif;font-weight:800}.export-hint{font-size:22rpx;color:#917a61;line-height:1.6}.export-sheet{padding:30rpx;background:#fffdf7;border-radius:22rpx;margin:24rpx 0}.export-label{display:block;font-weight:800;font-size:27rpx;margin-bottom:20rpx}.export-dates{display:flex;gap:14rpx;margin-bottom:20rpx}.export-dates>picker{flex:1;padding:18rpx;border:2rpx solid #e9d8bb;border-radius:12rpx;font-size:22rpx}.export-count{margin-top:26rpx;font-size:26rpx;font-weight:800}.export-warning{padding:25rpx;background:#f5e2c5;border-radius:14rpx;font-size:23rpx;line-height:1.6;color:#8c5538}.export-actions{display:flex;flex-direction:column;gap:16rpx;margin-top:26rpx}.export-actions>view{padding:22rpx;border-radius:999rpx;text-align:center;font-size:25rpx;font-weight:800}.export-copy{background:#df7739;color:white}.export-file{background:#e0e9ca;color:#50693a}.export-error{color:#b44737;font-size:22rpx}
