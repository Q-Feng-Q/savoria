.nb-page{min-height:100vh;padding:42rpx 30rpx calc(160rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff7e9;color:#51331f}.nb-kicker{font-size:21rpx;color:#806746;letter-spacing:2rpx}.nb-title{margin:15rpx 0;font-family:"STKaiti","KaiTi",serif;font-size:60rpx;font-weight:800}.nb-description{font-size:25rpx;color:#816b55;line-height:1.7}.nb-actions{display:flex;gap:22rpx;margin:35rpx 0;font-size:23rpx;color:#5f7950}.nb-actions>view{padding:15rpx 20rpx;border:2rpx solid #c8d2b3;border-radius:10rpx}.nb-section{margin-top:50rpx;padding-bottom:15rpx;border-bottom:2rpx solid #d9c09d;font-size:30rpx;font-weight:700}.nb-version{padding:24rpx 0;border-bottom:2rpx solid #ead8ba;font-size:27rpx}.nb-meta{margin-top:8rpx;color:#9a8267;font-size:20rpx}.nb-note{margin-top:35rpx;color:#8e795e;font-size:23rpx;line-height:1.6}.nb-empty{padding:100rpx;color:#9a8267;text-align:center}.nb-bottom{position:fixed;left:30rpx;right:30rpx;bottom:calc(30rpx + env(safe-area-inset-bottom));padding:22rpx;border-radius:18rpx;background:#df7739;color:#fff;text-align:center;font-size:28rpx;font-weight:700}@media(max-width:360px){.nb-page{padding-left:20rpx;padding-right:20rpx}}
.nb-dates{display:flex;gap:15rpx;margin:20rpx 0;font-size:23rpx}.nb-dates picker{flex:1;padding:20rpx;border:2rpx solid #dcc4a0;border-radius:12rpx}.nb-record{display:flex;justify-content:space-between;gap:16rpx;padding:22rpx 0;border-bottom:2rpx solid #ead8ba;font-size:24rpx}.nb-record text:last-child{color:#967b62;font-size:19rpx}.nb-more,.nb-export{margin:22rpx 0;padding:18rpx;color:#5f7950;text-align:center}.nb-export{border:2rpx solid #c8d2b3;border-radius:12rpx}
.nb-template-field{padding:8rpx 0;color:#806b56;font-size:21rpx}
.nb-history-calendar{padding:20rpx 0;color:#5f7950;font-size:23rpx}
