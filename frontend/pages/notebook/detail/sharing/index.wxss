.sharing-page{min-height:100vh;padding:32rpx;background:#fff7e9;color:#51331f;box-sizing:border-box}.sharing-head{display:flex;flex-direction:column;gap:12rpx;padding:30rpx 6rpx}.sharing-kicker{font-size:19rpx;letter-spacing:3rpx;color:#789153}.sharing-title{font-size:48rpx;font-family:KaiTi,serif;font-weight:800}.sharing-note,.sharing-muted{font-size:22rpx;color:#917a61;line-height:1.6}.sharing-sheet{padding:28rpx;margin:20rpx 0;background:#fffdf7;border-radius:22rpx}.sharing-label{display:block;font-size:26rpx;font-weight:800;margin:24rpx 0 14rpx}.sharing-picker,.sharing-dates>picker{padding:20rpx;border:2rpx solid #ead6b6;border-radius:12rpx;font-size:23rpx}.sharing-dates{display:flex;gap:12rpx}.sharing-dates>picker{flex:1}.sharing-switch{display:flex;justify-content:space-between;align-items:center;min-height:88rpx;border-bottom:2rpx solid #f1e4d0;font-size:24rpx}.sharing-save{padding:20rpx;border-radius:999rpx;background:#df7739;color:white;text-align:center;font-weight:800;margin-top:28rpx}.sharing-cancel{text-align:center;color:#8c725b;margin-top:18rpx}.sharing-grant{display:flex;justify-content:space-between;gap:20rpx;padding:18rpx 0;border-bottom:2rpx solid #f1e4d0;font-size:22rpx}.sharing-grant>view:first-child{display:flex;flex-direction:column;gap:6rpx}.sharing-actions{display:flex;gap:20rpx;color:#c76331}.sharing-state{padding:80rpx 20rpx;text-align:center}
