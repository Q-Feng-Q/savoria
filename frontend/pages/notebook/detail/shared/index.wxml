<view class="shared-page warm-page">
  <view class="shared-head"><text class="shared-kicker">SHARED WITH ME</text><text class="shared-title">共享给我的记事</text><text class="shared-hint">仅展示当前有效授权范围内的完整记录。</text></view>
  <view wx:if="{{phase === 'loading'}}" class="shared-state">正在读取共享记事…</view>
  <view wx:elif="{{phase === 'error'}}" class="shared-state"><text>{{errorMessage}}</text><view bindtap="load">重试</view></view>
  <block wx:else><view wx:if="{{!grants.length}}" class="shared-state">暂无有效共享，或授权已到期、撤销。</view><block wx:else><scroll-view class="shared-grants" scroll-x><view wx:for="{{grants}}" wx:key="id" class="shared-chip {{item.id === selectedId ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectGrant">{{item.eventName || '共享事件'}}</view></scroll-view><view class="shared-scope"><text>授权记录范围 {{selected.dataFrom}} 至 {{selected.dataTo}}</text><text>有效至 {{selected.validTo}}</text></view><view class="shared-range"><picker mode="date" value="{{rangeFrom}}" data-field="rangeFrom" bindchange="changeRange"><view>从 {{rangeFrom}}</view></picker><picker mode="date" value="{{rangeTo}}" data-field="rangeTo" bindchange="changeRange"><view>到 {{rangeTo}}</view></picker></view><view class="shared-scope">单次最多 {{maxQueryMonths}} 个日历月，可选择更早的授权日期。</view><view wx:if="{{rangeError}}" class="shared-state">{{rangeError}}</view><view class="shared-actions"><view wx:if="{{selected.capabilities.create}}" bindtap="createRecord">新增记录</view><view wx:if="{{selected.capabilities.export}}" bindtap="exportSelected">复制 / 导出</view></view><view wx:if="{{!records.length && !rangeError}}" class="shared-state">该范围暂无可查看记录</view><view wx:for="{{records}}" wx:key="id" class="shared-record" data-id="{{item.id}}" bindtap="openRecord"><view><text>{{item.title}}</text><text>{{item.displayRange}}</text></view><text>›</text></view><view wx:if="{{hasMore}}" class="shared-more" bindtap="loadMore">{{loadingMore ? '加载中…' : '加载更多'}}</view></block></block>
</view>
