.shared-page{min-height:100vh;padding:32rpx;background:#fff7e9;color:#51331f;box-sizing:border-box}.shared-head{display:flex;flex-direction:column;gap:10rpx;padding:30rpx 6rpx}.shared-kicker{font-size:19rpx;letter-spacing:3rpx;color:#789153}.shared-title{font-size:48rpx;font-family:KaiTi,serif;font-weight:800}.shared-hint{font-size:22rpx;color:#917a61}.shared-grants{white-space:nowrap;margin:25rpx 0}.shared-chip{display:inline-block;padding:14rpx 24rpx;margin-right:12rpx;border-radius:999rpx;background:#f2e5ca;font-size:23rpx}.shared-chip.selected{background:#dfe9c9;color:#4c6938;font-weight:800}.shared-scope{display:flex;flex-direction:column;gap:8rpx;padding:20rpx;background:#fffdf7;border-radius:14rpx;font-size:23rpx}.shared-actions{display:flex;gap:16rpx;margin:20rpx 0}.shared-actions>view{padding:14rpx 26rpx;border-radius:999rpx;background:#df7739;color:white;font-size:23rpx}.shared-record{display:flex;justify-content:space-between;align-items:center;padding:24rpx 12rpx;margin:12rpx 0;background:#fffdf7;border-radius:14rpx}.shared-record>view{display:flex;flex-direction:column;gap:8rpx;font-size:25rpx}.shared-record>view>text:last-child{font-size:20rpx;color:#927c63}.shared-state,.shared-more{padding:70rpx 16rpx;text-align:center;color:#927c63;font-size:24rpx}
.shared-range{display:flex;gap:15rpx;margin:20rpx 0}.shared-range picker{flex:1;padding:17rpx;border:2rpx solid #e5d3b4;border-radius:12rpx;background:#fffdf7;font-size:22rpx}
