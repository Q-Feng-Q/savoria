<view class="nb-page warm-page">
  <view class="nb-kicker">私人空间 · {{editing ? '编辑事件' : '新建事件'}}</view><view class="nb-title">{{editing ? '整理这件事' : '从一件事开始'}}</view>
  <view wx:if="{{phase === 'loading'}}" class="nb-empty">正在加载…</view>
  <view wx:elif="{{phase === 'error'}}" class="nb-empty" bindtap="load">{{errorMessage}} · 点击重试</view>
  <block wx:else>
    <view wx:if="{{!editing}}" class="nb-preset-trigger" bindtap="openPresetPicker"><view><text class="nb-preset-trigger-title">从模板开始</text><text class="nb-preset-trigger-hint">{{presetCount}} 个常用模板，也可以从空白创建</text></view><text class="nb-preset-trigger-action">导入模板 ›</text></view>
    <view wx:if="{{!editing && showPresetPicker}}" class="nb-preset-panel">
      <view class="nb-preset-heading"><text>选择一个模板</text><text class="nb-preset-close" bindtap="closePresetPicker">关闭 ×</text></view>
      <scroll-view scroll-x class="nb-preset-categories"><view class="nb-preset-category-row"><view wx:for="{{presetCategories}}" wx:key="*this" class="nb-preset-category {{presetCategory === item ? 'is-active' : ''}}" data-category="{{item}}" bindtap="choosePresetCategory">{{item}}</view></view></scroll-view>
      <scroll-view scroll-y class="nb-preset-list"><view wx:for="{{visiblePresets}}" wx:key="id" class="nb-preset-row {{selectedPreset && selectedPreset.id === item.id ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="selectPreset"><view class="nb-preset-row-title">{{item.name}}<text>{{item.fields.length}} 个字段</text></view><view class="nb-preset-row-desc">{{item.description}}</view></view></scroll-view>
      <view wx:if="{{selectedPreset}}" class="nb-preset-preview"><view class="nb-preset-preview-title">{{selectedPreset.name}} · 字段预览</view><view wx:for="{{selectedPresetFields}}" wx:key="label" class="nb-preset-preview-field"><view class="nb-preset-preview-row"><text>{{item.label}}</text><text>{{item.typeLabel}}{{item.unit ? ' · ' + item.unit : ''}}</text></view><view wx:if="{{item.optionsText}}" class="nb-preset-preview-options">选项：{{item.optionsText}}</view></view><view class="nb-preset-import" bindtap="importPreset">导入并继续编辑</view></view>
    </view>
    <view class="nb-label">事件名称</view><input class="nb-input" maxlength="120" value="{{name}}" data-key="name" bindinput="onText" placeholder="例如：旅行、读书、宝宝成长"/>
    <view class="nb-label">分类</view><input class="nb-input" maxlength="80" value="{{category}}" data-key="category" bindinput="onText" placeholder="选填"/>
    <view class="nb-label">说明</view><textarea class="nb-input nb-area" maxlength="5000" value="{{description}}" data-key="description" bindinput="onText" placeholder="这件事有什么特别？"/>
    <view class="nb-section"><text>记录字段</text><text class="nb-add" bindtap="addField">＋ 添加字段</text></view>
    <view wx:for="{{fields}}" wx:key="index" class="nb-field">
      <view class="nb-field-head"><text>字段 {{index + 1}}</text><view class="nb-field-move"><text data-index="{{index}}" data-direction="-1" bindtap="moveField">上移</text><text data-index="{{index}}" data-direction="1" bindtap="moveField">下移</text><text class="nb-remove" data-index="{{index}}" bindtap="removeField">移除</text></view></view>
      <input class="nb-input" value="{{item.label}}" data-index="{{index}}" data-key="label" bindinput="fieldInput" placeholder="字段名称"/>
      <picker range="{{typeLabels}}" value="{{item.typeIndex}}" data-index="{{index}}" bindchange="fieldType"><view class="nb-input">{{typeLabels[item.typeIndex]}}　⌄</view></picker>
      <view class="nb-required"><text>必填</text><switch checked="{{item.required}}" color="#779155" data-index="{{index}}" bindchange="fieldRequired"/></view>
      <input wx:if="{{item.type === 'SINGLE_SELECT' || item.type === 'MULTI_SELECT'}}" class="nb-input" value="{{item.optionsText}}" data-index="{{index}}" data-key="optionsText" bindinput="fieldInput" placeholder="用逗号分隔选项"/>
      <input wx:if="{{item.type === 'NUMBER'}}" class="nb-input" value="{{item.unit}}" data-index="{{index}}" data-key="unit" bindinput="fieldInput" placeholder="单位（可选）"/>
    </view>
    <view class="nb-section">新记录表单预览</view>
    <view wx:if="{{!fields.length}}" class="nb-note">无自定义字段，记录仍可填写标题与备注。</view>
    <view wx:for="{{fields}}" wx:key="index" class="nb-preview"><text>{{item.label || '未命名字段'}}{{item.required ? ' *' : ''}}</text><text>{{typeLabels[item.typeIndex]}}{{item.unit ? ' · ' + item.unit : ''}}</text></view>
    <view class="nb-note">调整字段会发布新版本；已有记录保留原来的字段定义。</view>
  </block>
  <view class="nb-bottom" bindtap="save">{{busy ? '保存中…' : '保存事件'}}</view>
</view>
