.nb-page{min-height:100vh;padding:38rpx 30rpx calc(160rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff7e9;color:#51331f}.nb-kicker{font-size:21rpx;color:#806746;letter-spacing:2rpx}.nb-title{margin:12rpx 0 38rpx;font-family:"STKaiti","KaiTi",serif;font-size:54rpx;font-weight:800}.nb-label{margin:26rpx 0 11rpx;font-size:24rpx;font-weight:700}.nb-input{box-sizing:border-box;width:100%;min-height:80rpx;padding:19rpx 20rpx;border:2rpx solid #e5d3b4;border-radius:12rpx;background:#fffdf8;font-size:25rpx}.nb-area{height:170rpx}.nb-section{display:flex;justify-content:space-between;align-items:center;margin:46rpx 0 15rpx;padding-bottom:15rpx;border-bottom:2rpx solid #ddc6a2;font-size:31rpx;font-weight:700}.nb-add{font-size:22rpx;color:#6b8152}.nb-field{padding:25rpx 0;border-bottom:2rpx solid #ead8ba}.nb-field>.nb-input,.nb-field>picker{margin-top:16rpx}.nb-field-head,.nb-required{display:flex;justify-content:space-between;align-items:center;font-size:24rpx}.nb-remove{color:#b84d3a}.nb-required{margin-top:18rpx;color:#715d47}.nb-note{margin:25rpx 0;color:#927e69;font-size:21rpx;line-height:1.6}.nb-empty{padding:100rpx;color:#9a8267;text-align:center}.nb-bottom{position:fixed;left:30rpx;right:30rpx;bottom:calc(30rpx + env(safe-area-inset-bottom));padding:22rpx;border-radius:18rpx;background:#df7739;color:#fff;text-align:center;font-size:28rpx;font-weight:700}@media(max-width:360px){.nb-page{padding-left:20rpx;padding-right:20rpx}}
.nb-field-move{display:flex;gap:16rpx;color:#6b8152;font-size:21rpx;font-weight:400}
.nb-preview{display:flex;justify-content:space-between;padding:17rpx 0;border-bottom:2rpx solid #ead8ba;font-size:23rpx}.nb-preview text:last-child{color:#927e69}
.nb-preset-trigger{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:26rpx 24rpx;border:2rpx solid #e5d3b4;border-radius:18rpx;background:#fffdf8}.nb-preset-trigger>view{display:flex;flex-direction:column;gap:6rpx}.nb-preset-trigger-title{font-size:29rpx;font-weight:700}.nb-preset-trigger-hint{font-size:21rpx;color:#927e69}.nb-preset-trigger-action{flex:none;color:#6b8152;font-size:24rpx;font-weight:700}
.nb-preset-panel{margin-top:18rpx;padding:22rpx;border:2rpx solid #e5d3b4;border-radius:18rpx;background:#fffdf8}.nb-preset-heading{display:flex;align-items:center;justify-content:space-between;font-size:29rpx;font-weight:700}.nb-preset-close{color:#927e69;font-size:22rpx;font-weight:400}.nb-preset-categories{margin-top:22rpx;white-space:nowrap}.nb-preset-category-row{display:inline-flex;gap:12rpx}.nb-preset-category{padding:10rpx 20rpx;border:2rpx solid #e5d3b4;border-radius:99rpx;color:#715d47;font-size:22rpx}.nb-preset-category.is-active{border-color:#779155;background:#eef3e6;color:#536b3d}.nb-preset-list{height:360rpx;margin-top:20rpx;border-top:2rpx solid #ead8ba;border-bottom:2rpx solid #ead8ba}.nb-preset-row{padding:18rpx 12rpx;border-bottom:2rpx solid #f0e2cc}.nb-preset-row.is-selected{background:#f2f6ea}.nb-preset-row-title{display:flex;justify-content:space-between;font-size:25rpx;font-weight:700}.nb-preset-row-title text{color:#927e69;font-size:20rpx;font-weight:400}.nb-preset-row-desc{margin-top:6rpx;color:#927e69;font-size:21rpx}.nb-preset-preview{margin-top:22rpx}.nb-preset-preview-title{margin-bottom:10rpx;font-size:24rpx;font-weight:700}.nb-preset-preview-options{padding:0 0 10rpx;color:#927e69;font-size:20rpx;line-height:1.5}.nb-preset-preview-row{display:flex;justify-content:space-between;padding:9rpx 0;color:#715d47;font-size:21rpx}.nb-preset-preview-row text:last-child{color:#927e69}.nb-preset-import{margin-top:18rpx;padding:18rpx;border-radius:12rpx;background:#779155;color:#fff;text-align:center;font-size:25rpx;font-weight:700}
.nb-field>picker{padding:0;min-height:0;border:0;border-radius:0;background:transparent}
