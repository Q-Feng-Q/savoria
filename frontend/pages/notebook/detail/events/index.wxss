.nb-page{min-height:100vh;padding:40rpx 30rpx calc(150rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff7e9;color:#51331f}.nb-header{display:flex;flex-direction:column;gap:12rpx}.nb-kicker{font-size:21rpx;color:#806746;letter-spacing:2rpx}.nb-title{font-family:"STKaiti","KaiTi",serif;font-size:58rpx;font-weight:800}.nb-caption{font-size:23rpx;color:#8a725c}.nb-toolbar{display:flex;justify-content:space-between;margin:38rpx 0 20rpx;color:#9b633d;font-size:24rpx}.nb-list{border-top:2rpx solid #ead8ba}.nb-row{padding:28rpx 0;border-bottom:2rpx solid #ead8ba}.nb-row-main{display:flex;flex-direction:column;gap:8rpx}.nb-row-title{font-size:31rpx;font-weight:700}.nb-meta{font-size:21rpx;color:#937e67}.nb-actions{display:flex;gap:28rpx;margin-top:22rpx;font-size:22rpx;color:#697f52}.nb-actions-sub{margin-top:15rpx;color:#92765d}.nb-danger{color:#b84d3a}.nb-empty{padding:100rpx 10rpx;color:#99816c;text-align:center;font-size:24rpx}.nb-bottom{position:fixed;left:30rpx;right:30rpx;bottom:calc(30rpx + env(safe-area-inset-bottom));padding:22rpx;border-radius:18rpx;background:#df7739;color:#fff;text-align:center;font-size:28rpx;font-weight:700}@media(max-width:360px){.nb-actions{gap:17rpx}.nb-page{padding-left:20rpx;padding-right:20rpx}}
