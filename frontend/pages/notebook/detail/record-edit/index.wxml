<view class="nb-page warm-page">
  <view class="nb-kicker">私人空间 · {{recordId ? '编辑记录' : '新记录'}}</view><view class="nb-title">记下这一刻</view>
  <view wx:if="{{phase === 'loading'}}" class="nb-empty">正在准备记录…</view>
  <view wx:elif="{{phase === 'error'}}" class="nb-empty" bindtap="load">{{errorMessage}} · 点击重试</view>
  <block wx:else>
    <view wx:if="{{recordId && currentVersion !== templateVersion && !upgradeMode}}" class="nb-history"><text>正在编辑历史模板 v{{templateVersion}}</text><text bindtap="beginUpgrade">升级到 v{{currentVersion}} ›</text></view>
    <view wx:if="{{upgradeMode}}" class="nb-history"><text>升级模式 · 保存后会保留旧版本快照</text><text bindtap="cancelUpgrade">取消升级 ›</text></view>
    <view class="nb-label">标题</view><input class="nb-input" value="{{title}}" maxlength="200" data-key="title" bindinput="onText" placeholder="这件事叫什么？"/>
    <view class="nb-label">开始</view><view class="nb-time"><picker mode="date" value="{{occurredDate}}" data-key="occurredDate" bindchange="onDate"><view>{{occurredDate}}</view></picker><picker mode="time" value="{{startTime}}" data-key="startTime" bindchange="onDate"><view>{{startTime}}</view></picker></view>
    <view class="nb-label">结束</view><view class="nb-time"><picker mode="date" value="{{endDate}}" data-key="endDate" bindchange="onDate"><view>{{endDate}}</view></picker><picker mode="time" value="{{endTime}}" data-key="endTime" bindchange="onDate"><view>{{endTime}}</view></picker></view>
    <view class="nb-label">备注</view><textarea class="nb-input nb-area" value="{{note}}" maxlength="20000" data-key="note" bindinput="onText" placeholder="可以补充一些细节（选填）"/>
    <view class="nb-section">记录字段 · 模板 v{{upgradeMode ? currentVersion : templateVersion}}</view>
    <view wx:for="{{fields}}" wx:key="key" class="nb-field">
      <view class="nb-label">{{item.label}}{{item.required ? ' *' : ''}}<text class="nb-type">{{item.type}}{{item.unit ? ' · ' + item.unit : ''}}</text></view>
      <input wx:if="{{item.editor === 'input' || item.editor === 'number'}}" class="nb-input" type="{{item.editor === 'number' ? 'digit' : 'text'}}" value="{{item.displayValue}}" data-key="{{item.key}}" bindinput="onField" placeholder="请输入"/>
      <textarea wx:elif="{{item.editor === 'textarea'}}" class="nb-input nb-area" value="{{item.displayValue}}" data-key="{{item.key}}" bindinput="onField" placeholder="请输入"/>
      <view wx:elif="{{item.editor === 'datetime'}}" class="nb-time"><picker mode="date" value="{{item.datetimeDate}}" data-key="{{item.key}}" data-part="date" bindchange="onFieldDatetime"><view>{{item.datetimeDate || '选择日期'}}</view></picker><picker mode="time" value="{{item.datetimeTime}}" data-key="{{item.key}}" data-part="time" bindchange="onFieldDatetime"><view>{{item.datetimeTime || '选择时间'}}</view></picker></view>
      <picker wx:elif="{{item.editor === 'date' || item.editor === 'time'}}" mode="{{item.editor}}" value="{{item.displayValue}}" data-key="{{item.key}}" bindchange="onField"><view class="nb-input">{{item.displayValue || '请选择'}}　⌄</view></picker>
      <picker wx:elif="{{item.editor === 'picker'}}" range="{{item.options}}" value="{{item.choiceIndex}}" data-key="{{item.key}}" bindchange="onField"><view class="nb-input">{{item.displayValue || '请选择'}}　⌄</view></picker>
      <checkbox-group wx:elif="{{item.editor === 'checks'}}" data-key="{{item.key}}" bindchange="onField"><label wx:for="{{item.optionsView}}" wx:for-item="option" wx:key="label" class="nb-option"><checkbox value="{{option.label}}" checked="{{option.checked}}" color="#779155"/>{{option.label}}</label></checkbox-group>
      <switch wx:elif="{{item.editor === 'switch'}}" checked="{{item.displayValue}}" color="#779155" data-key="{{item.key}}" bindchange="onField"/>
      <picker wx:elif="{{item.editor === 'rating'}}" range="{{[1,2,3,4,5]}}" value="{{item.ratingIndex}}" data-key="{{item.key}}" bindchange="onField"><view class="nb-input">{{item.displayValue || '请选择评分'}}　⌄</view></picker>
      <view wx:elif="{{item.editor === 'image'}}"><view wx:for="{{item.imageKeys}}" wx:for-item="imageKey" wx:key="*this" class="nb-image-row"><text data-value="{{imageKey}}" bindtap="previewImage">查看私有图片 ›</text><text data-key="{{item.key}}" data-value="{{imageKey}}" bindtap="removeImage">移除</text></view><view class="nb-image-add" data-key="{{item.key}}" bindtap="addImage">＋ 选择私有图片</view></view>
    </view>
  </block>
  <view wx:if="{{phase === 'ready'}}" class="nb-bottom" bindtap="save">{{busy ? '保存中…' : upgradeMode ? '升级并保存' : '保存记录'}}</view>
</view>
