.nb-page{min-height:100vh;padding:38rpx 30rpx calc(160rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff7e9;color:#51331f}.nb-kicker{font-size:21rpx;color:#806746;letter-spacing:2rpx}.nb-title{margin:12rpx 0 30rpx;font-family:"STKaiti","KaiTi",serif;font-size:56rpx;font-weight:800}.nb-history{display:flex;justify-content:space-between;padding:22rpx;margin:20rpx 0;border-left:6rpx solid #779155;background:#edf2df;color:#506741;font-size:22rpx}.nb-label{margin:28rpx 0 12rpx;font-size:25rpx;font-weight:700}.nb-type{float:right;font-size:19rpx;color:#9b8369;font-weight:400}.nb-input{box-sizing:border-box;width:100%;min-height:80rpx;padding:18rpx 20rpx;border:2rpx solid #e5d3b4;border-radius:12rpx;background:#fffdf8;font-size:25rpx}.nb-area{height:150rpx}.nb-time{display:flex;gap:18rpx}.nb-time>picker{flex:1;padding:23rpx;border:2rpx solid #e5d3b4;border-radius:12rpx;background:#fffdf8;font-size:24rpx}.nb-section{margin:42rpx 0 5rpx;padding-bottom:16rpx;border-bottom:2rpx solid #ddc6a2;font-size:30rpx;font-weight:700}.nb-field{padding:5rpx 0 26rpx;border-bottom:2rpx solid #ead8ba}.nb-option{display:block;padding:12rpx 0;font-size:24rpx}.nb-image-row{display:flex;justify-content:space-between;padding:14rpx 0;color:#697e51;font-size:22rpx}.nb-image-add{padding:19rpx;border:2rpx dashed #afc19c;border-radius:12rpx;color:#61794d;text-align:center;font-size:23rpx}.nb-empty{padding:100rpx;color:#9a8267;text-align:center}.nb-bottom{position:fixed;left:30rpx;right:30rpx;bottom:calc(30rpx + env(safe-area-inset-bottom));padding:22rpx;border-radius:18rpx;background:#df7739;color:#fff;text-align:center;font-size:28rpx;font-weight:700}@media(max-width:360px){.nb-page{padding-left:20rpx;padding-right:20rpx}.nb-time{gap:8rpx}}
.nb-field>picker{padding:0;min-height:0;border:0;border-radius:0;background:transparent}
