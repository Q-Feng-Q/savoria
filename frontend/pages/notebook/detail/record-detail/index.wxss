.nb-page{min-height:100vh;padding:42rpx 30rpx calc(100rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#fff7e9;color:#51331f}.nb-kicker{font-size:21rpx;color:#806746;letter-spacing:2rpx}.nb-title{margin:15rpx 0;font-family:"STKaiti","KaiTi",serif;font-size:56rpx;font-weight:800}.nb-dates{color:#8d765f;font-size:22rpx}.nb-dates text{padding:0 12rpx}.nb-note{margin:35rpx 0;white-space:pre-wrap;font-size:25rpx;line-height:1.7}.nb-section{margin-top:45rpx;padding-bottom:16rpx;border-bottom:2rpx solid #dcc4a0;font-size:30rpx;font-weight:700}.nb-field{display:flex;justify-content:space-between;gap:25rpx;padding:26rpx 0;border-bottom:2rpx solid #ead8ba;font-size:24rpx}.nb-label{color:#8d765f}.nb-value{flex:1;text-align:right;word-break:break-all}.nb-footnote{margin:30rpx 0;color:#a08b74;font-size:20rpx;line-height:1.6}.nb-actions{display:flex;gap:15rpx;margin:45rpx 0}.nb-actions view{flex:1;padding:22rpx;border-radius:14rpx;background:#df7739;color:#fff;text-align:center;font-size:27rpx;font-weight:700}.nb-actions .nb-danger{background:#f2ded5;color:#b84d3a}.nb-empty{padding:100rpx;color:#9a8267;text-align:center}@media(max-width:360px){.nb-page{padding-left:20rpx;padding-right:20rpx}}
.nb-image{margin-top:10rpx;padding:10rpx;color:#5f7950;font-size:22rpx}
