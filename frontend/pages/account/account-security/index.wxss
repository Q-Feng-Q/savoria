.security-page{min-height:100vh;padding:26rpx 24rpx 70rpx;background:var(--sk-bg);box-sizing:border-box}.security-group{margin-bottom:22rpx;padding:27rpx;border:2rpx solid var(--sk-line-soft);border-radius:28rpx 11rpx 28rpx 11rpx;background:var(--sk-paper);box-shadow:var(--sk-shadow-soft)}.security-group:nth-child(1){border-color:var(--sk-ink);background:var(--sk-sprout)}.security-title{display:block;margin-bottom:18rpx;color:var(--sk-text);font-family:"STSong","Songti SC",serif;font-size:31rpx;font-weight:900}.security-row{display:flex;align-items:center;justify-content:space-between;min-height:82rpx;padding:13rpx 0;border-bottom:2rpx solid var(--sk-line-soft);color:var(--sk-text);font-size:25rpx;font-weight:900}.security-note{display:block;margin-top:5rpx;color:var(--sk-muted);font-size:19rpx;font-weight:500}.security-block>text:first-child{display:block;color:var(--sk-text);font-size:25rpx;font-weight:900}.security-group input{width:100%;min-height:82rpx;margin:12rpx 0;border:2rpx solid var(--sk-line);background:var(--sk-paper);box-sizing:border-box}.code-line{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:11rpx;align-items:center}.code-line .ui-button,.security-row .ui-button{min-height:68rpx;margin:0;padding:0 18rpx;border:2rpx solid var(--sk-ink);border-radius:18rpx 7rpx 18rpx 7rpx;background:var(--sk-wheat);color:var(--sk-ink);font-size:20rpx;font-weight:900}.code-line .ui-button::after,.security-row .ui-button::after{border:0}

