@import "../../../styles/approved-storybook.wxss";

.profile-page { min-height:100vh; padding:0 24rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing:border-box; background:#fff3d7; overflow-x:hidden; }
.design-profile-banner { position:relative; min-height:390rpx; margin:0 -24rpx; overflow:hidden; background:#fff0ce; }
.profile-story-art { height:248rpx; }
.warm-profile-portrait__welcome { position:relative; width:49%; padding:38rpx 0 0 28rpx; }
.warm-profile-portrait__welcome-kicker { display:block; color:#482713; font-family:"STKaiti","KaiTi",serif; font-size:56rpx; font-weight:900; }
.warm-profile-portrait__welcome-title { display:block; margin-top:12rpx; color:#795034; font-size:23rpx; line-height:1.6; }
.profile-banner__identity { position:relative; display:grid; grid-template-columns:82rpx minmax(0,1fr) auto; align-items:center; gap:16rpx; margin:106rpx 24rpx 22rpx; padding:22rpx; border:2rpx solid #ead4a7; border-radius:26rpx; background:linear-gradient(110deg,#fff5df,#f8e7bd); box-shadow:0 8rpx 18rpx rgba(135,92,33,.08); }
.profile-avatar { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; border:3rpx solid #8a9b64; border-radius:50%; background:#dce4bb; color:#516936; font-family:"KaiTi",serif; font-size:36rpx; font-weight:800; }
.profile-hero__copy { min-width:0; }
.profile-kicker,.profile-name,.profile-account { display:block; }
.profile-kicker { color:#876541; font-size:18rpx; }
.profile-name { margin:5rpx 0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#51331f; font-size:32rpx; font-weight:800; }
.profile-account { overflow:hidden; color:#806746; font-size:18rpx; text-overflow:ellipsis; white-space:nowrap; }
.profile-switch-link { display:flex; align-items:center; justify-content:center; min-height:64rpx; padding:0 16rpx; border-radius:20rpx; background:#647b3e; color:#fff6df; font-size:20rpx; font-weight:700; white-space:nowrap; }
.profile-switch-link--pressed,.profile-row--pressed { opacity:.75; }
.profile-family-summary { display:grid; grid-template-columns:64rpx minmax(0,1fr) auto; align-items:center; gap:18rpx; margin-top:24rpx; padding:24rpx; border:2rpx solid #b9c58c; border-radius:26rpx; background:#dce4bb; }
.profile-family-summary__icon { display:flex; align-items:center; justify-content:center; width:60rpx; height:60rpx; border-radius:18rpx; background:#f7edcb; }
.profile-family-summary__name,.profile-family-summary__meta { display:block; }
.profile-family-summary__name { color:#4d6133; font-size:29rpx; font-weight:800; overflow-wrap:break-word; }
.profile-family-summary__meta { margin-top:7rpx; color:#68734b; font-size:21rpx; }
.profile-family-summary__arrow { color:#61763e; font-size:38rpx; }
.family-guide { margin-top:24rpx; padding:28rpx; border-radius:28rpx; background:#dce4bb; border:2rpx solid #b9c58c; }
.family-guide__eyebrow,.family-guide__title,.family-guide__note { display:block; }
.family-guide__eyebrow { color:#647b3e; font-size:21rpx; }
.family-guide__title { margin-top:10rpx; color:#51331f; font-size:31rpx; font-weight:800; }
.family-guide__note { margin:12rpx 0 24rpx; color:#806746; font-size:23rpx; line-height:1.7; }
.profile-settings-group { margin-top:26rpx; overflow:hidden; border:2rpx solid #efddb7; border-radius:28rpx; background:linear-gradient(110deg,#fff5df,#fff0d1); box-shadow:0 8rpx 20rpx rgba(151,108,41,.08); }
.profile-section__title { display:block; padding:26rpx 26rpx 12rpx; color:#795034; font-size:26rpx; font-weight:800; }
.profile-row { display:flex; align-items:center; justify-content:space-between; gap:16rpx; width:100%; min-height:104rpx; padding:18rpx 26rpx; box-sizing:border-box; border-bottom:2rpx solid #eddfbc; color:#51331f; font-size:25rpx; }
.profile-row:last-child { border-bottom:0; }
.profile-row__lead { display:flex; align-items:center; gap:14rpx; flex-shrink:0; }
.profile-row__icon { display:flex; align-items:center; justify-content:center; width:38rpx; height:38rpx; border-radius:12rpx; background:#e2e7c5; color:#647b3e; font-size:21rpx; }
.profile-row__tail { display:flex; justify-content:flex-end; min-width:0; }
.profile-row__edit { display:none; }
.profile-row__value { min-width:0; overflow:hidden; color:#896b49; font-size:21rpx; text-overflow:ellipsis; white-space:nowrap; }
.profile-section--plain { box-shadow:none; border:0; background:transparent; }
.profile-row--danger { justify-content:center; color:#a54b32; font-size:24rpx; }
@media(max-width:360px) { .profile-banner__identity { grid-template-columns:72rpx minmax(0,1fr); padding:18rpx; gap:12rpx; } .profile-switch-link { grid-column:2; justify-self:start; min-height:58rpx; } .profile-avatar { width:66rpx; height:66rpx; } .profile-row { padding:18rpx; } }
