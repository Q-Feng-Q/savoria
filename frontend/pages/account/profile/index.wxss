.profile-page{min-height:100vh;padding:0 22rpx calc(150rpx + env(safe-area-inset-bottom));overflow-x:hidden;background:#fff6e8;box-sizing:border-box}.design-profile-banner{position:relative;min-height:500rpx;margin:0 -22rpx 0;overflow:hidden;background:#f2d49e}.profile-banner__art{position:absolute;top:0;left:0;width:100%;height:330rpx}.profile-banner__veil{position:absolute;inset:0;background:linear-gradient(180deg,rgba(255,246,232,0) 0,rgba(255,246,232,.08) 44%,#f2d49e 67%)}.profile-banner__identity{position:absolute;z-index:2;left:28rpx;right:28rpx;bottom:28rpx;display:grid;grid-template-columns:94rpx minmax(0,1fr) auto;align-items:center;gap:17rpx}.profile-avatar{display:grid;place-items:center;width:90rpx;height:90rpx;border:4rpx solid #75947b;border-radius:50%;background:#dce9dc;color:#3e5b46;font-family:"STKaiti","KaiTi",serif;font-size:38rpx;font-weight:900}.profile-hero__copy{min-width:0}.profile-kicker,.profile-name,.profile-account{display:block}.profile-kicker{color:#87624e;font-size:16rpx;font-weight:900}.profile-name{margin-top:5rpx;color:#3d2921;font-family:"STKaiti","KaiTi","Songti SC",serif;font-size:36rpx;font-weight:900}.profile-account{margin-top:5rpx;overflow:hidden;color:#806655;font-size:19rpx;text-overflow:ellipsis;white-space:nowrap}.profile-switch-link{display:inline-flex;align-items:center;justify-content:center;justify-self:end;width:auto;min-height:64rpx;margin:0;padding:0 18rpx;border-radius:999rpx;background:#51372d;color:#fff;font-size:19rpx;font-weight:900;white-space:nowrap}.profile-switch-link--pressed{opacity:.86;transform:translateY(2rpx) scale(.985)}
.profile-family-summary{display:grid;grid-template-columns:68rpx minmax(0,1fr) auto;align-items:center;gap:14rpx;margin-top:22rpx;padding:22rpx 24rpx;border-radius:32rpx;background:#dce9dc}.profile-family-summary__icon{display:grid;place-items:center;width:62rpx;height:62rpx;border-radius:20rpx;background:#fff9ed;font-size:30rpx}.profile-family-summary__name,.profile-family-summary__meta{display:block}.profile-family-summary__name{color:#4f6f57;font-size:26rpx;font-weight:900}.profile-family-summary__meta{margin-top:4rpx;color:#7a8d7d;font-size:18rpx}.profile-family-summary__arrow{color:#64806a;font-size:36rpx}
.family-guide{margin-top:22rpx;padding:26rpx;border-radius:32rpx;background:#dce9dc}.family-guide__eyebrow,.family-guide__title,.family-guide__note{display:block}.family-guide__eyebrow{color:#57725e;font-size:17rpx;font-weight:900}.family-guide__title{margin-top:8rpx;color:#3e2d25;font-size:29rpx;font-weight:900}.family-guide__note{margin:8rpx 0 20rpx;color:#7f6a5c;font-size:20rpx;line-height:1.5}
.profile-settings-group{margin-top:28rpx;overflow:hidden;border:2rpx solid #e4d3bd;border-radius:32rpx;background:#fffdf8}.profile-section__title{display:block;padding:22rpx 24rpx 10rpx;color:#80604d;font-size:18rpx;font-weight:900;letter-spacing:2rpx}.profile-row{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:96rpx;margin:0;padding:0 24rpx;border:0;border-bottom:2rpx solid #ecdfcf;border-radius:0;background:transparent;box-sizing:border-box;color:#402e26;font-size:24rpx;text-align:left}.profile-row:last-child{border-bottom:0}.profile-row::after{border:0}.profile-row--pressed{background:#fff4df;opacity:.82}.profile-row__lead{display:flex;align-items:center;gap:15rpx}.profile-row__icon{display:grid;place-items:center;width:32rpx;color:#735440;font-size:20rpx}.profile-row__value{max-width:48%;overflow:hidden;color:#9a806f;font-size:18rpx;text-overflow:ellipsis;white-space:nowrap}.profile-row--danger{justify-content:center;color:#bd5749}.profile-section--plain{border-color:transparent;background:transparent}
@media(max-width:360px){.design-profile-banner{min-height:450rpx}.profile-banner__art{height:292rpx}.profile-banner__identity{left:18rpx;right:18rpx;grid-template-columns:76rpx minmax(0,1fr) auto;gap:11rpx}.profile-avatar{width:74rpx;height:74rpx;font-size:32rpx}.profile-name{font-size:31rpx}.profile-switch-link{padding:0 13rpx;font-size:17rpx}.profile-family-summary{padding:18rpx}.profile-row{padding:0 18rpx}}

.profile-row__tail{display:flex;align-items:center;justify-content:flex-end;gap:10rpx;min-width:0}.profile-row__edit{color:#705241;font-size:17rpx}.profile-row__tail .profile-row__value{max-width:220rpx}

/* Keep the character portrait visible in both family-bound and onboarding
   states, with explicit native-image and content layers. */
.warm-profile-portrait{position:relative;min-height:440rpx;padding:0;isolation:isolate;overflow:hidden;background:#f3d7a5}
.warm-profile-portrait__art{position:absolute;z-index:1;top:0;right:0;bottom:auto;left:auto;width:68%;height:310rpx}
.warm-profile-portrait__veil{position:absolute;z-index:2;top:0;right:0;bottom:0;left:0;background:linear-gradient(90deg,#f7dda9 0,rgba(247,221,169,.82) 34%,rgba(247,221,169,.1) 76%),linear-gradient(180deg,rgba(243,215,165,0) 46%,#f3d7a5 72%)}
.warm-profile-portrait__welcome{position:relative;z-index:3;width:44%;padding:46rpx 0 0 34rpx}.warm-profile-portrait__welcome-kicker,.warm-profile-portrait__welcome-title{display:block}.warm-profile-portrait__welcome-kicker{color:#855440;font-size:17rpx;font-weight:900;letter-spacing:2rpx}.warm-profile-portrait__welcome-title{margin-top:12rpx;color:#3f2b23;font-family:"STKaiti","KaiTi","Songti SC",serif;font-size:34rpx;line-height:1.2;font-weight:900}
.warm-profile-portrait__identity{z-index:3}

@media(max-width:360px){.warm-profile-portrait{min-height:470rpx}.warm-profile-portrait__art{width:76%;height:290rpx}.warm-profile-portrait__welcome{width:50%;padding:34rpx 0 0 24rpx}.warm-profile-portrait__welcome-title{font-size:29rpx}.warm-profile-portrait__identity{grid-template-columns:76rpx minmax(0,1fr);gap:11rpx}.warm-profile-portrait__identity .profile-switch-link{grid-column:2;justify-self:start;min-height:54rpx}}
