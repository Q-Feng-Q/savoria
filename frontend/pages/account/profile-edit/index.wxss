.account-form-page{min-height:100vh;padding:36rpx 28rpx 70rpx;background:var(--sk-bg);box-sizing:border-box}.account-form-avatar{display:grid;place-items:center;width:132rpx;height:132rpx;margin:0 auto 34rpx;border:3rpx solid var(--sk-ink);border-radius:44% 56% 46% 54%;background:var(--sk-wheat);color:var(--sk-ink);font-size:49rpx;font-weight:900;box-shadow:var(--sk-shadow-soft);transform:rotate(-2deg)}.account-field{display:block;margin-bottom:23rpx}.account-field text{display:block;margin-bottom:9rpx;color:var(--sk-ink);font-size:22rpx;font-weight:900}.account-field input{width:100%;min-height:86rpx;border:2rpx solid var(--sk-line);background:var(--sk-paper);box-sizing:border-box}

