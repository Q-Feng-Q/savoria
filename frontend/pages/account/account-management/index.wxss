.accounts-page{min-height:100vh;padding:26rpx 24rpx 70rpx;background:var(--sk-bg);box-sizing:border-box}.accounts-head{position:relative;padding:30rpx;border:2rpx solid var(--sk-ink);border-radius:32rpx 13rpx 32rpx 13rpx;background:var(--sk-wheat)}.accounts-head::after{content:'☺';position:absolute;right:28rpx;top:20rpx;color:var(--sk-ink);font-size:68rpx}.accounts-title,.accounts-note{display:block}.accounts-title{color:var(--sk-text);font-family:"STSong","Songti SC",serif;font-size:42rpx;font-weight:900}.accounts-note{width:70%;margin-top:9rpx;color:var(--sk-muted);font-size:21rpx}.accounts-list{margin:24rpx 0}.account-item{margin-bottom:17rpx;padding:24rpx;border:2rpx solid var(--sk-line-soft);border-radius:27rpx 11rpx 27rpx 11rpx;background:var(--sk-paper);box-shadow:var(--sk-shadow-soft)}.account-item.is-current{border-color:var(--sk-ink);background:var(--sk-sprout)}.account-summary{display:grid;grid-template-columns:76rpx minmax(0,1fr) auto;gap:15rpx;align-items:center}.account-avatar{display:grid;place-items:center;width:74rpx;height:74rpx;border:2rpx solid var(--sk-ink);border-radius:43% 57% 45% 55%;background:var(--sk-wheat);color:var(--sk-ink);font-size:29rpx;font-weight:900}.account-copy{min-width:0}.account-name-line{display:flex;align-items:center;gap:9rpx}.account-name,.account-meta,.account-role{display:block}.account-name{color:var(--sk-text);font-size:27rpx;font-weight:900}.current-badge{padding:4rpx 8rpx;border-radius:999rpx;background:var(--sk-ink);color:#fff;font-size:16rpx}.account-meta,.account-role{margin-top:5rpx;color:var(--sk-muted);font-size:19rpx}.account-remove{width:88rpx;min-height:88rpx;margin:0;padding:10rpx;border:0;background:transparent;color:var(--sk-danger);font-size:19rpx}.account-remove::after{border:0}.identity-actions{display:grid;width:100%;grid-template-columns:1fr 1fr;gap:11rpx;margin-top:18rpx}.identity-action,.account-reauth{width:100%;min-height:88rpx;margin:0;padding:0 12rpx;border:2rpx solid var(--sk-line);border-radius:18rpx 7rpx 18rpx 7rpx;background:var(--sk-paper);color:var(--sk-ink);font-size:20rpx;font-weight:900}.identity-action::after,.account-reauth::after{border:0}.identity-action--merchant{background:var(--sk-wheat)}.identity-action.is-active{border-color:var(--sk-ink);background:var(--sk-ink);color:#fff}.account-reauth{width:100%;margin-top:18rpx;color:var(--sk-danger)}.switching-note,.accounts-safe{display:block;margin-top:10rpx;color:var(--sk-muted);font-size:19rpx;text-align:center}.accounts-safe{margin-top:16rpx}


